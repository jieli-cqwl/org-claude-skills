{
  "protocol_version": 1,
  "reference": "shared/reference/impact-analysis.md",
  "goal": "Validate whether the impact-analysis reference drives business, QA, and engineering aligned functional impact items instead of file lists or search summaries.",
  "run_model": {
    "freeze_first": [
      "reference_version",
      "case_inputs",
      "output_schema",
      "rubric",
      "pass_threshold"
    ],
    "parallel_safe": [
      "case_execution",
      "independent_grading"
    ],
    "serial_required": [
      "protocol_freeze",
      "final_synthesis",
      "reference_change_decision"
    ]
  },
  "atom_record_schema": [
    "source_atom_id",
    "atom_type",
    "denominator_status",
    "denominator_reason",
    "evidence_anchor",
    "current_behavior",
    "target_behavior",
    "target_action",
    "trace_status",
    "business_entry",
    "business_impact",
    "preserved_old_logic",
    "acceptance_assertion",
    "runtime_status",
    "risk_or_decision"
  ],
  "denominator_statuses": [
    "ADMITTED",
    "REJECTED_WITH_EVIDENCE"
  ],
  "decision_states": [
    "CHANGE",
    "KEEP_AS_IS",
    "REGRESSION_ONLY",
    "NEEDS_TRACE",
    "NEEDS_DECISION",
    "NOT_IMPACTED_WITH_EVIDENCE"
  ],
  "trace_statuses": [
    "TRACE_COMPLETE",
    "TRACE_PARTIAL",
    "TRACE_BLOCKED",
    "NEEDS_TRACE"
  ],
  "runtime_statuses": [
    "STATIC_VERIFIED",
    "RUNTIME_VERIFIED",
    "RUNTIME_UNVERIFIED",
    "ACCOUNT_BLOCKED",
    "ENV_BLOCKED"
  ],
  "trace_chain": [
    "source_atom",
    "call_chain",
    "interface_task_or_page",
    "terminal_or_business_entry",
    "user_path",
    "business_impact",
    "acceptance_assertion"
  ],
  "output_schema": [
    "case_id",
    "source_atom_denominator",
    "atom_evidence_anchors",
    "bottom_up_trace",
    "functional_impact_items",
    "preserved_old_logic",
    "regression_verification",
    "coverage_gaps",
    "decision_risks",
    "runtime_review_status",
    "completion_gate"
  ],
  "rubric": [
    {
      "id": "R1",
      "label": "source_atom_denominator",
      "requires": [
        "源码原子证据",
        "覆盖分母",
        "证据锚点"
      ]
    },
    {
      "id": "R2",
      "label": "bottom_up_trace",
      "requires": [
        "原子点 -> 调用链 -> 接口/任务/页面 -> 终端/业务入口 -> 用户路径 -> 业务影响 -> 验收断言",
        "每一跳",
        "调用链不合并"
      ]
    },
    {
      "id": "R3",
      "label": "atom_state_closure",
      "requires": [
        "需修改",
        "保持现状",
        "待追踪",
        "NEEDS_TRACE"
      ]
    },
    {
      "id": "R4",
      "label": "technical_evidence_not_substitute",
      "requires": [
        "不得用文件清单替代功能影响结论",
        "文件名、函数名、脚本名不是功能影响项"
      ]
    },
    {
      "id": "R5",
      "label": "old_logic_regression",
      "requires": [
        "旧逻辑",
        "保持现有行为",
        "回归对象"
      ]
    },
    {
      "id": "R6",
      "label": "runtime_review",
      "requires": [
        "真实系统入口",
        "运行未验",
        "静态复核"
      ]
    },
    {
      "id": "R7",
      "label": "negative_evidence",
      "requires": [
        "无额外影响时说明检查过功能影响、技术触点、业务规则、验证范围和覆盖盲区"
      ]
    },
    {
      "id": "R8",
      "label": "completion_gate",
      "requires": [
        "需回归验证项",
        "覆盖盲区",
        "待裁决风险",
        "完成前验证"
      ]
    }
  ],
  "pass_threshold": {
    "case_required": "每个 case 必须满足 R1、R3、R4、R8；适用场景必须满足对应专项 rubric。",
    "suite_required": "8 个 case 全部不得出现 P0；P1 不超过 1 个且必须能归因到 reference 可修复问题。"
  },
  "pilot_rollout": {
    "status": "team_pilot_ready",
    "sample_size": "3-5 real tasks before hard-gate adoption",
    "required_record_fields": [
      "task_ref",
      "change_summary",
      "source_atom_denominator",
      "atom_evidence_anchors",
      "functional_impact_items",
      "preserved_old_logic",
      "regression_verification",
      "coverage_gaps",
      "decision_risks",
      "runtime_review_status",
      "completion_gate_result",
      "review_findings"
    ],
    "upgrade_gate": {
      "allowed_after": "real_task_sample_review",
      "max_p0": 0,
      "max_unresolved_p1": 0,
      "required_decision": "human_owner_accepts_hard_gate"
    },
    "failure_handling": [
      "P0 blocks hard-gate adoption and must be traced to reference, process, or executor gap.",
      "P1 requires owner action before expanding rollout.",
      "Coverage gaps and decision risks must stay visible in completion verification."
    ]
  },
  "cases": [
    {
      "id": "IA-001",
      "name": "业务功能变更",
      "change_prompt": "登录成功后首页默认展示用户最近访问的项目，并保留原有项目列表分页能力。",
      "expected_focus": [
        "源码原子分母",
        "用户可见行为",
        "默认排序/分页业务规则",
        "登录到首页用户路径",
        "回归验证"
      ]
    },
    {
      "id": "IA-002",
      "name": "shared helper 重构",
      "change_prompt": "把日期格式化 helper 从本地模块迁到 shared/utils，并保持输出格式不变。",
      "expected_focus": [
        "内部实现影响",
        "保持现状",
        "旧逻辑回归对象",
        "行为不变证据"
      ]
    },
    {
      "id": "IA-003",
      "name": "规则/reference/runtime 文档变更",
      "change_prompt": "修改完成前验证规则，要求真实依赖验收无法执行时必须标为阻塞或待裁决。",
      "expected_focus": [
        "runtime 行为约束",
        "相关 reference 同步",
        "完成声明风险",
        "测试/安装消费路径"
      ]
    },
    {
      "id": "IA-004",
      "name": "无额外影响判定",
      "change_prompt": "修正文档中的错别字，不改变标题、字段名、命令、状态或规则语义。",
      "expected_focus": [
        "无额外影响依据",
        "源码原子检查面",
        "业务规则不变",
        "覆盖盲区检查"
      ]
    },
    {
      "id": "IA-005",
      "name": "覆盖盲区暴露",
      "change_prompt": "修改一个被页面查询、导出和定时同步共同调用的 mapper 查询条件；其中一个调用通过字符串拼接的动态 handler 到达，代码智能只能找到定义，找不到全部运行时调用。",
      "expected_focus": [
        "代码智能不可见路径",
        "动态调用",
        "调用链不合并",
        "待追踪",
        "运行验证需求",
        "待裁决风险"
      ]
    },
    {
      "id": "IA-006",
      "name": "contract/schema 字段变更",
      "change_prompt": "把任务合同中的技术影响字段调整为源码原子证据锚点，并新增 functional_impact_items 字段。",
      "expected_focus": [
        "上下游 contract 消费",
        "schema/script/test 同步",
        "原子证据锚点",
        "兼容风险"
      ]
    },
    {
      "id": "IA-007",
      "name": "测试脚本/CI 变更",
      "change_prompt": "把 quick gate 中的 runtime contract 测试移动到 full gate，只保留 smoke canary。",
      "expected_focus": [
        "门禁覆盖变化",
        "发布风险",
        "回归验证项",
        "测试可信度"
      ]
    },
    {
      "id": "IA-008",
      "name": "并行任务边界",
      "change_prompt": "两个任务修改不同文件，但都影响同一个用户下单路径和同一份订单状态契约。",
      "expected_focus": [
        "文件无交集不等于独立",
        "同一用户路径",
        "共享契约",
        "统一合并验证"
      ]
    }
  ]
}
