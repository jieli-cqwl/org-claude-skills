digraph AuthorityAndTeamTopology {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    ordering=out,
    splines=ortho,
    outputorder=edgesfirst,
    bgcolor="#F7F9FC",
    pad="0.30",
    nodesep="0.30",
    ranksep="0.56",
    labelloc=t,
    labeljust=l,
    label="AUTHORITY AND TEAM TOPOLOGY\nTARGET OPERATING ARCHITECTURE · V1.2 · VIEW R4\nM0 MANUAL CONTROL · Human-governed · Agent-executed · Evidence-driven\nTARGET DESIGN · NOT RUNTIME-ACTIVE",
    fontname="PingFang SC",
    fontsize=24,
    fontcolor="#152238"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#B8C2D1",
    fillcolor="#FFFFFF",
    fontname="PingFang SC",
    fontcolor="#152238",
    fontsize=11,
    margin="0.13,0.09",
    penwidth=1.2
  ];

  edge [
    fontname="PingFang SC",
    fontsize=9,
    fontcolor="#40536D",
    color="#66768D",
    arrowsize=0.72,
    penwidth=1.25
  ];

  subgraph cluster_human_plane {
    label="HUMAN CONTROL PLANE · DECIDES & RETAINS AUTHORITY";
    labelloc=t;
    labeljust=l;
    color="#A16207";
    fillcolor="#FFF4D6";
    fontname="PingFang SC";
    fontcolor="#A16207";
    fontsize=16;
    penwidth=1.8;
    style="rounded,filled";
    margin=18;

    node [
      color="#A16207",
      fillcolor="#FFF4D6",
      fontcolor="#A16207"
    ];

    human_direction [
      label="[H]\nDIRECTION / VALUE\nco-create the problem and value",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_accept [
      label="[H]\nEXACT ACCEPTANCE\naccept named artifact + evidence",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_invoke [
      label="[H]\nNEXT-OWNER INVOCATION\nACCEPT ≠ INVOKE ≠ ACTUAL START",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_environment [
      label="[H]\nENVIRONMENT ACTION\nexecute test / production deployment",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_risk_incident [
      label="[H]\nRISK ACCEPTANCE · STOP · ROLLBACK · CONTAINMENT\nINCIDENT AUTHORITY",
      shape=note,
      style=filled,
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      fontsize=9.5,
      penwidth=2.0
    ];

    human_disposition [
      label="[H]\nFINAL DISPOSITION\nbusiness acceptance · Phase / Demand outcome",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_current_authority [
      label="[CONTROL LAW]\nrevalidate current authority at every Owner start\nconfirmation never converts unknown / conflict / failure into fact or PASS",
      shape=note,
      style=filled,
      color="#A16207",
      fillcolor="#FFFFFF",
      fontname="PingFang SC",
      fontsize=9,
      penwidth=1.4
    ];

    {
      rank=same;
      human_direction;
      human_accept;
      human_invoke;
    }

    {
      rank=same;
      human_environment;
      human_risk_incident;
      human_disposition;
    }

    human_direction -> human_accept -> human_invoke [
      // layout only
      style=invis,
      weight=24
    ];

    human_environment -> human_risk_incident -> human_disposition [
      // layout only
      style=invis,
      weight=24
    ];

    human_direction -> human_environment [
      // layout only
      style=invis,
      weight=24
    ];

    human_accept -> human_risk_incident [
      // layout only
      style=invis,
      weight=24
    ];

    human_invoke -> human_disposition [
      // layout only
      style=invis,
      weight=24
    ];

    human_risk_incident -> human_current_authority [
      // layout only
      style=invis,
      weight=24
    ];
  }

  subgraph cluster_owner_plane {
    label="ACCOUNTABLE OWNER PLANE · OWNS JUDGMENT, PACKAGE & HANDOFF PROPOSAL · DOMAINS ARE NOT A SERIAL FLOW";
    labelloc=t;
    labeljust=l;
    color="#24466F";
    fillcolor="#F8FBFF";
    fontname="PingFang SC";
    fontcolor="#24466F";
    fontsize=16;
    penwidth=1.8;
    style="rounded,filled";
    margin=18;

    subgraph cluster_product_definition {
      label="PRODUCT DEFINITION SUBSYSTEM";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=13;
      penwidth=1.5;
      style="rounded,filled";
      margin=13;

      node [
        color="#2459A9",
        fillcolor="#EAF2FF",
        fontcolor="#2459A9"
      ];

      product_director [
        label="[AO] Product Director\nWHY · value · Active Phase\ncloseout recommendation, never final outcome",
        fontname="PingFang SC",
        fontsize=9
      ];

      product_manager [
        label="[AO] Product Manager\nWHAT · objects · states · rules\npermissions · AC",
        fontname="PingFang SC",
        fontsize=9
      ];

      impact_owner [
        label="[AO] Impact Owner\nONE OWNER / ONE PACKAGE LINEAGE\nimpact discovery → impact freeze",
        fontname="PingFang SC",
        fontsize=9
      ];

      ux_owner [
        label="[AO][OPTIONAL]\nUX Owner\nindependently conditional",
        style="rounded,dashed,filled",
        color="#66768D",
        fillcolor="#EAF2FF",
        fontcolor="#66768D",
        fontsize=8.5
      ];

      architecture_owner [
        label="[AO][OPTIONAL]\nArchitecture Owner\nindependently conditional",
        style="rounded,dashed,filled",
        color="#66768D",
        fillcolor="#EAF2FF",
        fontcolor="#66768D",
        fontsize=8.5
      ];

      product_director -> product_manager -> impact_owner [
        // layout only
        style=invis,
        weight=20
      ];

      impact_owner -> ux_owner [
        // layout only
        style=invis,
        weight=16
      ];

      impact_owner -> architecture_owner [
        // layout only
        style=invis,
        weight=16
      ];

      {
        rank=same;
        ux_owner;
        architecture_owner;
      }
    }

    subgraph cluster_proof_plan {
      label="PROOF & PLAN SUBSYSTEM";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=13;
      penwidth=1.5;
      style="rounded,filled";
      margin=13;

      node [
        color="#2459A9",
        fillcolor="#EAF2FF",
        fontcolor="#2459A9"
      ];

      test_design_owner [
        label="[AO] Test Design Owner\nacceptance surface · regression obligations\nfailure paths · QA contract",
        fontname="PingFang SC",
        fontsize=9
      ];

      tech_lead [
        label="[AO] Tech Lead\nimplementation path · dependencies\nbatches · bounded Task Packets",
        fontname="PingFang SC",
        fontsize=9
      ];

      test_design_owner -> tech_lead [
        // layout only
        style=invis,
        weight=20
      ];
    }

    subgraph cluster_outcome_activities {
      label="OUTCOME ACTIVITIES";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=13;
      penwidth=1.5;
      style="rounded,filled";
      margin=13;

      node [
        color="#2459A9",
        fillcolor="#EAF2FF",
        fontcolor="#2459A9"
      ];

      outcome_recommendation [
        label="[AO] Product Director\ncloseout recommendation\nsupports, never owns, final disposition",
        fontname="PingFang SC",
        fontsize=9
      ];

      outcome_evidence [
        label="[ART][ACCOUNTABILITY]\nstate evidence honestly\nno final outcome authority",
        shape=note,
        style=filled,
        color="#0F766E",
        fillcolor="#E7F7F3",
        fontname="PingFang SC",
        fontcolor="#0F766E",
        fontsize=8.5,
        penwidth=1.3
      ];

      outcome_recommendation -> outcome_evidence [
        // layout only
        style=invis,
        weight=20
      ];
    }

    {
      rank=same;
      product_director;
      test_design_owner;
      outcome_recommendation;
    }

    product_director -> test_design_owner -> outcome_recommendation [
      // layout only
      style=invis,
      weight=24
    ];

    subgraph cluster_development_domain {
      label="DEVELOPMENT DOMAIN";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=13;
      penwidth=1.5;
      style="rounded,filled";
      margin=13;

      node [
        color="#2459A9",
        fillcolor="#EAF2FF",
        fontcolor="#2459A9"
      ];

      development_owner [
        label="[AO] Development Owner\nUNIQUE CODE-CHANGE DOMAIN\nverified immutable Candidate + Manifest",
        group="development",
        fontname="PingFang SC",
        fontsize=9,
        penwidth=1.5
      ];
    }

    subgraph cluster_independent_quality {
      label="INDEPENDENT QUALITY DOMAIN";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=13;
      penwidth=1.5;
      style="rounded,filled";
      margin=13;

      node [
        color="#2459A9",
        fillcolor="#EAF2FF",
        fontcolor="#2459A9"
      ];

      quality_owner [
        label="[AO] Quality Owner\nNO CODE CHANGE\nindependent QA · release recommendation\nproduction / incident verification",
        group="quality",
        fontname="PingFang SC",
        fontsize=9,
        penwidth=1.5
      ];
    }

    impact_owner -> development_owner [
      // layout only
      style=invis,
      weight=36
    ];

    tech_lead -> development_owner [
      // layout only
      style=invis,
      weight=36
    ];

    outcome_evidence -> quality_owner [
      // layout only
      style=invis,
      weight=36
    ];

    subgraph cluster_authority_firewall {
      label="AUTHORITY FIREWALL · MUST NOT BE CROSSED";
      labelloc=t;
      labeljust=l;
      color="#B42318";
      fillcolor="#FDECEC";
      fontname="PingFang SC";
      fontcolor="#B42318";
      fontsize=13;
    penwidth=1.7;
    style="rounded,filled";
    margin=13;

      node [
        color="#B42318",
        fillcolor="#FDECEC",
        fontcolor="#B42318"
      ];

      development_boundary [
        label="[PROHIBITED]\nDevelopment Owner ≠ independent QA / deployment authority",
        shape=note,
        style=filled,
        color="#B42318",
        fillcolor="#FDECEC",
        fontname="PingFang SC",
        fontcolor="#B42318",
        fontsize=9,
        penwidth=1.4
      ];

      quality_boundary [
        label="[PROHIBITED]\nQuality Owner = NO CODE CHANGE",
        shape=note,
        style=filled,
        color="#B42318",
        fillcolor="#FDECEC",
        fontname="PingFang SC",
        fontcolor="#B42318",
        fontsize=9,
        penwidth=1.4
      ];

      authority_boundary [
        label="[SEPARATE AUTHORITY]\nPRODUCT authority ≠ INCIDENT_REMEDIATION authority\nacceptance / evidence never substitutes across cases",
        shape=note,
        style=filled,
        color="#B42318",
        fillcolor="#FDECEC",
        fontname="PingFang SC",
        fontcolor="#B42318",
        fontsize=9,
        penwidth=1.4
      ];

      disposition_boundary [
        label="[PROHIBITED]\nOwner accountability ≠ Human disposition authority\nOwner proposes; Human accepts / invokes / acts / disposes",
        shape=note,
        style=filled,
        color="#B42318",
        fillcolor="#FDECEC",
        fontname="PingFang SC",
        fontcolor="#B42318",
        fontsize=9,
        penwidth=1.4
      ];

      {
        rank=same;
        development_boundary;
        quality_boundary;
      }

      {
        rank=same;
        authority_boundary;
        disposition_boundary;
      }

      development_boundary -> quality_boundary [
        // layout only
        style=invis,
        weight=20
      ];

      authority_boundary -> disposition_boundary [
        // layout only
        style=invis,
        weight=20
      ];

      development_boundary -> authority_boundary [
        // layout only
        style=invis,
        weight=24
      ];

      quality_boundary -> disposition_boundary [
        // layout only
        style=invis,
        weight=24
      ];
    }

    {
      rank=same;
      outcome_recommendation;
      development_boundary;
    }

    outcome_recommendation -> development_boundary [
      // layout only
      style=invis,
      weight=24
    ];

    {
      rank=same;
      development_owner;
      quality_owner;
    }

    development_owner -> quality_owner [
      // layout only
      style=invis,
      weight=24
    ];

  }

  subgraph cluster_execution_plane {
    label="BOUNDED EXECUTION PLANE\nEXECUTES ONLY INSIDE THE\nPARENT OWNER DOMAIN";
    labelloc=t;
    labeljust=r;
    color="#24466F";
    fillcolor="#F8FBFF";
    fontname="PingFang SC";
    fontcolor="#24466F";
    fontsize=16;
    penwidth=1.8;
    style="rounded,filled";
    margin=18;

    subgraph cluster_development_execution {
      label="DEVELOPMENT\nEXECUTION AGENTS\nDEVELOPMENT OWNER ONLY";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=13;
      penwidth=1.5;
      style="rounded,filled";
      margin=13;

      node [
        color="#66768D",
        fillcolor="#F3F5F8",
        fontcolor="#66768D"
      ];

      developer [
        label="[AE] Developer\nimplementation · self-test",
        group="development",
        fillcolor="#F3F5F8",
        fontname="PingFang SC",
        fontsize=9
      ];

      code_fixer [
        label="[AE] Code Fixer\nroot-cause repair",
        fillcolor="#F3F5F8",
        fontname="PingFang SC",
        fontsize=9
      ];

      verifier [
        label="[AE] Verifier\nindependent evidence judgment",
        fillcolor="#F3F5F8",
        fontname="PingFang SC",
        fontsize=9
      ];

      code_reviewer [
        label="[AE] Code Reviewer\nquality · risk review",
        fillcolor="#F3F5F8",
        fontname="PingFang SC",
        fontsize=9
      ];

      {
        rank=same;
        developer;
        code_fixer;
        verifier;
        code_reviewer;
      }

      developer -> code_fixer -> verifier -> code_reviewer [
        // layout only
        style=invis,
        weight=20
      ];
    }

    subgraph cluster_quality_execution {
      label="QUALITY EXECUTION AGENTS\nQUALITY OWNER ONLY";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=13;
      penwidth=1.5;
      style="rounded,filled";
      margin=13;

      node [
        color="#66768D",
        fillcolor="#F3F5F8",
        fontcolor="#66768D"
      ];

      qa_executor [
        label="[AE] QA Executor\nexecute · observe · capture evidence · retest",
        group="quality",
        fillcolor="#F3F5F8",
        fontname="PingFang SC",
        fontsize=9
      ];

      quality_analyst [
        label="[AE] Quality Analyst\nreproduce · read-only diagnosis · classify",
        fillcolor="#F3F5F8",
        fontname="PingFang SC",
        fontsize=9
      ];

      {
        rank=same;
        qa_executor;
        quality_analyst;
      }

      qa_executor -> quality_analyst [
        // layout only
        style=invis,
        weight=20
      ];
    }

    execution_label_clearance [
      label="",
      shape=box,
      // layout only
      style=invis,
      width=1.75,
      height=0.01,
      fixedsize=true
    ];

    {
      rank=same;
      quality_analyst;
      execution_label_clearance;
    }

    quality_analyst -> execution_label_clearance [
      // layout only
      style=invis,
      weight=20
    ];

    {
      rank=same;
      developer;
      qa_executor;
    }

    developer -> qa_executor [
      // layout only
      style=invis,
      weight=24
    ];

    execution_boundary [
      label="[EXECUTION BOUNDARY]\nbounded input only · no cross-Owner invocation · no acceptance · no environment action · no final disposition",
      shape=note,
      style=filled,
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC",
      fontcolor="#B42318",
      fontsize=9,
      penwidth=1.4
    ];

    verifier -> execution_boundary [
      // layout only
      style=invis,
      weight=24
    ];
  }

  human_current_authority -> product_director [
    // layout only
    style=invis,
    weight=100
  ];

  human_direction -> product_director [
    xlabel="authority / co-create",
    style=dashed,
    color="#A16207",
    fontcolor="#A16207",
    penwidth=1.7,
    arrowsize=0.75,
    tailport=s,
    headport=n,
    constraint=false
  ];

  human_accept -> impact_owner [
    xlabel="accept exact package",
    style=dashed,
    color="#A16207",
    fontcolor="#A16207",
    penwidth=1.7,
    arrowsize=0.75,
    tailport=s,
    headport=n,
    constraint=false
  ];

  human_invoke -> test_design_owner [
    xlabel="invoke next Owner",
    style=dashed,
    color="#A16207",
    fontcolor="#A16207",
    penwidth=1.7,
    arrowsize=0.75,
    tailport=s,
    headport=n
  ];

  human_invoke -> development_owner [
    xlabel="invoke Owner",
    style=dashed,
    color="#A16207",
    fontcolor="#A16207",
    penwidth=1.7,
    arrowsize=0.75,
    tailport=s,
    headport=n,
    constraint=false
  ];

  human_invoke -> quality_owner [
    xlabel="invoke Owner",
    style=dashed,
    color="#A16207",
    fontcolor="#A16207",
    penwidth=1.7,
    arrowsize=0.75,
    tailport=s,
    headport=n,
    constraint=false
  ];

  human_environment -> quality_owner [
    xlabel="authority / accept evidence\n(no execution transfer)",
    style=dashed,
    color="#A16207",
    fontcolor="#A16207",
    penwidth=1.7,
    arrowsize=0.75,
    tailport=s,
    headport=n,
    constraint=false
  ];

  human_disposition -> outcome_recommendation [
    xlabel="invoke recommendation /\nretain final disposition",
    style=dashed,
    color="#A16207",
    fontcolor="#A16207",
    penwidth=1.7,
    arrowsize=0.75,
    tailport=s,
    headport=n,
    constraint=false
  ];

  human_risk_incident -> authority_boundary [
    xlabel="authority remains Human",
    style=dashed,
    color="#A16207",
    fontcolor="#A16207",
    penwidth=1.5,
    arrowsize=0.7,
    tailport=s,
    headport=n,
    constraint=false
  ];

  authority_boundary -> developer [
    // layout only
    style=invis,
    weight=100,
    minlen=2
  ];

  disposition_boundary -> qa_executor [
    // layout only
    style=invis,
    weight=100,
    minlen=2
  ];

  development_owner -> developer [
    xlabel="delegates bounded work",
    color="#24466F",
    fontcolor="#24466F",
    penwidth=2.0,
    arrowsize=0.8,
    tailport=sw,
    headport=w
  ];

  development_owner -> code_fixer [
    color="#24466F",
    fontcolor="#24466F",
    penwidth=2.0,
    arrowsize=0.8,
    tailport=s,
    headport=e
  ];

  development_owner -> verifier [
    color="#24466F",
    fontcolor="#24466F",
    penwidth=2.0,
    arrowsize=0.8,
    tailport=se,
    headport=w
  ];

  development_owner -> code_reviewer [
    color="#24466F",
    fontcolor="#24466F",
    penwidth=2.0,
    arrowsize=0.8,
    tailport=e,
    headport=e
  ];

  quality_owner -> qa_executor [
    color="#24466F",
    fontcolor="#24466F",
    penwidth=2.0,
    arrowsize=0.8,
    tailport=s,
    headport=w
  ];

  quality_owner -> quality_analyst [
    xlabel="delegates bounded work",
    color="#24466F",
    fontcolor="#24466F",
    penwidth=2.0,
    arrowsize=0.8,
    tailport=e,
    headport=e
  ];
}
