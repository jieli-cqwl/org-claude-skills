digraph TeamBattleMap {
  graph [
    bgcolor="#F8FAFD",
    pad="0.24",
    labelloc=t,
    label="ONE-HUMAN + AGENT TEAM · TARGET V1.2\nTEAM BATTLE MAP · M0 MANUAL CONTROL · NOT RUNTIME-ACTIVE",
    fontname="PingFang SC",
    fontsize=22,
    fontcolor="#172033"
  ];

  node [shape=plain, fontname="PingFang SC", fontcolor="#172033"];

  battle_map [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"
             COLOR="#8FA6C2" BGCOLOR="#FFFFFF">
        <TR>
          <TD COLSPAN="4" BGCOLOR="#FFF3C7" COLOR="#A66A00" ALIGN="LEFT">
            <FONT POINT-SIZE="15"><B>[H] HUMAN CONTROL PLANE · 横切全程，不是串行第一站</B></FONT><BR ALIGN="LEFT"/>
            共创 Product / UX / Architecture · ACCEPT 精确版本 · INVOKE 下一 Owner ·
            测试/生产部署 · 停止/回滚/containment · incident authority · 业务验收 · Phase / Demand disposition
          </TD>
        </TR>
        <TR>
          <TD COLSPAN="4" BGCOLOR="#FFF9E8" COLOR="#A66A00" ALIGN="LEFT">
            <B>M0 RULE</B>：Owner 箭头只表示可提议 handoff；ACCEPT ≠ INVOKE ≠ actual start ≠ external action ≠ outcome。
            每次启动都必须核对 current authority；撤权或重复命令不得产生新的有效执行。
          </TD>
        </TR>
        <TR>
          <TD WIDTH="100" BGCOLOR="#DDE9F8"><B>战役阶段</B></TD>
          <TD WIDTH="560" BGCOLOR="#DDE9F8"><B>Agent 作战线</B></TD>
          <TD WIDTH="330" BGCOLOR="#FFF3C7"><B>人的共创 / 权限 / 闸门</B></TD>
          <TD WIDTH="290" BGCOLOR="#EEE6FA"><B>阶段出口与证据</B></TD>
        </TR>

        <TR>
          <TD BGCOLOR="#EAF2FF"><FONT POINT-SIZE="15"><B>1</B></FONT><BR/><B>DEFINE</B><BR/>找对问题</TD>
          <TD ALIGN="LEFT">
            <B>[AO] Product Director</B> · WHY / 真实场景 / 价值 / Active Phase<BR ALIGN="LEFT"/>
            ↓ <B>[AO] Product Manager</B> · WHAT / 对象 / 状态 / 规则 / AC<BR ALIGN="LEFT"/>
            ↓ <B>[AO] Impact Owner · ONE OWNER / ONE LINEAGE</B><BR ALIGN="LEFT"/>
            discovery checkpoint → activated UX / Architecture 或显式 skip → freeze checkpoint
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#FFF9E8">
            与 Product Director、Product Manager 深度共创；<BR ALIGN="LEFT"/>
            需要时与 UX / Architecture 共创；<BR ALIGN="LEFT"/>
            验收每个顶层包并逐个调用下一 Owner。
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#F4EEFC">
            <B>[ART]</B> Director Decision Case<BR ALIGN="LEFT"/>
            → Product Definition Package<BR ALIGN="LEFT"/>
            → one Impact Package lineage<BR ALIGN="LEFT"/>
            <FONT POINT-SIZE="10">blocking impact gaps = 0</FONT>
          </TD>
        </TR>

        <TR>
          <TD BGCOLOR="#EAF2FF"><FONT POINT-SIZE="15"><B>2</B></FONT><BR/><B>PROVE &amp; PLAN</B><BR/>先定义怎么证明</TD>
          <TD ALIGN="LEFT">
            <B>[AO] Test Design Owner</B> · 开发前冻结证明义务、回归面与 QA 合同<BR ALIGN="LEFT"/>
            ↓ <B>[AO] Tech Lead</B> · 实现路径 / 依赖 / 批次 / 有界 Task 拆分
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#FFF9E8">
            审核“能否被证明”与“是否可执行”；<BR ALIGN="LEFT"/>
            分别验收 Test Design 与 Tech Lead 输出；<BR ALIGN="LEFT"/>
            手动调用下一 Owner。
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#F4EEFC">
            <B>[ART]</B> Test Design Package<BR ALIGN="LEFT"/>
            → Tech Lead Package<BR ALIGN="LEFT"/>
            → bounded Task Packets
          </TD>
        </TR>

        <TR>
          <TD BGCOLOR="#EAF2FF"><FONT POINT-SIZE="15"><B>3</B></FONT><BR/><B>BUILD</B><BR/>达到提测标准</TD>
          <TD ALIGN="LEFT">
            <B>[AO] Development Owner · 唯一代码修改域</B><BR ALIGN="LEFT"/>
            <FONT COLOR="#40566F">[AE] Developer · Code Fixer · Verifier · Code Reviewer</FONT><BR ALIGN="LEFT"/>
            TDD / 集成 / 验证 / 评审 → immutable Candidate + environment-specific Manifest
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#FFF9E8">
            首次 test action 前冻结 <B>Phase Success Baseline</B>；<BR ALIGN="LEFT"/>
            验收 exact Candidate + test Manifest + Test Admission；<BR ALIGN="LEFT"/>
            <B>[H-GATE]</B> 授权并执行测试部署；失败、部分或未知结果全部阻断 QA。
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#F4EEFC">
            <B>[ART · IMMUTABLE]</B> Candidate<BR ALIGN="LEFT"/>
            + test Deployment Manifest<BR ALIGN="LEFT"/>
            + Phase Success Baseline<BR ALIGN="LEFT"/>
            + Test Admission / trustworthy deployment outcome
          </TD>
        </TR>

        <TR>
          <TD BGCOLOR="#EAF2FF"><FONT POINT-SIZE="15"><B>4</B></FONT><BR/><B>QUALIFY &amp; RELEASE</B><BR/>独立质量与生产</TD>
          <TD ALIGN="LEFT">
            <B>[AO] Quality Owner · NO CODE CHANGE</B><BR ALIGN="LEFT"/>
            <FONT COLOR="#40566F">[AE] QA Executor · Quality Analyst</FONT><BR ALIGN="LEFT"/>
            pre-release QA / Finding 分类 / 复测 → Release Package<BR ALIGN="LEFT"/>
            production deploy 后恢复执行独立生产验证
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#FFF9E8">
            调用 Quality Owner；代码缺陷只 route，不顺手修；<BR ALIGN="LEFT"/>
            验收 exact PRODUCT Release Package 与残余风险；<BR ALIGN="LEFT"/>
            <B>[H-GATE]</B> affected incident set known + empty → 人执行生产部署；<BR ALIGN="LEFT"/>
            current state settled 后调用生产验证；最后由人完成业务验收。
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#F4EEFC">
            <B>[ART]</B> Release Package<BR ALIGN="LEFT"/>
            <FONT POINT-SIZE="10">qualifies exact Candidate + production Manifest against Baseline</FONT><BR ALIGN="LEFT"/>
            → trustworthy Production Outcome<BR ALIGN="LEFT"/>
            → Production Verification Evidence<BR ALIGN="LEFT"/>
            → Business Acceptance Record
          </TD>
        </TR>

        <TR>
          <TD BGCOLOR="#EAF2FF"><FONT POINT-SIZE="15"><B>5</B></FONT><BR/><B>CLOSE &amp; LEARN</B><BR/>真实结果回流</TD>
          <TD ALIGN="LEFT">
            <B>[AO ACTIVITY] Product Director resumes</B><BR ALIGN="LEFT"/>
            用 current 生产结果或人工 stop 证据产出 Closeout Recommendation；只建议，不裁决
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#FFF9E8">
            <B>[H]</B> 记录一致的 Phase + Demand disposition：<BR ALIGN="LEFT"/>
            F16 → closed / terminated Phase 后的 exact new Phase；F17 → paused / rework same Phase 的 exact Owner；<BR ALIGN="LEFT"/>
            两类 authority 不得并存；<BR ALIGN="LEFT"/>
            closed / terminated Phase 与 completed / terminated Demand 不可复活；<BR ALIGN="LEFT"/>
            Product outcome 不关闭 open Incident Case。
          </TD>
          <TD ALIGN="LEFT" BGCOLOR="#F4EEFC">
            <B>[ART]</B> Closeout Recommendation<BR ALIGN="LEFT"/>
            → Disposition Decision<BR ALIGN="LEFT"/>
            → separate Phase Outcome + Demand Outcome<BR ALIGN="LEFT"/>
            <FONT POINT-SIZE="10">RT 永远 non-success；R10 才是真成功</FONT>
          </TD>
        </TR>

        <TR>
          <TD COLSPAN="4" BGCOLOR="#FDECEC" COLOR="#B43A3A" ALIGN="LEFT">
            <B>FAILURE RULE</B>：Finding Route 必须写明 evidence、authority domain、route type、唯一 next Owner、
            invalidation 与 resume condition；未知根因先 DIAGNOSTIC。<BR ALIGN="LEFT"/>
            生产诊断有界、持续可安全退出、无 Release PASS、只回 R00；失败 / partial / unknown environment action → containment + R09。<BR ALIGN="LEFT"/>
            Phase Baseline 冻结后不得靠换标准洗掉失败；Incident remediation 独立恢复安全状态，不能复活产品终态或贡献产品成功。
          </TD>
        </TR>
        <TR>
          <TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F5F7FA">
            <B>图例</B>　[H] 人的权力 / 动作　 [AO] Accountable Agent Owner　
            [AE] 有界执行 Agent　 [ART] 版本化工件　 [H-GATE] 人批准并执行的部署 / 回滚 / 业务权力闸门
          </TD>
        </TR>
      </TABLE>
    >
  ];
}
