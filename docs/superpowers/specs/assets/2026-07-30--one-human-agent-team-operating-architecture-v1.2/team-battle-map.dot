        style="rounded,filled",
        color="#24466F",
        fillcolor="#FFFFFF",
        fontcolor="#24466F",
        fontname="PingFang SC",
        fontsize=17,
        height=0.25,
        margin="0.03,0.02"
      ];

      build_purpose -> build_development_owner [
          dir=none,
          color="#B8C2D1",
          penwidth=1.0
        ];

      build_development_owner -> build_developer [
        dir=none,
        color="#B8C2D1",
        penwidth=1.0
      ];

      build_development_owner -> build_code_fixer [
        dir=none,
        color="#B8C2D1",
        penwidth=1.0
      ];

      build_developer -> build_verifier [
        dir=none,
        color="#B8C2D1",
        penwidth=1.0
      ];

      build_code_fixer -> build_code_reviewer [
        dir=none,
        color="#B8C2D1",
        penwidth=1.0
      ];

      build_verifier -> build_test_deployment [
        dir=none,
        color="#B8C2D1",
        penwidth=1.0
      ];

      build_code_reviewer -> build_test_deployment [
        dir=none,
        color="#B8C2D1",
        penwidth=1.0
      ];

      build_test_deployment -> build_output [
