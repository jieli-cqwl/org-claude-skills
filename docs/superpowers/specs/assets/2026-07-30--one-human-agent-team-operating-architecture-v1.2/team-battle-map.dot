      fillcolor="#E7F7F3",
      fontname="PingFang SC"
    ];

    {
      rank=same;
      state_baseline;
      state_candidate;
      state_manifest;
      state_environment;
      state_finding_route;
    }

    state_baseline -> state_candidate -> state_manifest ->
      state_environment -> state_finding_route [
        // layout only
        style=invis,
        weight=20
      ];
  }

  subgraph cluster_failure {
    label="FAILURE & INCIDENT LANE";
    labelloc=t;
    labeljust=l;
    color="#B42318";
    fillcolor="#FDECEC";
    fontname="PingFang SC";
    fontcolor="#B42318";
    fontsize=15;
    penwidth=1.7;
    style="rounded,filled";
    margin=14;

    node [
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=11.5
    ];

    failure_gap [
      label="failure/gap",
      shape=diamond,
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC",
      penwidth=1.8
    ];

    failure_diagnose [
      label="diagnose\ndomain",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC"
    ];

    failure_owner [
      label="earliest wrong\nOwner",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC"
    ];

    failure_invalidate [
      label="invalidate affected\nevidence",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC"
    ];

    failure_reenter [
      label="re-enter every\naffected gate",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC"
    ];

    failure_guard [
      label="UNKNOWN cause remains DIAGNOSTIC\nfailed/indeterminate\nenvironment action ≠ success",
      shape=note,
      style=filled,
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC",
      fontsize=10.5
    ];

    failure_incident [
      label="[INCIDENT]\nIncident Case closes\nindependently\nProduct closeout\ndoes not close it",
      shape=note,
      style=filled,
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC",
      fontsize=10.5
    ];

    failure_return_rule [
      label="[RETURN ROUTER]\nR00–R09 selects exactly one\nroute-named Owner\nall affected gates rerun",
      shape=note,
      style=filled,
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="PingFang SC",
      fontsize=10.5
    ];

    {
      rank=same;
      failure_gap;
      failure_diagnose;
      failure_owner;
      failure_invalidate;
      failure_reenter;
    }

    {
      rank=same;
      failure_guard;
      failure_incident;
      failure_return_rule;
    }

    failure_gap -> failure_diagnose -> failure_owner ->
      failure_invalidate -> failure_reenter [
        color="#B42318",
        fontcolor="#B42318",
        penwidth=1.9,
        arrowsize=0.8
      ];

    failure_diagnose -> failure_guard [
      xlabel="diagnostic only",
      style=dashed,
      color="#B42318",
      arrowhead=none
    ];

    failure_reenter -> failure_incident [
      xlabel="independent authority",
      style=dashed,
      color="#B42318",
      fontcolor="#B42318",
      arrowhead=none
    ];

    failure_reenter -> failure_return_rule [
      xlabel="route rule",
      style=dashed,
      color="#B42318",
      arrowhead=none
    ];

    failure_guard -> failure_return_rule -> failure_incident [
      // layout only
      style=invis,
      weight=20
    ];

  }

  human_co_create -> product_purpose [
    // layout only
    style=invis,
    weight=100
  ];

  human_invoke_owner -> proof_purpose [
    // layout only
    style=invis,
    weight=100
  ];

  human_test_deployment -> build_purpose [
    // layout only
    style=invis,
    weight=100
  ];

  human_production_deployment -> quality_purpose [
    // layout only
    style=invis,
    weight=100
  ];

  human_business_disposition -> outcome_purpose [
    // layout only
    style=invis,
    weight=100
  ];

  human_action_law -> product_purpose [
    // layout only
    style=invis,
    weight=100
  ];

  human_safety_authority -> outcome_purpose [
    // layout only
    style=invis,
    weight=100
  ];

  product_output -> state_baseline [
    // layout only
    style=invis,
    weight=100
  ];

  proof_output -> state_candidate [
    // layout only
    style=invis,
    weight=100
  ];

  build_output -> state_manifest [
    // layout only
    style=invis,
    weight=100
  ];

  quality_output -> state_environment [
    // layout only
    style=invis,
    weight=100
  ];

  outcome_output -> state_finding_route [
    // layout only
    style=invis,
    weight=100
  ];

  state_baseline -> failure_guard [
    // layout only
    style=invis,
    weight=100
  ];

  state_manifest -> failure_return_rule [
    // layout only
    style=invis,
    weight=100
  ];

  state_finding_route -> failure_incident [
    // layout only
    style=invis,
    weight=100
  ];

  human_test_deployment -> build_test_deployment [
    xlabel="test deployment authority",
    style=dashed,
    color="#A16207",
    penwidth=1.7,
    arrowsize=0.7,
    constraint=false
  ];

  human_production_deployment -> quality_production_deployment [
    xlabel="production deployment authority",
    style=dashed,
    color="#A16207",
    penwidth=1.7,
    arrowsize=0.7,
    constraint=false
  ];

  human_business_disposition -> outcome_business_acceptance [
    xlabel="business acceptance authority",
    style=dashed,
    color="#A16207",
    penwidth=1.7,
    arrowsize=0.7,
    constraint=false
  ];

  human_business_disposition -> outcome_disposition [
    xlabel="disposition authority",
    style=dashed,
    color="#A16207",
    penwidth=1.7,
    arrowsize=0.7,
    constraint=false
  ];

  state_finding_route -> failure_gap [
    xlabel="failure route",
    style=dashed,
    color="#B42318",
    penwidth=1.4,
    arrowsize=0.7
  ];

  product_impact_owner -> failure_owner [
    xlabel="return: impact",
    dir=back,
    style=dashed,
    color="#B42318",
    penwidth=1.3,
    arrowsize=0.7,
    constraint=false
  ];

  build_development_owner -> failure_owner [
    xlabel="return: development",
    dir=back,
    style=dashed,
    color="#B42318",
    penwidth=1.3,
