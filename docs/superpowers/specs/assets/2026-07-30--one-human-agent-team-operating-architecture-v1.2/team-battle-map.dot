digraph TeamBattleMap {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    ordering=out,
    splines=ortho,
    outputorder=edgesfirst,
    bgcolor="#F7F9FC",
    pad="0.30",
    nodesep="0.30",
    ranksep="0.56",
    labelloc=t,
    labeljust=l,
    label="ONE-HUMAN + AGENT TEAM\nTARGET OPERATING ARCHITECTURE · V1.2 · VIEW R4\nM0 MANUAL CONTROL · Human-governed · Agent-executed · Evidence-driven\nTARGET DESIGN · NOT RUNTIME-ACTIVE",
    fontname="PingFang SC",
    fontsize=24,
    fontcolor="#152238"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#B8C2D1",
    fillcolor="#FFFFFF",
    fontname="PingFang SC",
    fontcolor="#152238",
    fontsize=11,
    margin="0.13,0.09",
    penwidth=1.2
  ];

  edge [
    fontname="PingFang SC",
    fontsize=9,
    fontcolor="#40536D",
    color="#66768D",
    arrowsize=0.72,
    penwidth=1.25
  ];

  subgraph cluster_human {
    label="HUMAN CONTROL PLANE";
    labelloc=t;
    labeljust=l;
    color="#A16207";
    fillcolor="#FFF4D6";
    fontname="PingFang SC";
    fontcolor="#A16207";
    fontsize=15;
    penwidth=1.6;
    style="rounded,filled";
    margin=14;

    node [
      color="#A16207",
      fillcolor="#FFF4D6",
      fontcolor="#A16207",
      fontsize=11.5
    ];

    human_co_create [
      label="[H]\nco-create\nvalue/direction",
      group="column_1",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_accept_artifact [
      label="[H]\naccept exact\nartifact",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_invoke_owner [
      label="[H]\ninvoke next\nOwner",
      group="column_2",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_test_deployment [
      label="[H]\nexecute test\ndeployment",
      group="column_3",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_production_deployment [
      label="[H]\nexecute production\ndeployment",
      group="column_4",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_business_disposition [
      label="[H]\nbusiness acceptance\n/disposition",
      group="column_5",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      penwidth=2.0
    ];

    human_action_law [
      label="[H]\n[CONTROL LAW]\nACCEPT ≠ INVOKE\n≠ ACTUAL START\n≠ EXTERNAL ACTION\n≠ OUTCOME\nrevalidate current authority\nat every Owner start",
      shape=note,
      style=filled,
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      fontsize=10.5,
      penwidth=2.0
    ];

    human_safety_authority [
      label="[H]\nSAFETY AUTHORITY\nSTOP · ROLLBACK\nCONTAINMENT · INCIDENT AUTHORITY",
      shape=note,
      style=filled,
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="PingFang SC",
      fontsize=10.5,
      penwidth=2.0
    ];

    {
      rank=same;
      human_co_create;
      human_accept_artifact;
      human_invoke_owner;
      human_test_deployment;
      human_production_deployment;
      human_business_disposition;
    }

    {
      rank=same;
      human_action_law;
      human_safety_authority;
    }

    human_co_create -> human_accept_artifact -> human_invoke_owner ->
      human_test_deployment -> human_production_deployment ->
      human_business_disposition [
        // layout only
        style=invis,
        weight=20
      ];

    human_co_create -> human_action_law [
      // layout only
      style=invis,
      weight=20
    ];

    human_production_deployment -> human_safety_authority [
      // layout only
      style=invis,
      weight=20
    ];

    human_action_law -> human_safety_authority [
      // layout only
      style=invis,
      weight=20
    ];
  }

  subgraph cluster_main_path {
    label="MAIN SYSTEM PATH · F01–F17 · HUMAN-MEDIATED HANDOFFS";
    labelloc=t;
    labeljust=l;
    color="#24466F";
    fillcolor="#F8FBFF";
    fontname="PingFang SC";
    fontcolor="#24466F";
    fontsize=15;
    penwidth=1.8;
    style="rounded,filled";
    margin=14;

    subgraph cluster_product {
      label="01 PRODUCT DEFINITION";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=17;
      penwidth=1.7;
      style="rounded,filled";
      margin=10;

      node [
        color="#2459A9",
        fillcolor="#EAF2FF",
        fontcolor="#2459A9",
        fontsize=11.5
      ];

      product_purpose [
        label="Find the right problem\nand freeze the complete\nproduct boundary.",
        group="column_1",
        color="#152238",
        fillcolor="#152238",
        fontcolor="#FFFFFF",
        fontname="PingFang SC",
        fontsize=17,
        margin="0.08,0.05"
      ];

      product_director [
        label="[AO] Product Director",
        group="column_1",
        fontname="PingFang SC"
      ];

      product_manager [
        label="[AO] Product Manager\nActors · User touchpoints\nMain/exception flows\nObjects · States · Rules\nPermissions · AC",
        group="column_1",
        fontname="PingFang SC",
        fontsize=12
      ];

      product_impact_owner [
        label="[AO] Impact Owner",
        group="column_1",
        fontname="PingFang SC"
      ];

      product_ux_owner [
        label="[AO][OPTIONAL]\nUX Owner",
        style="rounded,dashed,filled",
        color="#66768D",
        fillcolor="#EAF2FF",
        fontcolor="#66768D",
        fontsize=10.5
      ];

      product_architecture_owner [
        label="[AO][OPTIONAL]\nArchitecture Owner",
        style="rounded,dashed,filled",
        color="#66768D",
        fillcolor="#EAF2FF",
        fontcolor="#66768D",
        fontsize=10.5
      ];

      product_output [
        label="[ART]\nDirector Decision Case\nProduct Definition Package\nImpact Freeze",
        group="column_1",
        shape=note,
        style=filled,
        color="#0F766E",
        fillcolor="#E7F7F3",
        fontname="PingFang SC",
        fontcolor="#0F766E",
        fontsize=17,
        margin="0.08,0.05",
        penwidth=1.5
      ];

      product_purpose -> product_director -> product_manager ->
        product_impact_owner [
          dir=none,
          color="#B8C2D1",
          penwidth=1.0
        ];

      product_impact_owner -> product_ux_owner [
        xlabel="optional activation",
        dir=none,
        style=dashed,
        color="#66768D"
      ];

      product_impact_owner -> product_architecture_owner [
        xlabel="optional activation",
        dir=none,
        style=dashed,
        color="#66768D"
      ];

      product_ux_owner -> product_output [
        xlabel="if activated",
        dir=none,
        style=dashed,
        color="#66768D"
      ];

      product_architecture_owner -> product_output [
        xlabel="if activated",
        dir=none,
        style=dashed,
        color="#66768D"
      ];

      {
        rank=same;
        product_director;
        product_manager;
        product_impact_owner;
      }

      {
        rank=same;
        product_ux_owner;
        product_architecture_owner;
      }
    }

    subgraph cluster_proof {
      label="02 PROOF & PLAN";
      labelloc=t;
      labeljust=l;
      color="#24466F";
      fillcolor="#F8FBFF";
      fontname="PingFang SC";
      fontcolor="#24466F";
      fontsize=17;
      penwidth=1.7;
      style="rounded,filled";
      margin=10;

      node [
        color="#2459A9",
        fillcolor="#EAF2FF",
        fontcolor="#2459A9",
        fontsize=11.5
      ];

      proof_purpose [
        label="Define how success\nwill be proved,\nthen bound the work.",
        group="column_2",
        color="#152238",
        fillcolor="#152238",
        fontcolor="#FFFFFF",
        fontname="PingFang SC",
        fontsize=17,
        margin="0.08,0.05"
      ];

      proof_test_design_owner [
        label="[AO] Test Design Owner",
        group="column_2",
        fontname="PingFang SC"
      ];

      proof_tech_lead [
        label="[AO] Tech Lead",
        group="column_2",
        fontname="PingFang SC"
      ];

      proof_output [
        label="[ART]\nTest Design Package\nTech Lead Package\nBounded Task Packets",
        group="column_2",
        shape=note,
        style=filled,
        color="#0F766E",
        fillcolor="#E7F7F3",
        fontname="PingFang SC",
        fontcolor="#0F766E",
        fontsize=17,
        margin="0.08,0.05",
        penwidth=1.5
      ];

      proof_handoff_in [
        label="accepted\ndefinition",
        shape=box,
        style="rounded,filled",
        color="#24466F",
        fillcolor="#FFFFFF",
        fontcolor="#24466F",
        fontname="PingFang SC",
        fontsize=17,
        height=0.25,
        margin="0.03,0.02"
      ];

      proof_purpose -> proof_test_design_owner -> proof_tech_lead ->
        proof_output [
          dir=none,
          color="#B8C2D1",
          penwidth=1.0
        ];

      {
        rank=same;
        proof_test_design_owner;
        proof_tech_lead;
      }
    }

    subgraph cluster_build {
      label="03 BUILD";
      labelloc=t;
