      color="#B23A48",
      style=dashed,
      penwidth=2.0
    ];

    business_nonaccepted -> r09 [
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    r10 -> pd_success_recommendation [
      color="#177E89",
      penwidth=2.0
    ];

    pd_success_recommendation -> human_success_disposition [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    human_success_disposition -> success_outcomes [
      color="#177E89",
      penwidth=1.9
    ];

    human_stop -> rt [
      color="#B23A48",
      style=dashed,
      penwidth=2.0
    ];

    rt -> pd_non_success_recommendation [
      color="#B23A48",
      style=dashed,
      penwidth=2.0
    ];

    pd_non_success_recommendation -> human_non_success_disposition [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    human_non_success_disposition -> non_success_outcomes [
      color="#B23A48",
      penwidth=2.0
    ];

    success_outcomes -> demand_terminal_outcomes [
      color="#64748B",
      penwidth=1.6
    ];

    non_success_outcomes -> demand_terminal_outcomes [
      color="#64748B",
      penwidth=1.6
    ];

    success_outcomes -> demand_nonterminal_outcome [
      color="#177E89",
      penwidth=1.8
    ];

    non_success_outcomes -> demand_nonterminal_outcome [
      color="#177E89",
      penwidth=1.8
    ];

    demand_nonterminal_outcome -> human_next_phase_authority [
      color="#B7791F",
      style=dashed,
      penwidth=1.8
    ];

    human_next_phase_authority -> f16 [
      color="#B7791F",
      style=dashed,
      penwidth=1.8
    ];

    paused_rework_state -> f17 [
      color="#B7791F",
      style=dashed,
      penwidth=1.8
    ];

    f17 -> f17_target [
      color="#2F6DB0",
      penwidth=1.6
    ];

    f16 -> f17 [
      dir=both,
      arrowhead=tee,
      arrowtail=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    human_success_disposition -> incident_closure_block [
      arrowhead=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    human_non_success_disposition -> incident_closure_block [
      arrowhead=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    {
      rank=same;
      production_evidence;
      human_stop;
      paused_rework_state;
    }

    {
      rank=same;
      business_acceptance;
      rt;
    }

    {
      rank=same;
      accepted_product_result;
      business_nonaccepted;
      pd_non_success_recommendation;
    }

    {
      rank=same;
      r10;
      pd_success_recommendation;
      human_non_success_disposition;
    }

    {
      rank=same;
      human_success_disposition;
      success_outcomes;
      non_success_outcomes;
      demand_terminal_outcomes;
      incident_closure_block;
    }

    {
      rank=same;
      demand_nonterminal_outcome;
      human_next_phase_authority;
      f16;
      f17;
      f17_target;
    }

    // Layout only: compact vertical stacks preserve three independent tracks.
    paused_rework_state -> human_stop -> production_evidence [style=invis, weight=100];
    rt -> business_acceptance [style=invis, weight=100];
    pd_non_success_recommendation -> business_nonaccepted ->
      accepted_product_result [style=invis, weight=100];
    human_non_success_disposition -> pd_success_recommendation ->
      r10 [style=invis, weight=100];
    incident_closure_block -> demand_terminal_outcomes ->
      non_success_outcomes ->
      success_outcomes -> human_success_disposition [style=invis, weight=100];
    f17_target -> f17 -> f16 ->
      human_next_phase_authority -> demand_nonterminal_outcome
      [style=invis, weight=100];
  }

  {
    rank=same;
    diagnostic_anchor;
    corrective_anchor;
    authority_anchor;
    completion_anchor;
  }

  lane_order_seed [
    shape=point,
    style=invis,
    width=0,
    height=0,
    label=""
  ];

  // Layout only: one ordered fan-out fixes the swimlanes top-to-bottom.
  lane_order_seed -> diagnostic_anchor [style=invis, weight=100];
  lane_order_seed -> corrective_anchor [style=invis, weight=100];
  lane_order_seed -> authority_anchor [style=invis, weight=100];
  lane_order_seed -> completion_anchor [style=invis, weight=100];
}
