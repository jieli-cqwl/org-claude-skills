    ir00 [
      label="[IR00][INCIDENT]\nOPEN / PRESERVE THE EXACT INCIDENT CASE\n+ environment-level incident block\nPRODUCT CLOSEOUT CANNOT CLOSE IT",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      fontsize=10.5,
      penwidth=2.0
    ];

    ir01 [
      label="[H][IR01]\nACCEPT ONE BOUNDED INCIDENT ROUTE\ninvoke exact Owner under\nINCIDENT_REMEDIATION authority",
      shape=diamond,
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontcolor="#7A4B00",
      fontname="Helvetica-Bold",
      fontsize=10.5,
      penwidth=2.0
    ];

    ir02 [
      label="[IR02][REMEDIATION]\nBOUNDED WORK · NORMAL ROLE BOUNDARIES\nrerun every affected identity · review · test\nquality · deployment · verification gate",
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
