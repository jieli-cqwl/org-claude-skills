      fontsize=10.5,
      penwidth=1.9
    ];

    ir03 [
      label="[IR03][INDEPENDENT SAFETY PROOF]\ncurrent safe environment · no unresolved mutation\ncontainment / recovery proven · Incident Verification\nHuman resolves exact Case · NO PRODUCT-SUCCESS AUTHORITY",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFFFFF",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      fontsize=10.5,
      penwidth=2.0
