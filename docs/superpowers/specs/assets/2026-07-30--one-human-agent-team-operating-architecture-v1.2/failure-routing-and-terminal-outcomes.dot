digraph FailureRoutingAndTerminalOutcomes {
  graph [
    bgcolor="#F8FAFD",
    pad="0.24",
    labelloc=t,
    label="FAILURE ROUTING AND REAL COMPLETION · TARGET V1.2\nDETERMINISTIC RETURN · INDEPENDENT INCIDENT LANE · HONEST TERMINAL OUTCOMES\nM0 MANUAL CONTROL · NOT RUNTIME-ACTIVE",
    fontname="PingFang SC",
    fontsize=22,
    fontcolor="#172033"
  ];

  node [shape=plain, fontname="PingFang SC", fontcolor="#172033"];

  routing_map [
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="14" CELLPADDING="0" BGCOLOR="#F8FAFD">
        <TR>
          <TD>
            <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"
                   COLOR="#8FA6C2" BGCOLOR="#FFFFFF" WIDTH="1380">
              <TR>
                <TD COLSPAN="6" BGCOLOR="#DDE9F8" ALIGN="LEFT">
                  <FONT POINT-SIZE="14"><B>1 · FINDING ROUTE PACKAGE · 失败不是一句“退回去”</B></FONT>
                </TD>
              </TR>
              <TR>
                <TD BGCOLOR="#EAF2FF"><B>Evidence</B><BR/>事实 + exact identity</TD>
                <TD BGCOLOR="#EAF2FF"><B>Domain</B><BR/>PRODUCT / INCIDENT</TD>
                <TD BGCOLOR="#EAF2FF"><B>Type</B><BR/>diagnostic / corrective / authority / terminal</TD>
                <TD BGCOLOR="#EAF2FF"><B>One Owner</B><BR/>唯一 next action</TD>
                <TD BGCOLOR="#FDECEC" COLOR="#B43A3A"><B>Invalidate</B><BR/>哪些结论 / 权限失效</TD>
                <TD BGCOLOR="#FFF3C7" COLOR="#A66A00"><B>Resume</B><BR/>人决策 + 可观察条件</TD>
              </TR>
              <TR>
                <TD COLSPAN="6" BGCOLOR="#FFF9E8" ALIGN="LEFT" COLOR="#A66A00">
                  Unknown root cause 只能保持 <B>R00 DIAGNOSTIC</B>；不得猜一个修复、宣布 PASS、进入 release 或 closeout。
                  Human containment 是权限动作，不等于根因结论；只有 trustworthy complete outcome 才证明安全。
                </TD>
              </TR>
            </TABLE>
          </TD>
        </TR>

        <TR>
          <TD>
            <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"
                   COLOR="#8FA6C2" BGCOLOR="#FFFFFF" WIDTH="1380">
              <TR>
                <TD COLSPAN="4" BGCOLOR="#DDE9F8" ALIGN="LEFT">
                  <FONT POINT-SIZE="14"><B>2 · MACRO ROUTE MAP · 找到最早错误 Owner，再从受影响闸门重跑</B></FONT>
                </TD>
              </TR>
              <TR>
                <TD WIDTH="170" BGCOLOR="#DDE9F8"><B>Route family</B></TD>
                <TD WIDTH="360" BGCOLOR="#DDE9F8"><B>Trigger</B></TD>
                <TD WIDTH="480" BGCOLOR="#DDE9F8"><B>Accountable destination</B></TD>
                <TD WIDTH="370" BGCOLOR="#DDE9F8"><B>Resume law</B></TD>
              </TR>
              <TR>
                <TD BGCOLOR="#FFF3C7" COLOR="#A66A00"><B>R00</B><BR/>DIAGNOSTIC</TD>
                <TD ALIGN="LEFT">失败真实，但根因域未知</TD>
                <TD ALIGN="LEFT">一个明确 diagnostic Owner；部署后默认由 Quality Owner intake</TD>
                <TD ALIGN="LEFT">只产证据并回 R00；生产取证走 D00–D02，无 Release PASS</TD>
              </TR>
              <TR>
                <TD BGCOLOR="#EAF2FF"><B>R01–R03</B><BR/>CORRECTIVE</TD>
                <TD ALIGN="LEFT">WHY / WHAT / impact coverage 错误或不完整</TD>
                <TD ALIGN="LEFT">
                  <B>R01 Product Director</B> · 真实问题 / 价值 / Phase<BR ALIGN="LEFT"/>
                  <B>R02 Product Manager</B> · 行为 / 规则 / 状态 / AC<BR ALIGN="LEFT"/>
                  <B>R03 Impact Owner</B> · 影响面 / preserved behavior
                </TD>
                <TD ALIGN="LEFT">依赖工件 stale；产出新 revision；刷新 Impact freeze 与全部受影响闸门</TD>
              </TR>
              <TR>
                <TD BGCOLOR="#EAF2FF"><B>R04–R07</B><BR/>CORRECTIVE</TD>
                <TD ALIGN="LEFT">UX、Architecture、proof obligation 或实现错误</TD>
                <TD ALIGN="LEFT">
                  <B>R04 UX Owner</B> · journey / interaction<BR ALIGN="LEFT"/>
                  <B>R05 Architecture Owner</B> · interface / data / migration / rollback<BR ALIGN="LEFT"/>
                  <B>R06 Test Design Owner</B> · proof / coverage / QA contract<BR ALIGN="LEFT"/>
                  <B>R07 Development Owner</B> · implementation / Manifest
                </TD>
                <TD ALIGN="LEFT">变化创建新 identity / revision；affected verify、review、deploy、QA 和 release gate 重跑</TD>
              </TR>
              <TR>
                <TD BGCOLOR="#FFF3C7" COLOR="#A66A00"><B>R08</B><BR/>AUTHORITY</TD>
                <TD ALIGN="LEFT">环境、权限、外部依赖、前置状态或 action reconciliation 错误</TD>
                <TD ALIGN="LEFT"><B>Human control plane</B>；product / code 结论默认保留，除非证据反驳</TD>
                <TD ALIGN="LEFT">current state 可信 + fresh action authority；新 side effect 必须新 action identity</TD>
              </TR>
              <TR>
                <TD BGCOLOR="#FDECEC" COLOR="#B43A3A"><B>R09</B><BR/>AUTHORITY</TD>
                <TD ALIGN="LEFT" BGCOLOR="#FDECEC">生产 / 诊断 / 回滚 / containment / verification / BA 失败、部分、未知或失去 current validity</TD>
                <TD ALIGN="LEFT" BGCOLOR="#FFF9E8"><B>Human control plane</B> → containment + exact Incident Case</TD>
                <TD ALIGN="LEFT" BGCOLOR="#FDECEC">安全状态可信、Incident resolved、无 unresolved mutation、唯一非诊断 route、fresh resume authority</TD>
              </TR>
              <TR>
                <TD BGCOLOR="#FDECEC" COLOR="#B43A3A"><B>RT</B><BR/>TERMINAL</TD>
                <TD ALIGN="LEFT">Human 停止产品工作并要求 non-success closeout</TD>
                <TD ALIGN="LEFT"><B>Product Director</B> 只产 non-success recommendation</TD>
                <TD ALIGN="LEFT">Human 记录 honest termination；成功被禁止；open incident 继续独立处理</TD>
              </TR>
              <TR>
                <TD BGCOLOR="#EAF2FF"><B>R10</B><BR/>TERMINAL SUCCESS</TD>
                <TD ALIGN="LEFT">PRODUCT 结果满足 frozen Baseline；exact production evidence current；incident empty；无 unresolved action</TD>
                <TD ALIGN="LEFT"><B>Product Director</B> 推荐成功，<B>Human</B> 最终裁决</TD>
                <TD ALIGN="LEFT">重新核对 current evidence；分别记录 Phase 与 Demand outcome</TD>
              </TR>
              <TR>
                <TD COLSPAN="4" BGCOLOR="#FDECEC" COLOR="#B43A3A" ALIGN="LEFT">
                  <B>BASELINE LAW</B>：首次 test action 后，R01–R07 必须映射旧义务。
                  同一 Phase 只能保持或加强成功标准；移除 / 放宽成功义务必须 honest terminate 旧 Phase，再开新 Phase。
                </TD>
              </TR>
            </TABLE>
          </TD>
        </TR>

        <TR>
          <TD>
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="14" CELLPADDING="0" WIDTH="1380">
              <TR>
                <TD VALIGN="TOP">
                  <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"
                         COLOR="#A66A00" BGCOLOR="#FFFFFF" WIDTH="675">
                    <TR>
                      <TD COLSPAN="4" BGCOLOR="#FFF3C7" ALIGN="LEFT">
                        <FONT POINT-SIZE="14"><B>3A · PRODUCTION-ONLY DIAGNOSTIC · D00–D02</B></FONT>
                      </TD>
                    </TR>
                    <TR>
                      <TD BGCOLOR="#FFF9E8"><B>R00 accepted</B><BR/>read-only / test 不足</TD>
                      <TD BGCOLOR="#EAF2FF"><B>D00 Owner</B><BR/>bounded evidence-only change</TD>
                      <TD BGCOLOR="#FFF3C7"><B>D01 Human gate</B><BR/>exact package + safety limits</TD>
                      <TD BGCOLOR="#EAF2FF"><B>D02 evidence</B><BR/>只回 R00</TD>
                    </TR>
                    <TR>
                      <TD COLSPAN="4" BGCOLOR="#FDECEC" COLOR="#B43A3A" ALIGN="LEFT">
                        Continuous safe exit；NO RELEASE PASS。Observation expiry 无需新人工决策，自动启动预授权 safe exit；
                        无法证明安全则 incident/environment block 保持或开启，并进入 R09。
                      </TD>
                    </TR>
                  </TABLE>
                </TD>

                <TD VALIGN="TOP">
                  <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"
                         COLOR="#B43A3A" BGCOLOR="#FFFFFF" WIDTH="675">
                    <TR>
                      <TD COLSPAN="4" BGCOLOR="#FDECEC" ALIGN="LEFT">
                        <FONT POINT-SIZE="14"><B>3B · INCIDENT REMEDIATION · IR00–IR03</B></FONT>
                      </TD>
                    </TR>
                    <TR>
                      <TD BGCOLOR="#FDECEC"><B>IR00</B><BR/>先开 / 保留 Case + environment block</TD>
                      <TD BGCOLOR="#FFF3C7"><B>IR01</B><BR/>Human 接受 bounded route 并调用 exact Owner</TD>
                      <TD BGCOLOR="#EAF2FF"><B>IR02</B><BR/>按 affected gates 修复</TD>
                      <TD BGCOLOR="#EAF2FF"><B>IR03</B><BR/>独立验证安全，Human resolve</TD>
                    </TR>
                    <TR>
                      <TD COLSPAN="4" BGCOLOR="#FFF9E8" COLOR="#A66A00" ALIGN="LEFT">
                        Product outcome 与 Incident Case 正交：product closeout 不关 incident；
                        incident evidence 不扩产品价值、不弱化 Baseline、不复活终态、不进入 BA / R10。
                      </TD>
                    </TR>
                  </TABLE>
                </TD>
              </TR>
            </TABLE>
          </TD>
        </TR>

        <TR>
          <TD>
            <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10"
                   COLOR="#8FA6C2" BGCOLOR="#FFFFFF" WIDTH="1380">
              <TR>
                <TD COLSPAN="6" BGCOLOR="#DDE9F8" ALIGN="LEFT">
                  <FONT POINT-SIZE="14"><B>4 · REAL COMPLETION · 部署成功不是产品成功</B></FONT>
                </TD>
              </TR>
              <TR>
                <TD BGCOLOR="#F4EEFC"><B>PRODUCT</B><BR/>Production Verification</TD>
                <TD BGCOLOR="#FFF3C7" COLOR="#A66A00"><B>[H]</B><BR/>Business Acceptance</TD>
                <TD BGCOLOR="#EAF2FF"><B>[AO]</B><BR/>Product Director recommendation</TD>
                <TD BGCOLOR="#FFF3C7" COLOR="#A66A00"><B>[H]</B><BR/>Disposition Decision</TD>
                <TD BGCOLOR="#FFF9E8"><B>Phase Outcome</B><BR/>success / pause / rework / terminate</TD>
                <TD BGCOLOR="#FFF9E8"><B>Demand Outcome</B><BR/>complete / defer / terminate / continue</TD>
              </TR>
              <TR>
                <TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#EAF2FF">
                  <B>F16 · NEW PHASE</B>：旧 Phase 必须 already successfully closed / terminated；
                  Demand nonterminal；无 F17 或 competing Phase authority。
                </TD>
                <TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#FFF9E8">
                  <B>F17 · SAME PHASE RESUME</B>：旧 Phase paused / awaiting rework；
                  Baseline 不变；无 F16 / new-Phase authority；affected gates 重跑。
                </TD>
              </TR>
              <TR>
                <TD COLSPAN="6" BGCOLOR="#FDECEC" COLOR="#B43A3A" ALIGN="LEFT">
                  Successfully closed / terminated Phase 与 completed / terminated Demand 都 authority-absorbing。
                  RT 永远 non-success；只有 R10 可推荐成功；任何 open Incident Case 都不会被 disposition 顺手关闭。
                </TD>
              </TR>
            </TABLE>
          </TD>
        </TR>

        <TR>
          <TD>
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"
                   COLOR="#A66A00" BGCOLOR="#FFF9E8" WIDTH="1380">
              <TR>
                <TD ALIGN="LEFT" COLOR="#A66A00">
                  <B>M0 SAFETY PROPERTIES</B>：
                  ACCEPT ≠ INVOKE ≠ start ≠ action ≠ outcome；
                  每个 environment action 只有一个 identity、authorization 至多消费一次、至多一个 effective side effect 与一个 trustworthy terminal outcome；
                  duplicate 只能 reconcile 同一 action，新 side effect 必须 fresh authority。<BR ALIGN="LEFT"/>
                  Failed / partial / unknown action 一律阻断 QA、verification、acceptance 与 success；
                  failed production state 不得出现 incident block 与 safe containment 都不存在的空窗。
                </TD>
              </TR>
            </TABLE>
          </TD>
        </TR>
      </TABLE>
    >
  ];
}
