digraph FailureRoutingAndTerminalOutcomes {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    ordering=out,
    splines=ortho,
    outputorder=edgesfirst,
    bgcolor="#F7F9FC",
    pad="0.30",
    nodesep="0.30",
    ranksep="0.56",
    labelloc=t,
    labeljust=l,
    label="FAILURE ROUTING AND REAL COMPLETION\nTARGET ARCHITECTURE · V1.2 · VIEW R4\nM0 MANUAL CONTROL · NOT RUNTIME-ACTIVE",
    fontname="PingFang SC",
    fontsize=20,
    fontcolor="#152238"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#B8C2D1",
    fillcolor="#FFFFFF",
    fontname="PingFang SC",
    fontcolor="#152238",
    fontsize=11,
    margin="0.13,0.09",
    penwidth=1.2
  ];

  edge [
    fontname="PingFang SC",
    fontsize=9,
    fontcolor="#40536D",
    color="#66768D",
    arrowsize=0.72,
    penwidth=1.25
  ];

  subgraph cluster_diagnostic {
    label="01 DIAGNOSTIC · UNKNOWN CAUSE RETURNS TO R00";
    labelloc=t;
    labeljust=l;
    color="#B42318";
    fillcolor="#FDECEC";
    fontname="PingFang SC";
    fontcolor="#B42318";
    fontsize=14;
    penwidth=1.7;
    style="rounded,filled";
    margin=4;

    // Readability invariant: route, Owner, Human-gate, blocker, and outcome labels
    // override the canonical default individually so the 1705x1080 proof stays scannable.

    diagnostic_anchor [
      shape=point,
      // layout only
      style=invis,
      width=0,
      height=0,
      label=""
    ];

    r00 [
      label="[R00] DIAGNOSTIC\nUNKNOWN ROOT-CAUSE DOMAIN",
      shape=hexagon,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    diagnostic_owner [
      label="[AO] DIAGNOSTIC OWNER\npost-deploy intake: Quality Owner",
      color="#2459A9",
      fillcolor="#EAF2FF",
      fontcolor="#2459A9",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.5
    ];

    bounded_evidence [
      label="[ART][EVIDENCE ONLY]\nBOUNDED DIAGNOSIS → R00",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontcolor="#0F766E",
      fontsize=16,
      margin="0.08,0.05",
      penwidth=1.6
    ];

    diagnostic_block [
      label="[BLOCKED]\nNO CORRECTION · PASS\nRELEASE · CLOSEOUT",
      shape=octagon,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    d00 [
      label="[D00] CHANGED-ASSET OWNER\nbounded evidence-only change",
      color="#24466F",
      fillcolor="#EAF2FF",
      fontsize=18,
      margin="0.08,0.05",
      penwidth=1.5
    ];

    d01 [
      label="[H-GATE][D01]\nEXACT DIAG ACTION\nOBS/LIMITS · SAFE EXIT",
      tooltip="Diagnostic production action: exact package, observation window, safety limits, continuous safe exit",
      shape=diamond,
      color="#A16207",
      fillcolor="#FFF4D6",
      fontcolor="#A16207",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    d02 [
      label="[ART][D02] TRUSTWORTHY OBSERVATION\nRETURN ONLY TO R00",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontcolor="#0F766E",
      fontsize=16,
      margin="0.08,0.05",
      penwidth=1.7
    ];

    no_release_pass [
      label="[BLOCKED]\nNO RELEASE PASS\nEXPIRY → SAFE EXIT",
      shape=octagon,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    diagnostic_anchor -> r00 [
      // layout only
      style=invis,
      weight=40
    ];

    r00 -> diagnostic_owner [
      xlabel="diagnose",
      color="#B42318",
      style=dashed,
      penwidth=1.8
    ];

    diagnostic_owner -> bounded_evidence [
      color="#0F766E",
      penwidth=1.6
    ];

    bounded_evidence -> r00 [
      xlabel="return evidence",
      color="#B42318",
      style=dashed,
      penwidth=1.8,
      constraint=false
    ];

    r00 -> diagnostic_block [
      xlabel="blocked",
      arrowhead=tee,
      color="#B42318",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    r00 -> d00 [
      xlabel="production-only",
      color="#B42318",
      style=dashed,
      penwidth=1.8
    ];

    d00 -> d01 [
      xlabel="Human authorizes",
      color="#A16207",
      style=dashed,
      penwidth=1.9
    ];

    d01 -> d02 [
      color="#0F766E",
      penwidth=1.7
    ];

    d02 -> r00 [
      xlabel="return observation",
      color="#B42318",
      style=dashed,
      penwidth=1.8,
      constraint=false
    ];

    d01 -> no_release_pass [
      xlabel="no PASS",
      arrowhead=tee,
      color="#B42318",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    {
      rank=same;
      diagnostic_owner;
      d00;
    }

    {
      rank=same;
      bounded_evidence;
      d01;
      diagnostic_block;
    }

    {
      rank=same;
      d02;
      no_release_pass;
    }

    // Layout only: keep the R00 loop above the production-only branch.
    // layout only
    d00 -> diagnostic_owner [style=invis, weight=80];
    // layout only
    diagnostic_block -> d01 -> bounded_evidence [style=invis, weight=80];
    // layout only
    no_release_pass -> d02 [style=invis, weight=80];
  }

  subgraph cluster_corrective {
    label="02 CORRECTIVE · OWNER → INVALIDATE → MAP → RE-ENTER";
    labelloc=t;
    labeljust=l;
    color="#24466F";
