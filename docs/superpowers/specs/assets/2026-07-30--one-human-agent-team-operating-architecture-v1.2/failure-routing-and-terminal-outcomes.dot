    ];

    human_stop [
      label="[H]\nSTOP PRODUCT\nWORK",
      shape=diamond,
      color="#A16207",
      fillcolor="#FFF4D6",
      fontcolor="#A16207",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    rt [
      label="[RT]\nNON-SUCCESS\nSUCCESS PROHIBITED\nPRODUCT AUTHORITY\nREVOKED",
      shape=octagon,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.2
    ];

    pd_non_success_recommendation [
      label="[AO] PRODUCT DIRECTOR\nNON-SUCCESS RECOMMENDATION",
      color="#2459A9",
      fillcolor="#EAF2FF",
      fontcolor="#2459A9",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.6
    ];

    human_non_success_disposition [
      label="[H-GATE]\nNON-SUCCESS\nDISPOSITION",
      shape=diamond,
      color="#A16207",
      fillcolor="#FFF4D6",
      fontcolor="#A16207",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    non_success_outcomes [
      label="[STATE][PHASE NON-SUCCESS OUTCOME]\nHONESTLY TERMINATED\nAUTHORITY-ABSORBING",
      shape=note,
      style=filled,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    demand_terminal_outcomes [
      label="[STATE][DEMAND TERMINAL]\nCOMPLETE / TERMINATED\nNO F16 · NO F17",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontcolor="#0F766E",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.7
    ];

    demand_nonterminal_outcome [
      label="[STATE][DEMAND NONTERMINAL]\nCONTINUE / DEFERRED\nF16 ELIGIBLE ONLY",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontcolor="#0F766E",
      fontsize=18,
      margin="0.08,0.05",
      penwidth=1.8
    ];

    human_next_phase_authority [
      label="[H-GATE][F16]\nFRESH NEXT-PHASE\nAUTHORITY",
      shape=diamond,
      color="#A16207",
      fillcolor="#FFF4D6",
      fontcolor="#A16207",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    paused_rework_state [
      label="[H]\nDISPOSITION:\nPAUSED / AWAITING REWORK\nBASELINE UNCHANGED\nDEMAND NONTERMINAL",
      shape=note,
      style=filled,
      color="#A16207",
      fillcolor="#FFF4D6",
      fontcolor="#A16207",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    f16 [
      label="[F16] NEW PHASE\n→ PRODUCT DIRECTOR\nPRIOR PHASE AUTHORITY-ABSORBING\nNO F17 / COMPETING AUTHORITY",
      color="#24466F",
      fillcolor="#EAF2FF",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.7
    ];

    f17 [
      label="[F17] SAME PHASE RESUME\nPAUSED / REWORK · SAFE · ONE ROUTE\nNO F16 / NEW-PHASE AUTHORITY",
      color="#24466F",
      fillcolor="#EAF2FF",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.7
    ];

    f17_target [
      label="[AO] EARLIEST VALID OWNER\nSAME PHASE · AFFECTED GATES",
      color="#2459A9",
      fillcolor="#EAF2FF",
      fontcolor="#2459A9",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.5
    ];

    incident_closure_block [
      label="[BLOCKED]\nPRODUCT CLOSEOUT ≠\nINCIDENT RESOLUTION",
      shape=octagon,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=2.0
    ];

    completion_anchor -> production_evidence [
      // layout only
      style=invis,
      weight=40
    ];

    production_evidence -> business_acceptance [
      xlabel="Human decision",
      color="#A16207",
      style=dashed,
      penwidth=1.9
    ];

    business_acceptance -> accepted_product_result [
      color="#0F766E",
      penwidth=1.9
    ];

    accepted_product_result -> r10 [
      color="#0F766E",
      penwidth=2.0
    ];

    business_acceptance -> business_nonaccepted [
      xlabel="reject / stale / unsafe",
      color="#B42318",
      style=dashed,
      penwidth=2.0
    ];

    business_nonaccepted -> r09 [
      xlabel="return to R09",
      color="#B42318",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    r10 -> pd_success_recommendation [
      color="#0F766E",
      penwidth=2.0
    ];

    pd_success_recommendation -> human_success_disposition [
      xlabel="Human disposition",
      color="#A16207",
      style=dashed,
      penwidth=1.9
    ];

    human_success_disposition -> success_outcomes [
      color="#0F766E",
      penwidth=1.9
    ];

    human_stop -> rt [
      xlabel="stop authority",
      color="#B42318",
      style=dashed,
      penwidth=2.0
    ];

    rt -> pd_non_success_recommendation [
      xlabel="non-success route",
      color="#B42318",
      style=dashed,
      penwidth=2.0
    ];

    pd_non_success_recommendation -> human_non_success_disposition [
      xlabel="Human disposition",
      color="#A16207",
      style=dashed,
      penwidth=1.9
    ];

    human_non_success_disposition -> non_success_outcomes [
      color="#B42318",
      penwidth=2.0
    ];

    success_outcomes -> demand_terminal_outcomes [
      color="#66768D",
      penwidth=1.6
    ];

    non_success_outcomes -> demand_terminal_outcomes [
      color="#66768D",
      penwidth=1.6
    ];

    success_outcomes -> demand_nonterminal_outcome [
      color="#0F766E",
      penwidth=1.8
    ];

    non_success_outcomes -> demand_nonterminal_outcome [
      color="#0F766E",
      penwidth=1.8
    ];

    demand_nonterminal_outcome -> human_next_phase_authority [
      xlabel="fresh phase authority",
      color="#A16207",
      style=dashed,
      penwidth=1.8
    ];

    human_next_phase_authority -> f16 [
      xlabel="invoke new Phase",
      color="#A16207",
      style=dashed,
      penwidth=1.8
    ];

    paused_rework_state -> f17 [
      xlabel="resume authority",
      color="#A16207",
      style=dashed,
      penwidth=1.8
    ];

    f17 -> f17_target [
      color="#24466F",
      penwidth=1.6
    ];

    f16 -> f17 [
      xlabel="mutually exclusive",
      dir=both,
      arrowhead=tee,
      arrowtail=tee,
      color="#B42318",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    human_success_disposition -> incident_closure_block [
      xlabel="does not close incident",
      arrowhead=tee,
      color="#B42318",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    human_non_success_disposition -> incident_closure_block [
      xlabel="does not close incident",
      arrowhead=tee,
      color="#B42318",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    {
      rank=same;
      demand_nonterminal_outcome;
      human_next_phase_authority;
      f16;
      f17;
      f17_target;
    }

    // Layout only: stack mutually exclusive continuation routes.
    f17_target -> f17 -> f16 ->
      human_next_phase_authority -> demand_nonterminal_outcome
      // layout only
      [style=invis, weight=100];

  }

  {
    rank=same;
    diagnostic_anchor;
    corrective_anchor;
    authority_anchor;
    completion_anchor;
  }

  lane_order_seed [
    shape=point,
    // layout only
    style=invis,
    width=0,
    height=0,
    label=""
  ];

  // Layout only: one ordered fan-out fixes the swimlanes top-to-bottom.
  // layout only
  lane_order_seed -> diagnostic_anchor [style=invis, weight=100];
  // layout only
  lane_order_seed -> corrective_anchor [style=invis, weight=100];
  // layout only
  lane_order_seed -> authority_anchor [style=invis, weight=100];
  // layout only
  lane_order_seed -> completion_anchor [style=invis, weight=100];
}
