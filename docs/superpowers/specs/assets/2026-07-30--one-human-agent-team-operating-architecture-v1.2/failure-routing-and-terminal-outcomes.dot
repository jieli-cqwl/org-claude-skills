digraph FailureRoutingAndTerminalOutcomes {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    ordering=out,
    splines=ortho,
    outputorder=edgesfirst,
    bgcolor="#F6F8FB",
    pad="0.10",
    nodesep="0.04",
    ranksep="0.14",
    labelloc=t,
    labeljust=l,
    label="FAILURE ROUTING AND REAL COMPLETION\nTARGET ARCHITECTURE · V1.2 · VIEW R4\nM0 MANUAL CONTROL · NOT RUNTIME-ACTIVE",
    fontname="Helvetica-Bold",
    fontsize=20,
    fontcolor="#132A44"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#7890AA",
    fillcolor="#FFFFFF",
    fontname="Helvetica-Bold",
    fontcolor="#132A44",
    fontsize=13,
    margin="0.07,0.05",
    penwidth=1.2
  ];

  edge [
    color="#64748B",
    arrowsize=0.70,
    penwidth=1.3
  ];

  subgraph cluster_diagnostic {
    label="01 DIAGNOSTIC · UNKNOWN CAUSE RETURNS TO R00";
    labelloc=t;
    labeljust=l;
    color="#B23A48";
    fillcolor="#FFF7F8";
    fontname="Helvetica-Bold";
    fontcolor="#8F2635";
    fontsize=14;
    penwidth=1.7;
    style="rounded,filled";
    margin=4;

    diagnostic_anchor [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];

    r00 [
      label="[R00] DIAGNOSTIC\nUNKNOWN ROOT-CAUSE DOMAIN",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=2.0
    ];

    diagnostic_owner [
      label="[AO] DIAGNOSTIC OWNER\npost-deploy intake: Quality Owner",
      color="#2F6DB0",
      fillcolor="#EEF4FA",
      penwidth=1.5
    ];

    bounded_evidence [
      label="[EVIDENCE ONLY]\nBOUNDED DIAGNOSIS → R00",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      penwidth=1.6
    ];

    diagnostic_block [
      label="[BLOCKED]\nNO CORRECTION · PASS\nRELEASE · CLOSEOUT",
      shape=octagon,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      penwidth=2.0
    ];

    d00 [
      label="[D00] CHANGED-ASSET OWNER\nbounded evidence-only change",
      color="#2F6DB0",
      fillcolor="#EEF4FA",
      penwidth=1.5
    ];

    d01 [
      label="[H-GATE][D01]\nEXACT DIAG ACTION\nOBS/LIMITS · SAFE EXIT",
      tooltip="Diagnostic production action: exact package, observation window, safety limits, continuous safe exit",
      shape=diamond,
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontcolor="#7A4B00",
      penwidth=2.0
    ];

    d02 [
      label="[D02] TRUSTWORTHY OBSERVATION\nRETURN ONLY TO R00",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      penwidth=1.7
    ];

    no_release_pass [
      label="[BLOCKED]\nNO RELEASE PASS\nEXPIRY → SAFE EXIT",
      shape=octagon,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      penwidth=2.0
    ];

    diagnostic_anchor -> r00 [
      style=invis,
      weight=40
    ];

    r00 -> diagnostic_owner [
      color="#B23A48",
      style=dashed,
      penwidth=1.8
    ];

    diagnostic_owner -> bounded_evidence [
      color="#177E89",
      penwidth=1.6
    ];

    bounded_evidence -> r00 [
      color="#B23A48",
      style=dashed,
      penwidth=1.8,
      constraint=false
    ];

    r00 -> diagnostic_block [
      arrowhead=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    r00 -> d00 [
      color="#B23A48",
      style=dashed,
      penwidth=1.8
    ];

    d00 -> d01 [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    d01 -> d02 [
      color="#177E89",
      penwidth=1.7
    ];

    d02 -> r00 [
      color="#B23A48",
      style=dashed,
      penwidth=1.8,
      constraint=false
    ];

    d01 -> no_release_pass [
      arrowhead=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    {
      rank=same;
      diagnostic_owner;
      d00;
    }

    {
      rank=same;
      bounded_evidence;
      d01;
      diagnostic_block;
    }

    {
      rank=same;
      d02;
      no_release_pass;
    }

    // Layout only: keep the R00 loop above the production-only branch.
    d00 -> diagnostic_owner [style=invis, weight=80];
    diagnostic_block -> d01 -> bounded_evidence [style=invis, weight=80];
    no_release_pass -> d02 [style=invis, weight=80];
  }

  subgraph cluster_corrective {
    label="02 CORRECTIVE · OWNER → INVALIDATE → MAP → RE-ENTER";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=14;
    penwidth=1.7;
    style="rounded,filled";
    margin=4;

    corrective_anchor [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];

    r01 [
      label="[R01] → PRODUCT DIRECTOR\nWHY · VALUE · PHASE",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=1.8
    ];

    r02 [
      label="[R02] → PRODUCT MANAGER\nBEHAVIOR · RULE · STATE\nPERMISSION\nPRODUCT UNIT · AC",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=1.8
    ];

    r03 [
      label="[R03] → IMPACT OWNER\nSURFACES · CONSUMERS\nPRESERVED BEHAVIOR\nEXCLUSIONS",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=1.8
    ];

    r04 [
      label="[R04][CONDITIONAL]\n→ UX OWNER\nJOURNEY · INTERACTION",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=1.8
    ];

    r05 [
      label="[R05][CONDITIONAL]\n→ ARCHITECTURE OWNER\nINTERFACE · DATA · MIGRATION\nROLLBACK · ARCH DECISION",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=1.8
    ];

    r06 [
      label="[R06] → TEST DESIGN OWNER\nPROOF · COVERAGE\nQA CONTRACT",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=1.8
    ];

    r07 [
      label="[R07] → DEVELOPMENT OWNER\nIMPLEMENTATION\nMANIFEST",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=1.8
    ];

    affected_invalidation [
      label="[INVALIDATE]\nAFFECTED EVIDENCE / AUTHORITY\nSTALE OR REVOKED · HISTORY KEPT",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      penwidth=1.9
    ];

    obligation_mapping [
      label="[POST-BASELINE]\nMAP EVERY OLD OBLIGATION\nNO WEAKENING IN SAME PHASE",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFFFFF",
      fontcolor="#8F2635",
      penwidth=1.8
    ];

    affected_gates [
      label="[RE-ENTER EVERY AFFECTED GATE]\nIDENTITY → REVIEW → VERIFY\nDEPLOY → QA → RELEASE",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      penwidth=1.7
    ];

    corrective_anchor -> r01 [
      style=invis,
      weight=40
    ];

    r01 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r02 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r03 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r04 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r05 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r06 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r07 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    affected_invalidation -> obligation_mapping [
      color="#B23A48",
      style=dashed,
      penwidth=1.9
    ];

    obligation_mapping -> affected_gates [
      color="#B23A48",
      style=dashed,
      penwidth=1.9
    ];

    {
      rank=same;
      r04;
      r03;
      r02;
      r01;
    }

    {
      rank=same;
      r07;
      r06;
      r05;
    }

    // Layout only: two compact route columns retain numeric order.
    r04 -> r03 -> r02 -> r01 [style=invis, weight=100];
    r07 -> r06 -> r05 [style=invis, weight=100];
    r01 -> r05 [style=invis, weight=100];
  }

  subgraph cluster_authority_incident {
    label="03 AUTHORITY & INCIDENT · RECONCILE; CONTAIN; PROVE SAFETY";
    labelloc=t;
    labeljust=l;
    color="#B23A48";
    fillcolor="#FFF7F8";
    fontname="Helvetica-Bold";
    fontcolor="#8F2635";
    fontsize=14;
    penwidth=1.7;
    style="rounded,filled";
    margin=4;

    authority_anchor [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];

    r08 [
      label="[R08] AUTHORITY\nENV · PERMISSION\nDEPENDENCY · PRECONDITION\nACTION",
      shape=hexagon,
      color="#B7791F",
      fillcolor="#FFF8E7",
      fontcolor="#7A4B00",
      penwidth=1.9
    ];

    human_reconcile [
      label="[H] RECONCILE\nCURRENT STATE\nACTION",
      shape=diamond,
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontcolor="#7A4B00",
      penwidth=2.0
    ];

    r08_ready [
      label="[R08 STATE]\nTRUSTWORTHY CURRENT\nENV / PERMISSION / ACTION",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      penwidth=1.7
    ];

    r08_fresh_action_authority [
      label="[H-GATE]\nFRESH ACTION AUTHORITY",
      tooltip="Fresh Human authority is current for the exact reconciled action identity",
      shape=diamond,
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontcolor="#7A4B00",
      penwidth=2.0
    ];

    r08_action_resume [
      label="[NAMED ACTION RESUME]\nOWNER · REQUIRED GATES\nINVOKE ≠ ACTUAL START ≠ OUTCOME",
      color="#2F6DB0",
      fillcolor="#EEF4FA",
      penwidth=1.6
    ];

    r09 [
      label="[R09] AUTHORITY\nPROD / DIAGNOSTIC\nROLLBACK / CONTAINMENT\nVERIFICATION / BA\nNOT TRUSTWORTHY",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      penwidth=2.1
    ];

    r09_block [
      label="[BLOCKED]\nNO ACCEPTANCE · R10\nSUCCESS",
      shape=octagon,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      penwidth=2.1
    ];

    human_containment [
      label="[H] CONTAIN\nTRUSTWORTHY\nSAFE OUTCOME",
      shape=diamond,
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontcolor="#7A4B00",
      penwidth=2.0
    ];

    ir00 [
      label="[IR00] EXACT INCIDENT CASE\n+ ENVIRONMENT BLOCK\nPRODUCT CLOSEOUT CANNOT CLOSE",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      penwidth=2.0
    ];

    ir01 [
      label="[H][IR01]\nBOUNDED INCIDENT\nROUTE · IR AUTHORITY",
      tooltip="Human accepts one bounded incident route and invokes the exact Owner under INCIDENT_REMEDIATION authority",
      shape=diamond,
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontcolor="#7A4B00",
      penwidth=2.0
    ];

    ir02 [
      label="[IR02] NORMAL ROLE BOUNDARIES\nEVERY AFFECTED REMEDIATION GATE",
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      penwidth=1.9
    ];

    ir03 [
      label="[IR03] INDEPENDENT SAFETY PROOF\nSAFE ENV · NO MUTATION\nRECOVERY PROVEN · HUMAN RESOLVES CASE\nNO PRODUCT-SUCCESS AUTHORITY",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFFFFF",
      fontcolor="#8F2635",
      penwidth=2.0
    ];

    r09_exit [
      label="[R09 EXIT]\nSAFE · INCIDENT RESOLVED\nMUTATION SETTLED\nONE NON-DIAGNOSTIC ROUTE",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      penwidth=1.7
    ];

    fresh_resume_authority [
      label="[H-GATE]\nFRESH RESUME\nAUTHORITY",
      shape=diamond,
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontcolor="#7A4B00",
      penwidth=2.0
    ];

    r09_resume [
      label="[NON-DIAGNOSTIC ROUTE]\nNAMED OWNER · AFFECTED GATES",
      color="#2F6DB0",
      fillcolor="#EEF4FA",
      penwidth=1.6
    ];

    authority_anchor -> r08 [
      style=invis,
      weight=40
    ];

    r08 -> human_reconcile [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    human_reconcile -> r08_ready [
      color="#177E89",
      penwidth=1.7
    ];

    r08_ready -> r08_fresh_action_authority [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    r08_fresh_action_authority -> r08_action_resume [
      color="#2F6DB0",
      penwidth=1.7
    ];

    r09 -> r09_block [
      color="#B23A48",
      penwidth=2.0
    ];

    r09_block -> human_containment [
      color="#B23A48",
      style=dashed,
      penwidth=1.9
    ];

    human_containment -> ir00 [
      color="#B23A48",
      penwidth=2.0
    ];

    ir00 -> ir01 [
      color="#B23A48",
      penwidth=2.0
    ];

    ir01 -> ir02 [
      color="#B23A48",
      style=dashed,
      penwidth=1.9
    ];

    ir02 -> ir03 [
      color="#B23A48",
      penwidth=2.0
    ];

    ir03 -> r09_exit [
      color="#177E89",
      penwidth=1.7
    ];

    r09_exit -> fresh_resume_authority [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    fresh_resume_authority -> r09_resume [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    {
      rank=same;
      r08;
      r09;
    }

    {
      rank=same;
      human_reconcile;
      r09_block;
    }

    {
      rank=same;
      r08_ready;
      human_containment;
    }

    {
      rank=same;
      r08_fresh_action_authority;
      ir00;
      ir01;
    }

    {
      rank=same;
      r08_action_resume;
      ir02;
      ir03;
      r09_exit;
    }

    {
      rank=same;
      fresh_resume_authority;
      r09_resume;
    }

    // Layout only: R08 stays above independent R09 incident work.
    r09 -> r08 [style=invis, weight=100];
    r09_block -> human_reconcile [style=invis, weight=100];
    human_containment -> r08_ready [style=invis, weight=100];
    r08_fresh_action_authority -> ir01 -> ir00 [style=invis, weight=100];
    r08_action_resume -> r09_exit -> ir03 -> ir02 [style=invis, weight=100];
    r09_resume -> fresh_resume_authority [style=invis, weight=100];
  }

  subgraph cluster_real_completion {
    label="04 REAL COMPLETION · ACCEPTED SUCCESS AND RT NON-SUCCESS NEVER MERGE";
    labelloc=t;
    labeljust=l;
    color="#177E89";
    fillcolor="#F4FBFA";
    fontname="Helvetica-Bold";
    fontcolor="#0F6269";
    fontsize=14;
    penwidth=1.7;
    style="rounded,filled";
    margin=4;

    completion_anchor [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];

    production_evidence [
      label="[PRODUCT EVIDENCE]\nTRUSTWORTHY · CURRENT\nEXACT IDENTITY · BASELINE PASS\nNO OPEN CASE / ACTION",
