    fontname="Helvetica-Bold";
    fontcolor="#8F2635";
    fontsize=15;
    penwidth=1.8;
    style="rounded,filled";
    margin=16;

    authority_anchor [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
