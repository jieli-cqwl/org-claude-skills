    r09_exit [
      label="[R09 EXIT PREREQUISITES]\nSAFE STATE · INCIDENT RESOLVED\nNO UNRESOLVED MUTATION\nONE CURRENT NON-DIAGNOSTIC ROUTE",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.7
    ];

    fresh_resume_authority [
      label="[H-GATE]\nFRESH RESUME AUTHORITY\nrevalidate Case · route · target · environment",
