      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      penwidth=2.2
    ];

    pd_non_success_recommendation [
      label="[AO] PRODUCT DIRECTOR\nNON-SUCCESS RECOMMENDATION",
