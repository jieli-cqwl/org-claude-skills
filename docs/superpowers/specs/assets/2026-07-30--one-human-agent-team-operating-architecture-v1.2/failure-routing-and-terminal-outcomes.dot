digraph FailureRoutingAndTerminalOutcomes {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    ordering=out,
    splines=ortho,
    outputorder=edgesfirst,
    bgcolor="#F6F8FB",
    pad="0.22",
    nodesep="0.25",
    ranksep="0.42",
    labelloc=t,
    labeljust=l,
    label="FAILURE ROUTING AND REAL COMPLETION\nTARGET OPERATING ARCHITECTURE · V1.2 · VIEW R4\nM0 MANUAL CONTROL · Deterministic return · Independent incident closure\nTARGET DESIGN · NOT RUNTIME-ACTIVE",
    fontname="Helvetica-Bold",
    fontsize=22,
    fontcolor="#132A44"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#7890AA",
    fillcolor="#FFFFFF",
    fontname="Helvetica",
    fontcolor="#132A44",
    fontsize=11.5,
    margin="0.11,0.08",
    penwidth=1.2
  ];

  edge [
    color="#64748B",
    fontname="Helvetica-Bold",
    fontcolor="#334155",
    fontsize=10.5,
    arrowsize=0.75,
    penwidth=1.3
  ];

  subgraph cluster_diagnostic {
    label="01 DIAGNOSTIC · UNKNOWN CAUSE PRODUCES EVIDENCE, NEVER CORRECTION OR SUCCESS";
    labelloc=t;
    labeljust=l;
    color="#B23A48";
    fillcolor="#FFF7F8";
    fontname="Helvetica-Bold";
    fontcolor="#8F2635";
    fontsize=15;
    penwidth=1.8;
    style="rounded,filled";
    margin=16;

    diagnostic_anchor [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];

    r00 [
      label="[R00][DIAGNOSTIC]\nUNKNOWN ROOT-CAUSE DOMAIN\nfailure is real · domain unresolved",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    diagnostic_owner [
      label="[AO][DIAGNOSTIC]\nONE NAMED OWNER\npost-deployment intake: Quality Owner",
      color="#2F6DB0",
      fillcolor="#EEF4FA",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    bounded_evidence [
      label="[EVIDENCE ONLY]\nBOUNDED DIAGNOSIS\nclassifies root-cause domain only",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.6
    ];

    diagnostic_block [
      label="[BLOCKED]\nNO CORRECTION · PASS · RELEASE\nBUSINESS ACCEPTANCE · R10 · CLOSEOUT",
      shape=octagon,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=2.1
    ];

    d00 [
      label="[D00][AO]\nROUTE-NAMED CHANGED-ASSET OWNER\nbounded evidence-only change",
      color="#2F6DB0",
      fillcolor="#EEF4FA",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    d01 [
      label="[H-GATE][D01]\nDIAGNOSTIC PRODUCTION ACTION\nexact package · observation window\nsafety limits · continuous safe exit",
      shape=diamond,
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontcolor="#7A4B00",
      fontname="Helvetica-Bold",
      fontsize=10.5,
      penwidth=2.0
    ];

    d02 [
      label="[D02][EVIDENCE]\nTRUSTWORTHY COMPLETE OUTCOME\n+ bounded observations\nRETURN ONLY TO R00",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.7
    ];

    no_release_pass [
      label="[BLOCKED][PRODUCTION DIAGNOSTIC]\nNO RELEASE PASS\nexpiry initiates pre-authorized safe exit",
      shape=octagon,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    diagnostic_anchor -> r00 [
      style=invis,
      weight=40
    ];

    r00 -> diagnostic_owner [
      color="#B23A48",
      style=dashed,
      penwidth=1.8
    ];

    diagnostic_owner -> bounded_evidence [
      color="#177E89",
      penwidth=1.6
    ];

    bounded_evidence -> r00 [
      color="#B23A48",
      style=dashed,
      penwidth=1.8,
      constraint=false
    ];

    r00 -> diagnostic_block [
      arrowhead=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    r00 -> d00 [
      color="#B23A48",
      style=dashed,
      penwidth=1.8
    ];

    d00 -> d01 [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    d01 -> d02 [
      color="#177E89",
      penwidth=1.7
    ];

    d02 -> r00 [
      color="#B23A48",
      style=dashed,
      penwidth=1.8,
      constraint=false
    ];

    d01 -> no_release_pass [
      arrowhead=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    {
      rank=same;
      d00;
      diagnostic_owner;
    }

    {
      rank=same;
      diagnostic_block;
      d01;
      bounded_evidence;
    }

    {
      rank=same;
      no_release_pass;
      d02;
    }

    // Layout only: keep the ordinary R00 loop above the production-only branch.
    d00 -> diagnostic_owner [
      style=invis,
      weight=80
    ];

    diagnostic_block -> d01 -> bounded_evidence [
      style=invis,
      weight=80
    ];

    no_release_pass -> d02 [
      style=invis,
      weight=80
    ];
  }

  subgraph cluster_corrective {
    label="02 CORRECTIVE · ROUTE TO THE EARLIEST WRONG OWNER, INVALIDATE, MAP, AND RE-ENTER";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=15;
    penwidth=1.8;
    style="rounded,filled";
    margin=16;

    corrective_anchor [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];

    r01 [
      label="[R01][CORRECTIVE]\n→ [AO] PRODUCT DIRECTOR\nactor · real problem · value\nor Active Phase is wrong",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    r02 [
      label="[R02][CORRECTIVE]\n→ [AO] PRODUCT MANAGER\nbehavior · rule · state · permission\nProduct Unit or AC is wrong",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    r03 [
      label="[R03][CORRECTIVE]\n→ [AO] IMPACT OWNER\naffected surface · consumer · preserved behavior\nor evidence exclusion is incomplete",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    r04 [
      label="[R04][CORRECTIVE]\n→ [AO][CONDITIONAL] UX OWNER\njourney or interaction evidence\nis wrong or missing",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    r05 [
      label="[R05][CORRECTIVE]\n→ [AO][CONDITIONAL] ARCHITECTURE OWNER\ninterface · data · migration · rollback\nor architecture decision is wrong",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    r06 [
      label="[R06][CORRECTIVE]\n→ [AO] TEST DESIGN OWNER\nproof obligation · coverage\nor QA contract is wrong",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    r07 [
      label="[R07][CORRECTIVE]\n→ [AO] DEVELOPMENT OWNER\nexpected behavior is clear;\nimplementation or Manifest is wrong",
      shape=hexagon,
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    affected_invalidation [
      label="[INVALIDATE][HISTORY PRESERVED]\nAFFECTED packages · qualifications · evidence\nand authority become STALE / REVOKED",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=1.9
    ];

    obligation_mapping [
      label="[POST-BASELINE LAW]\nMAP EVERY OLD OBLIGATION TO THE NEW REVISION\nsame Phase may preserve / strengthen only\nweakened denominator → honest non-success + NEW PHASE",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFFFFF",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      fontsize=10.5,
      penwidth=1.8
    ];

    affected_gates [
      label="[RE-ENTRY]\nRERUN EVERY AFFECTED GATE\nidentity · review · verify · deploy · QA · release",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.7
    ];

    fresh_corrective_evidence [
      label="[CURRENT EVIDENCE]\nFRESH PROOF FOR THE CHANGED IDENTITY\nfailure history remains",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      penwidth=1.6
    ];

    corrective_anchor -> r01 [
      style=invis,
      weight=40
    ];

    r01 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r02 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r03 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r04 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r05 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r06 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    r07 -> affected_invalidation [
      color="#B23A48",
      style=dashed,
      penwidth=1.7
    ];

    affected_invalidation -> obligation_mapping [
      color="#B23A48",
      style=dashed,
      penwidth=1.9
    ];

    obligation_mapping -> affected_gates [
      color="#B23A48",
      style=dashed,
      penwidth=1.9
    ];

    affected_gates -> fresh_corrective_evidence [
      color="#177E89",
      penwidth=1.7
    ];

    {
      rank=same;
      r04;
      r03;
      r02;
      r01;
    }

    {
      rank=same;
      r07;
      r06;
      r05;
    }

    // Layout only: keep the two corrective route columns in numeric order.
    r04 -> r03 -> r02 -> r01 [
      style=invis,
      weight=100
    ];

    r07 -> r06 -> r05 [
      style=invis,
      weight=100
    ];

    r01 -> r05 [
      style=invis,
      weight=100
    ];
  }

  subgraph cluster_authority_incident {
    label="03 AUTHORITY & INCIDENT · RECONCILE ACTIONS; CONTAIN AND CLOSE SAFETY INDEPENDENTLY";
    labelloc=t;
    labeljust=l;
    color="#B23A48";
