    ];

    phase_demand_outcomes [
      label="[STATE]\nSEPARATE PHASE + DEMAND OUTCOMES\nPhase: success · pause · rework · terminate\nDemand: complete · defer · terminate · continue",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      fontsize=10.5,
      penwidth=1.7
    ];

    incident_closure_block [
      label="[BLOCKED]\nPRODUCT CLOSEOUT ≠ INCIDENT RESOLUTION\nopen Cases continue independently through IR00–IR03",
      shape=octagon,
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontcolor="#8F2635",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    completion_anchor -> production_evidence [
      style=invis,
      weight=40
    ];

    production_evidence -> business_acceptance [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    business_acceptance -> r10 [
      color="#177E89",
      penwidth=1.9
    ];

    r10 -> product_director_recommendation [
      color="#177E89",
      penwidth=2.0
    ];

    human_stop -> rt [
      color="#B23A48",
      style=dashed,
      penwidth=1.9
    ];

    rt -> product_director_recommendation [
      color="#B23A48",
      style=dashed,
      penwidth=2.0
    ];

    product_director_recommendation -> human_disposition [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    human_disposition -> f16 [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    human_disposition -> f17 [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    human_disposition -> no_next_authority [
      color="#64748B",
      style=dashed,
      penwidth=1.6
    ];

    f16 -> f16_target [
      color="#2F6DB0",
      penwidth=1.6
    ];

    f17 -> f17_target [
      color="#2F6DB0",
      penwidth=1.6
    ];

    no_next_authority -> phase_demand_outcomes [
      color="#177E89",
      penwidth=1.6
    ];

    f16 -> f17 [
      dir=both,
      arrowhead=tee,
      arrowtail=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    human_disposition -> phase_demand_outcomes [
      color="#B7791F",
      style=dashed,
      penwidth=1.7,
      constraint=false
    ];

    human_disposition -> incident_closure_block [
      arrowhead=tee,
      color="#B23A48",
      style=dashed,
      penwidth=2.0,
      constraint=false
    ];

    {
      rank=same;
      human_stop;
      business_acceptance;
    }

    {
      rank=same;
      rt;
      r10;
    }

    {
      rank=same;
      no_next_authority;
      f17;
      f16;
      human_disposition;
      incident_closure_block;
    }

    {
      rank=same;
      phase_demand_outcomes;
      f17_target;
      f16_target;
    }

    // Layout only: success and RT remain parallel, never a merged terminal route.
    human_stop -> business_acceptance [
      style=invis,
      weight=100
    ];

    rt -> r10 [
      style=invis,
      weight=100
    ];
  }

  {
    rank=same;
    diagnostic_anchor;
    corrective_anchor;
    authority_anchor;
    completion_anchor;
  }

  lane_order_seed [
    shape=point,
    style=invis,
    width=0,
    height=0,
    label=""
  ];

  // Layout only: one ordered fan-out fixes the four swimlanes top-to-bottom.
  lane_order_seed -> diagnostic_anchor [style=invis, weight=100];
  lane_order_seed -> corrective_anchor [style=invis, weight=100];
  lane_order_seed -> authority_anchor [style=invis, weight=100];
  lane_order_seed -> completion_anchor [style=invis, weight=100];
}
