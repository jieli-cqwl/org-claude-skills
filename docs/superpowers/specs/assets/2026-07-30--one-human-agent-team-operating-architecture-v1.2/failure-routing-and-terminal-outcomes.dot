      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.8
    ];

    r07 [
      label="[R07] → DEVELOPMENT OWNER\nIMPLEMENTATION\nMANIFEST",
      shape=hexagon,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.8
    ];

    affected_invalidation [
      label="[INVALIDATE]\nAFFECTED EVIDENCE / AUTHORITY\nSTALE OR REVOKED · HISTORY KEPT",
      shape=note,
      style=filled,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=20,
      margin="0.08,0.05",
      penwidth=1.9
    ];

    obligation_mapping [
      label="[POST-BASELINE]\nMAP EVERY OLD OBLIGATION\nNO WEAKENING IN SAME PHASE",
      shape=note,
      style=filled,
      color="#B42318",
      fillcolor="#FDECEC",
      fontcolor="#B42318",
      fontsize=18,
      margin="0.08,0.05",
      penwidth=1.8
    ];

    affected_gates [
      label="[ART][RE-ENTER EVERY AFFECTED GATE]\nIDENTITY → REVIEW → VERIFY\nDEPLOY → QA → RELEASE",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontcolor="#0F766E",
      fontsize=18,
      margin="0.08,0.05",
      penwidth=1.7
    ];

    corrective_anchor -> r01 [
      // layout only
      style=invis,
      weight=40
    ];

    r01 -> affected_invalidation [
      xlabel="invalidate",
      color="#B42318",
      style=dashed,
      penwidth=1.7
    ];

    r02 -> affected_invalidation [
      xlabel="invalidate",
      color="#B42318",
      style=dashed,
      penwidth=1.7
    ];

    r03 -> affected_invalidation [
      xlabel="invalidate",
      color="#B42318",
      style=dashed,
      penwidth=1.7
    ];

    r04 -> affected_invalidation [
      xlabel="invalidate",
      color="#B42318",
      style=dashed,
      penwidth=1.7
    ];

    r05 -> affected_invalidation [
      xlabel="invalidate",
      color="#B42318",
      style=dashed,
      penwidth=1.7
    ];

    r06 -> affected_invalidation [
      xlabel="invalidate",
      color="#B42318",
      style=dashed,
