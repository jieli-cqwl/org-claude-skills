      xlabel="invalidate",
      color="#B42318",
      style=dashed,
      penwidth=1.7
    ];

    affected_invalidation -> obligation_mapping [
      xlabel="map obligations",
      color="#B42318",
      style=dashed,
      penwidth=1.9
    ];

    obligation_mapping -> affected_gates [
      xlabel="rerun gates",
      color="#B42318",
      style=dashed,
      penwidth=1.9
    ];

    {
      rank=same;
      r04;
      r03;
      r02;
      r01;
    }

    {
      rank=same;
      r07;
      r06;
      r05;
    }

    // Layout only: two compact route columns retain numeric order.
    // layout only
    r04 -> r03 -> r02 -> r01 [style=invis, weight=100];
    // layout only
    r07 -> r06 -> r05 [style=invis, weight=100];
    // layout only
    r01 -> r05 [style=invis, weight=100];
  }

  subgraph cluster_authority_incident {
