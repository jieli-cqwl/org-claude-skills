digraph ArtifactsVersionsAndState {
  graph [
    bgcolor="#F8FAFD",
    pad="0.24",
    labelloc=t,
    label="ARTIFACTS, VERSIONS, AND STATE · TARGET V1.2\nSTAGE-OWNED PACKAGES · IMMUTABLE IDENTITIES · SEPARATE STATE DOMAINS\nM0 MANUAL HANDOFFS · NOT RUNTIME-ACTIVE",
    fontname="PingFang SC",
    fontsize=22,
    fontcolor="#172033"
  ];

  node [shape=plain, fontname="PingFang SC", fontcolor="#172033"];

  artifact_map [
    label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="14" CELLPADDING="0" BGCOLOR="#F8FAFD">
        <TR>
          <TD VALIGN="TOP">
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"
                   COLOR="#8FA6C2" BGCOLOR="#FFFFFF" WIDTH="620">
              <TR><TD BGCOLOR="#DDE9F8" ALIGN="LEFT"><FONT POINT-SIZE="14"><B>1 · OPERATING GRAIN</B></FONT></TD></TR>
              <TR>
                <TD ALIGN="LEFT">
                  <B>PRODUCT</B><BR ALIGN="LEFT"/>
                  Demand → Phase → Product Unit → Task → Candidate lineage<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>
                  <B>INCIDENT_REMEDIATION</B><BR ALIGN="LEFT"/>
                  Incident Case → bounded remediation work → Task → optional Candidate lineage
                </TD>
              </TR>
              <TR>
                <TD BGCOLOR="#F4EEFC" COLOR="#6F4BA5" ALIGN="LEFT">
                  Incident lineage 独立于 product outcome；<BR ALIGN="LEFT"/>
                  terminated product package 只作 provenance，不能授权 incident work；<BR ALIGN="LEFT"/>
                  incident evidence 永远不获得 product-success authority。
                </TD>
              </TR>
            </TABLE>
          </TD>

          <TD VALIGN="TOP">
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"
                   COLOR="#8FA6C2" BGCOLOR="#FFFFFF" WIDTH="700">
              <TR><TD BGCOLOR="#DDE9F8" ALIGN="LEFT"><FONT POINT-SIZE="14"><B>2 · STAGE PACKAGE REFERENCE CHAIN</B></FONT><BR ALIGN="LEFT"/>下游引用，不改写上游 bytes</TD></TR>
              <TR>
                <TD ALIGN="LEFT">
                  Director Decision → Product Definition → Impact discovery<BR ALIGN="LEFT"/>
                  → activated UX / Architecture 或 explicit skip → Impact freeze<BR ALIGN="LEFT"/>
                  → Test Design → Tech Lead → bounded Task Packets
                </TD>
              </TR>
              <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F4EEFC" COLOR="#6F4BA5">
                  Human freezes <B>Phase Success Baseline</B> before first test action<BR ALIGN="LEFT"/>
                  → immutable Candidate + test Manifest + Test Admission<BR ALIGN="LEFT"/>
                  → trustworthy test outcome → independent QA<BR ALIGN="LEFT"/>
                  → PRODUCT Release Package for exact Candidate + production Manifest<BR ALIGN="LEFT"/>
                  → trustworthy production outcome → Production Verification → Business Acceptance
                </TD>
              </TR>
              <TR>
                <TD BGCOLOR="#FFF9E8" COLOR="#A66A00" ALIGN="LEFT">
                  每次 handoff：freeze exact revision → Human ACCEPT → separate INVOKE → actual start rechecks current authority。<BR ALIGN="LEFT"/>
                  Uncertain invocation or environment action remains BLOCKED until the same identity is reconciled without duplicate execution。
                </TD>
              </TR>
            </TABLE>
          </TD>
        </TR>

        <TR>
          <TD VALIGN="TOP">
            <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"
                   COLOR="#8FA6C2" BGCOLOR="#FFFFFF" WIDTH="620">
              <TR><TD COLSPAN="2" BGCOLOR="#DDE9F8" ALIGN="LEFT"><FONT POINT-SIZE="14"><B>3 · STAGE-PACKAGE LIFECYCLE</B></FONT></TD></TR>
              <TR><TD BGCOLOR="#EAF2FF"><B>DRAFT</B></TD><TD ALIGN="LEFT">producing Owner may edit</TD></TR>
              <TR><TD BGCOLOR="#EAF2FF"><B>READY_FOR_REVIEW</B></TD><TD ALIGN="LEFT">Owner freezes review revision + self-check</TD></TR>
              <TR><TD BGCOLOR="#FFF3C7" COLOR="#A66A00"><B>ACCEPTED</B></TD><TD ALIGN="LEFT">Human accepts exact immutable revision</TD></TR>
              <TR><TD BGCOLOR="#FDECEC" COLOR="#B43A3A"><B>BLOCKED</B></TD><TD ALIGN="LEFT">fact / authority / environment prevents valid completion</TD></TR>
              <TR><TD BGCOLOR="#FDECEC" COLOR="#B43A3A"><B>STALE</B></TD><TD ALIGN="LEFT">upstream change requires reassessment</TD></TR>
              <TR><TD BGCOLOR="#F5F7FA"><B>SUPERSEDED</B></TD><TD ALIGN="LEFT">newer revision replaced it; history only</TD></TR>
              <TR>
                <TD COLSPAN="2" BGCOLOR="#FFF9E8" ALIGN="LEFT">
                  BLOCKED / STALE resolution creates a new DRAFT revision；不得直接回 ACCEPTED。<BR ALIGN="LEFT"/>
                  历史 ACCEPT 不证明 current start authority；invalidation 沿 exact references 传播。
                </TD>
              </TR>
            </TABLE>
          </TD>

          <TD VALIGN="TOP">
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"
                   COLOR="#6F4BA5" BGCOLOR="#FFFFFF" WIDTH="700">
              <TR><TD BGCOLOR="#EEE6FA" ALIGN="LEFT"><FONT POINT-SIZE="14"><B>4 · IDENTITY &amp; ENVIRONMENT BOUNDARIES</B></FONT></TD></TR>
              <TR>
                <TD ALIGN="LEFT" BGCOLOR="#F4EEFC">
                  <B>Phase Success Baseline</B> = frozen value / behavior / AC / proof denominator<BR ALIGN="LEFT"/>
                  <B>Candidate</B> = release-bearing material identity<BR ALIGN="LEFT"/>
                  <B>Deployment Manifest</B> = environment-specific identity（secret values stay outside）<BR ALIGN="LEFT"/>
                  <B>Environment State</B> = current settled identity + complete incident set + mutation status
                </TD>
              </TR>
              <TR>
                <TD ALIGN="LEFT">
                  Candidate change → new Candidate + affected verify / deploy / QA / release evidence。<BR ALIGN="LEFT"/>
                  Manifest-only change → same Candidate, new deployment identity + affected gates。<BR ALIGN="LEFT"/>
                  Old evidence remains history but cannot qualify another identity。
                </TD>
              </TR>
              <TR>
                <TD ALIGN="LEFT" BGCOLOR="#FFF9E8" COLOR="#A66A00">
                  <B>Environment action evidence</B>：Human authorization ≠ attempt ≠ observation ≠ trustworthy outcome。<BR ALIGN="LEFT"/>
                  Each action identity is authorized once, produces at most one effective side effect and ≤ 1 trustworthy terminal outcome；
                  retry with new side effect requires fresh authority。
                </TD>
              </TR>
              <TR>
                <TD ALIGN="LEFT" BGCOLOR="#FDECEC" COLOR="#B43A3A">
                  Failed / partial / unknown / unresolved action → environment stays blocked；
                  no QA / verification / acceptance / success。<BR ALIGN="LEFT"/>
                  Previous mutator must be unable to write before authority transfers；
                  failed production state must never become temporarily unguarded。
                </TD>
              </TR>
              <TR>
                <TD ALIGN="LEFT" BGCOLOR="#FFF9E8" COLOR="#A66A00">
                  <B>Production diagnostic</B>：bounded + continuous safe exit + NO RELEASE PASS + R00 only；
                  expiry triggers pre-authorized safe exit without a new Human decision，otherwise environment remains blocked and enters R09。
                </TD>
              </TR>
            </TABLE>
          </TD>
        </TR>

        <TR>
          <TD COLSPAN="2">
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"
                   COLOR="#B43A3A" BGCOLOR="#FDECEC" WIDTH="1334">
              <TR>
                <TD ALIGN="LEFT" COLOR="#B43A3A">
                  <B>DO NOT COLLAPSE STATE DOMAINS</B>：
                  package ACCEPTED ≠ Phase Success Baseline ≠ Candidate qualified ≠ Manifest identity ≠ invocation authority
                  ≠ environment state ≠ action attempt / outcome ≠ containment ≠ Incident Case ≠ Phase outcome ≠ Demand outcome。<BR ALIGN="LEFT"/>
                  closed / terminated Phase 与 completed / terminated Demand authority-absorbing；
                  paused / awaiting-rework Phase 只能 F17，同一 Demand 不得同时存在 F16 / competing Phase authority；<BR ALIGN="LEFT"/>
                  Incident Case 只能由独立 current-safety evidence 关闭，不能被 product disposition 顺手关闭。
                </TD>
              </TR>
            </TABLE>
          </TD>
        </TR>
      </TABLE>
    >
  ];
}
