digraph ArtifactsVersionsAndState {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    ordering=out,
    splines=ortho,
    outputorder=edgesfirst,
    bgcolor="#F6F8FB",
    pad="0.20",
    nodesep="0.24",
    ranksep="0.36",
    labelloc=t,
    labeljust=l,
    label="ARTIFACTS, VERSIONS, AND STATE\nTARGET OPERATING ARCHITECTURE · V1.2 · VIEW R4\nM0 MANUAL CONTROL · Human-governed · Agent-executed · Evidence-driven\nTARGET DESIGN · NOT RUNTIME-ACTIVE",
    fontname="Helvetica-Bold",
    fontsize=21,
    fontcolor="#132A44"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#7890AA",
    fillcolor="#FFFFFF",
    fontname="Helvetica",
    fontcolor="#132A44",
    fontsize=12,
    margin="0.10,0.07",
    penwidth=1.2
  ];

  edge [
    color="#64748B",
    fontname="Helvetica",
    fontcolor="#334155",
    fontsize=11.5,
    arrowsize=0.75,
    penwidth=1.3
  ];

  // Layout only: this seed order keeps the four connected LR lanes top-to-bottom.
  subgraph cluster_package_lifecycle {
    layout_cluster_order_02 [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];
  }

  subgraph cluster_package_lineage {
    layout_cluster_order_01 [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];
  }

  subgraph cluster_release_environment_identity {
    layout_cluster_order_03 [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];
  }

  subgraph cluster_outcome_incident_state {
    layout_cluster_order_04 [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];
  }

  subgraph cluster_package_lineage {
    label="01 PACKAGE LINEAGE · DOWNSTREAM REFERENCES EXACT ACCEPTED REVISIONS";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=15;
    penwidth=1.7;
    style="rounded,filled";
    margin=14;

    lineage_director [
      label="[ART]\nDirector Decision",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_product_definition [
      label="[ART]\nProduct Definition",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_impact_freeze [
      label="[ART]\nImpact Freeze",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_test_design [
      label="[ART]\nTest Design",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_tech_lead [
      label="[ART]\nTech Lead Package",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_task_packets [
      label="[ART]\nBounded Task Packets",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_reference_law [
      label="[REFERENCE LAW]\nexact accepted revision\nupstream bytes never rewritten",
      shape=note,
      style=filled,
      color="#2F6DB0",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      fontcolor="#174B80",
      fontsize=11.5,
      penwidth=1.3
    ];

    lineage_director -> lineage_product_definition ->
      lineage_impact_freeze -> lineage_test_design ->
      lineage_tech_lead -> lineage_task_packets [
        color="#2F6DB0",
        penwidth=1.5
      ];

    lineage_task_packets -> lineage_reference_law [
      style=dashed,
      arrowhead=none,
      color="#2F6DB0",
      penwidth=1.2
    ];
  }

  subgraph cluster_package_lifecycle {
    label="02 PACKAGE LIFECYCLE · ACCEPTANCE IS REVISION-BOUND, NOT CURRENT AUTHORITY";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=15;
    penwidth=1.7;
    style="rounded,filled";
    margin=14;

    lifecycle_draft [
      label="[PKG]\nDRAFT\nbytes may change",
      color="#64748B",
      fillcolor="#F8FAFC",
      fontname="Helvetica-Bold"
    ];

    lifecycle_ready [
      label="[PKG]\nREADY_FOR_REVIEW\nfrozen review revision",
      color="#2F6DB0",
      fillcolor="#EEF4FA",
      fontname="Helvetica-Bold"
    ];

    lifecycle_accepted [
      label="[H]\nHuman ACCEPTS exact immutable revision\nACCEPTED",
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    lifecycle_superseded [
      label="[HISTORY]\nSUPERSEDED\nhistory only",
      color="#64748B",
      fillcolor="#F8FAFC",
      fontname="Helvetica-Bold"
    ];

    lifecycle_blocked [
      label="[PKG][BLOCK]\nBLOCKED\nfact · authority · environment",
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      penwidth=1.7
    ];

    lifecycle_stale [
      label="[PKG][STALE]\nSTALE\nupstream identity changed",
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      penwidth=1.7
    ];

    lifecycle_new_draft [
      label="[NEW REVISION]\nnew DRAFT revision\nfresh review required",
      color="#2F6DB0",
      fillcolor="#EEF4FA",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lifecycle_draft -> lifecycle_ready [
      xlabel="freeze + self-check"
    ];

    lifecycle_ready -> lifecycle_accepted [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    lifecycle_accepted -> lifecycle_superseded [
      xlabel="history only",
      color="#64748B"
    ];

    lifecycle_draft -> lifecycle_blocked [
      xlabel="blocked",
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      constraint=false
    ];

    lifecycle_accepted -> lifecycle_stale [
      xlabel="upstream changed",
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      constraint=false
    ];

    lifecycle_blocked -> lifecycle_new_draft [
      xlabel="new revision",
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635"
    ];

    lifecycle_stale -> lifecycle_new_draft [
      xlabel="new revision",
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635"
    ];

    lifecycle_new_draft -> lifecycle_ready [
      xlabel="fresh review",
      color="#2F6DB0",
      fontcolor="#174B80",
      constraint=false
    ];

    {
      rank=same;
      lifecycle_draft;
      lifecycle_blocked;
    }

    {
      rank=same;
      lifecycle_ready;
      lifecycle_new_draft;
    }

    {
      rank=same;
      lifecycle_accepted;
      lifecycle_stale;
    }
  }

  subgraph cluster_release_environment_identity {
    label="03 RELEASE & ENVIRONMENT IDENTITY · IDENTITY CHANGES REQUALIFY, NEVER BORROW OLD EVIDENCE";
    labelloc=t;
    labeljust=l;
    color="#177E89";
    fillcolor="#EAF8F7";
    fontname="Helvetica-Bold";
    fontcolor="#0F6269";
    fontsize=15;
    penwidth=1.7;
    style="rounded,filled";
    margin=14;

    release_baseline [
      label="[STATE]\nPhase Success Baseline\nfrozen before first test action",
      color="#177E89",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    release_candidate [
      label="[ART][IMMUTABLE]\nCandidate C[n]\nrelease-bearing identity",
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.7,
      peripheries=2
    ];

    release_manifest [
      label="[ART]\nManifest M[n]\nCandidate C[n]\n+ environment",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    action_authorization [
      label="[H][CURRENT AUTH]\nAuthorized Action\nC[n] + M[n]\nconsumed once · current identity only",
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    action_authorization_candidate_next [
      label="[H][NEXT AUTH]\nAuthorized Action\nC[n+1] + M[C[n+1], env]\nconsumed once",
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    action_authorization_manifest_next [
      label="[H][NEXT AUTH]\nAuthorized Action\nC[n] + M[n+1]\nconsumed once",
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    action_attempt [
      label="[ACTION]\nAttempt\nconsumes one exact\nAuthorized Action identity\n≤ 1 side effect",
      color="#7890AA",
      fillcolor="#EEF4FA",
      fontname="Helvetica-Bold"
    ];

    action_observation [
      label="[ART]\nReconciliation\nObservation",
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    action_outcome [
      label="[ART]\nTrustworthy Complete Outcome\ncomplete + trustworthy only",
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    release_environment_state [
      label="[STATE]\nCurrent Environment State\nsettled identity · incidents\n· write status",
      color="#177E89",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    identity_candidate_changed [
      label="[CHANGE]\nCandidate change →\nnew Candidate + affected gates",
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      fontsize=11.5,
      penwidth=1.7
    ];

    release_candidate_next [
      label="[ART][IMMUTABLE][NEXT]\nCandidate C[n+1]\nnew release identity",
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.8,
      peripheries=2
    ];

    release_candidate_manifest_next [
      label="[ART][NEXT]\nApplicable Manifest\nM[C[n+1], env]\nfor Candidate C[n+1]",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.6
    ];

    identity_candidate_gates [
      label="[ART][AFFECTED]\nCandidate qualification\nfresh evidence only\nverify · deploy · QA · release",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      fontsize=11.5,
      penwidth=1.6
    ];

    identity_manifest_changed [
      label="[CHANGE]\nManifest-only change →\nsame Candidate,\nnew deployment identity",
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      fontsize=11.5,
      penwidth=1.7
    ];

    release_manifest_next [
      label="[ART][NEXT]\nManifest M[n+1]\nsame Candidate C[n]\nnew environment identity",
      shape=note,
      style=filled,
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.6
    ];

    identity_manifest_gates [
      label="[ART][AFFECTED]\nEnvironment qualification\nfresh evidence only\ndeploy · QA · release",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      fontsize=11.5,
      penwidth=1.6
    ];

    identity_prior_evidence [
      label="[ART][IDENTITY-BOUND]\nPrior evidence: C[n] + M[n] only\nTEE = NO AUTHORITY\nto another identity",
      shape=note,
      style=filled,
      color="#B23A48",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      fontsize=11.5,
      penwidth=1.6
    ];

    action_evidence_law [
      label="[CONTROL LAW]\nauthorization ≠ attempt\n≠ observation ≠ outcome",
      shape=note,
      style=filled,
      color="#B7791F",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      fontcolor="#7A4B00",
      fontsize=11.5,
      penwidth=1.5
    ];

    release_environment_blocked [
      label="[STATE][BLOCK]\nfailed / partial / unknown\n→ environment BLOCKED\nno QA · verification\n· acceptance · success",
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      fontsize=11.5,
      penwidth=1.9
    ];

    release_baseline -> release_candidate [
      color="#177E89",
      penwidth=1.5
    ];

    release_candidate -> release_manifest [
      color="#177E89",
      penwidth=1.5
    ];

    release_manifest -> action_authorization [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    action_authorization -> action_attempt [
      color="#B7791F",
      style=dashed,
      penwidth=1.7
    ];

    action_attempt -> action_observation;

    action_observation -> action_outcome [
      color="#64748B"
    ];

    action_outcome -> release_environment_state [
      color="#177E89",
      penwidth=1.5
    ];

    release_candidate -> identity_candidate_changed [
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      constraint=false
    ];

    identity_candidate_changed -> release_candidate_next [
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.8,
      constraint=false
    ];

    release_candidate_next -> release_candidate_manifest_next [
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.8,
      constraint=false
    ];

    release_candidate_manifest_next -> identity_candidate_gates [
      xlabel="invalidates + reruns",
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.8,
      constraint=false
    ];

    identity_candidate_gates -> action_authorization_candidate_next [
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.7,
      constraint=false
    ];

    release_manifest -> identity_manifest_changed [
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      constraint=false
    ];

    identity_manifest_changed -> release_manifest_next [
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.8,
      constraint=false
    ];

    release_manifest_next -> identity_manifest_gates [
      xlabel="invalidates + reruns",
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.8,
      constraint=false
    ];

    identity_manifest_gates -> action_authorization_manifest_next [
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.7,
      constraint=false
    ];

    action_authorization_candidate_next -> action_attempt [
      color="#B7791F",
      style=dashed,
      penwidth=1.7,
      constraint=false
    ];

    action_authorization_manifest_next -> action_attempt [
      color="#B7791F",
      style=dashed,
      penwidth=1.7,
      constraint=false
    ];

    identity_prior_evidence -> release_candidate_next [
      arrowhead=tee,
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.9,
      constraint=false
    ];

    identity_prior_evidence -> release_candidate_manifest_next [
      arrowhead=tee,
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.9,
      constraint=false
    ];

    identity_prior_evidence -> release_manifest_next [
      arrowhead=tee,
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.9,
      constraint=false
    ];

    action_authorization -> action_authorization_candidate_next [
      arrowhead=tee,
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.9,
      constraint=false
    ];

    action_authorization -> action_authorization_manifest_next [
      arrowhead=tee,
      style=dashed,
      color="#B23A48",
      fontcolor="#8F2635",
      penwidth=1.9,
      constraint=false
    ];

    action_authorization -> action_evidence_law [
      style=dashed,
      arrowhead=none,
      color="#B7791F",
      penwidth=1.2,
      constraint=false
    ];

    action_observation -> release_environment_blocked [
      style=dashed,
      color="#B23A48",
      penwidth=1.8,
      constraint=false
    ];

    {
      rank=same;
      release_baseline;
      identity_prior_evidence;
    }

    {
      rank=same;
      release_candidate;
      identity_candidate_changed;
      release_candidate_next;
      release_candidate_manifest_next;
      identity_candidate_gates;
    }

    {
      rank=same;
      release_manifest;
      identity_manifest_changed;
      release_manifest_next;
      identity_manifest_gates;
    }

    {
      rank=same;
      action_authorization;
      action_authorization_candidate_next;
      action_authorization_manifest_next;
    }

    {
      rank=same;
      action_observation;
      action_evidence_law;
      release_environment_blocked;
    }
  }

  subgraph cluster_outcome_incident_state {
    label="04 ORTHOGONAL OUTCOME / INCIDENT STATE · PRODUCT AND SAFETY AUTHORITY NEVER MERGE";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=15;
    penwidth=1.7;
    style="rounded,filled";
    margin=14;

    incident_case [
      label="[INCIDENT]\nIncident Case\nproduct disposition does not\nclose Incident Case",
      color="#B23A48",
      fillcolor="#FFE0E4",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      penwidth=1.9
    ];

    incident_resolution [
      label="[STATE][INCIDENT]\nindependent current-safety resolution\nincident evidence has no\nproduct-success authority",
      color="#B23A48",
      fillcolor="#FFF1F2",
      fontname="Helvetica-Bold",
      fontcolor="#8F2635",
      penwidth=1.9
    ];

    outcome_disposition [
      label="[H]\nProduct Disposition\nProduction Verification + Business Acceptance",
      color="#B7791F",
      fillcolor="#FFF3C4",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    outcome_phase [
      label="[STATE][PRODUCT]\nPhase Outcome\nsuccess · pause · terminate · rework",
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.6
    ];

    outcome_demand [
      label="[STATE][PRODUCT]\nDemand Outcome\ncomplete · defer · terminate · continue",
      color="#177E89",
      fillcolor="#E7F7F6",
      fontname="Helvetica-Bold",
      penwidth=1.6
    ];

    incident_case -> incident_resolution [
      color="#B23A48",
      penwidth=1.8
    ];

    outcome_disposition -> outcome_phase [
      color="#B7791F",
      style=dashed,
      penwidth=1.9
    ];

    outcome_phase -> outcome_demand [
      color="#177E89",
      penwidth=1.5
    ];

    outcome_disposition -> incident_case [
      arrowhead=tee,
      style=dashed,
      color="#B23A48",
      penwidth=1.8,
      constraint=false
    ];

    incident_resolution -> outcome_phase [
      arrowhead=tee,
      style=dashed,
      color="#B23A48",
      penwidth=1.8,
      constraint=false
    ];

  }

  lifecycle_draft -> lineage_director [
    xlabel="each package",
    dir=back,
    color="#2F6DB0",
    fontcolor="#174B80",
    penwidth=1.5,
    constraint=false
  ];

  release_baseline -> lifecycle_accepted [
    dir=back,
    color="#B7791F",
    style=dashed,
    penwidth=1.7,
    constraint=false
  ];

  outcome_disposition -> release_environment_state [
    dir=back,
    color="#B7791F",
    style=dashed,
    penwidth=1.7,
    constraint=false
  ];

  incident_case -> release_environment_blocked [
    xlabel="contain + open / preserve exact Incident Case",
    dir=back,
    color="#B23A48",
    fontcolor="#8F2635",
    style=dashed,
    penwidth=1.9,
    constraint=false
  ];

  {
    rank=same;
    lineage_director;
    lifecycle_draft;
  }

  {
    rank=same;
    action_observation;
    release_environment_blocked;
    incident_case;
  }

  {
    rank=same;
    release_environment_state;
    incident_resolution;
  }
}
