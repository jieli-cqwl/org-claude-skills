digraph ArtifactsVersionsAndState {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    ordering=out,
    splines=ortho,
    outputorder=edgesfirst,
    bgcolor="#F6F8FB",
    pad="0.28",
    nodesep="0.28",
    ranksep="0.42",
    labelloc=t,
    labeljust=l,
    label="ARTIFACTS, VERSIONS, AND STATE\nTARGET OPERATING ARCHITECTURE · V1.2 · VIEW R6\nM0 MANUAL CONTROL · Human-governed · Agent-executed · Evidence-driven\nTARGET DESIGN · NOT RUNTIME-ACTIVE",
    fontname="Helvetica-Bold",
    fontsize=24,
    fontcolor="#132A44"
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#7890AA",
    fillcolor="#FFFFFF",
    fontname="Helvetica",
    fontcolor="#132A44",
    fontsize=10,
    margin="0.12,0.08",
    penwidth=1.1
  ];

  edge [
    color="#64748B",
    fontname="Helvetica",
    fontcolor="#334155",
    fontsize=8.5,
    arrowsize=0.7,
    penwidth=1.2
  ];

  // layout only: DOT stacks LR clusters bottom-up by first nonempty declaration.
  subgraph cluster_outcome_incident_state {
    layout_cluster_order_04 [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];
  }

  // layout only: seed order also compensates the ACCEPTED-to-Baseline bridge.
  subgraph cluster_package_lifecycle {
    layout_cluster_order_02 [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];
  }

  // layout only
  subgraph cluster_release_environment_identity {
    layout_cluster_order_03 [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];
  }

  // layout only
  subgraph cluster_package_lineage {
    layout_cluster_order_01 [
      shape=point,
      style=invis,
      width=0,
      height=0,
      label=""
    ];
  }

  subgraph cluster_package_lineage {
    label="01 PACKAGE LINEAGE · DOWNSTREAM REFERENCES EXACT ACCEPTED REVISIONS";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=16;
    penwidth=1.7;
    style="rounded,filled";
    margin=16;

    lineage_director [
      label="[ART]\nDirector Decision",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_product_definition [
      label="[ART]\nProduct Definition",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_impact_freeze [
      label="[ART]\nImpact Freeze",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_test_design [
      label="[ART]\nTest Design",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_tech_lead [
      label="[ART]\nTech Lead Package",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_task_packets [
      label="[ART]\nBounded Task Packets",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    lineage_reference_law [
      label="[REFERENCE LAW]\ndownstream references exact revision\nnever rewrites upstream bytes",
      shape=note,
      style=filled,
      color="#2F6DB0",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      fontcolor="#174B80",
      fontsize=8.5,
      penwidth=1.3
    ];

    lineage_director -> lineage_product_definition ->
      lineage_impact_freeze -> lineage_test_design ->
      lineage_tech_lead -> lineage_task_packets [
        color="#2F6DB0",
        penwidth=1.4
      ];

    lineage_task_packets -> lineage_reference_law [
      style=dashed,
      arrowhead=none,
      color="#2F6DB0",
      penwidth=1.1,
      constraint=false
    ];

    {
      rank=same;
      lineage_task_packets;
      lineage_reference_law;
    }
  }

  subgraph cluster_package_lifecycle {
    label="02 PACKAGE LIFECYCLE · ACCEPTANCE IS REVISION-BOUND, NOT CURRENT AUTHORITY";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=16;
    penwidth=1.7;
    style="rounded,filled";
    margin=16;

    lifecycle_draft [
      label="[PKG]\nDRAFT\nbytes may change",
      color="#66768D",
      fillcolor="#F3F5F8",
      fontname="Helvetica-Bold"
    ];

    lifecycle_ready [
      label="[PKG]\nREADY_FOR_REVIEW\nfrozen review revision",
      color="#2459A9",
      fillcolor="#EAF2FF",
      fontname="Helvetica-Bold"
    ];

    lifecycle_accepted [
      label="[H]\nHuman ACCEPTS exact immutable revision\nACCEPTED",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    lifecycle_superseded [
      label="[HISTORY]\nSUPERSEDED\nhistory only",
      color="#66768D",
      fillcolor="#F3F5F8",
      fontname="Helvetica-Bold"
    ];

    lifecycle_blocked [
      label="[PKG][BLOCK]\nBLOCKED\nfact · authority · environment",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="Helvetica-Bold",
      fontcolor="#8F1D13",
      penwidth=1.6
    ];

    lifecycle_stale [
      label="[PKG][STALE]\nSTALE\nupstream identity changed",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="Helvetica-Bold",
      fontcolor="#8F1D13",
      penwidth=1.6
    ];

    lifecycle_new_draft [
      label="[NEW REVISION]\nnew DRAFT revision\nfresh review required",
      color="#2459A9",
      fillcolor="#EAF2FF",
      fontname="Helvetica-Bold",
      penwidth=1.4
    ];

    lifecycle_draft -> lifecycle_ready [
      xlabel="freeze + self-check"
    ];

    lifecycle_ready -> lifecycle_accepted [
      color="#A16207",
      style=dashed,
      penwidth=1.8
    ];

    lifecycle_accepted -> lifecycle_superseded [
      xlabel="history only",
      color="#66768D"
    ];

    lifecycle_draft -> lifecycle_blocked [
      xlabel="blocked",
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13",
      constraint=false
    ];

    lifecycle_accepted -> lifecycle_stale [
      xlabel="upstream changed",
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13",
      constraint=false
    ];

    lifecycle_blocked -> lifecycle_new_draft [
      xlabel="new revision",
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13"
    ];

    lifecycle_stale -> lifecycle_new_draft [
      xlabel="new revision",
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13"
    ];

    lifecycle_new_draft -> lifecycle_ready [
      xlabel="fresh review",
      color="#2459A9",
      fontcolor="#174B80",
      constraint=false
    ];

    {
      rank=same;
      lifecycle_draft;
      lifecycle_blocked;
    }

    {
      rank=same;
      lifecycle_ready;
      lifecycle_new_draft;
    }

    {
      rank=same;
      lifecycle_accepted;
      lifecycle_stale;
    }
  }

  subgraph cluster_release_environment_identity {
    label="03 RELEASE & ENVIRONMENT IDENTITY · EACH FACT KEEPS ITS OWN IDENTITY";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=16;
    penwidth=1.7;
    style="rounded,filled";
    margin=16;

    release_baseline [
      label="[STATE]\nPhase Success Baseline\naccepted package ≠ success denominator\nfrozen before first test action",
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    release_candidate [
      label="[ART][IMMUTABLE]\nCandidate\nrelease-bearing identity",
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.6,
      peripheries=2
    ];

    release_manifest [
      label="[ART]\nEnvironment-specific Manifest\nseparate deployment identity",
      shape=note,
      style=filled,
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    action_authorization [
      label="[H]\nAuthorized Action\nexact identity · consumed once",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    action_attempt [
      label="[ACTION]\nAttempt\n≤ 1 effective side effect",
      color="#66768D",
      fillcolor="#F3F5F8",
      fontname="Helvetica-Bold"
    ];

    action_observation [
      label="[ART]\nReconciliation Observation\nsame action identity",
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    action_outcome [
      label="[ART]\nTrustworthy Complete Outcome\n≤ 1 terminal outcome",
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.5
    ];

    release_environment_state [
      label="[STATE]\nCurrent Environment State\nsettled identity · complete incident set\nmutation / write status",
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.8
    ];

    action_evidence_law [
      label="[CONTROL LAW]\nauthorization ≠ attempt ≠ observation ≠ outcome",
      shape=note,
      style=filled,
      color="#A16207",
      fillcolor="#FFFFFF",
      fontname="Helvetica-Bold",
      fontcolor="#7A4B00",
      fontsize=8.5,
      penwidth=1.4
    ];

    release_environment_blocked [
      label="[STATE][BLOCK]\nfailed / partial / unknown → environment BLOCKED\nno QA · verification · acceptance · success",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="Helvetica-Bold",
      fontcolor="#8F1D13",
      penwidth=1.8
    ];

    identity_candidate_changed [
      label="[CHANGE]\nCandidate change → new Candidate + affected gates",
      shape=box,
      style="rounded,filled",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="Helvetica-Bold",
      fontcolor="#8F1D13",
      fontsize=8.5,
      penwidth=1.6
    ];

    identity_manifest_changed [
      label="[CHANGE]\nManifest-only change → same Candidate, new deployment identity",
      shape=box,
      style="rounded,filled",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="Helvetica-Bold",
      fontcolor="#8F1D13",
      fontsize=8.5,
      penwidth=1.6
    ];

    identity_affected_evidence [
      label="[ART][INVALIDATED]\nAffected downstream evidence\nverify · deploy · QA · release",
      shape=note,
      style=filled,
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="Helvetica-Bold",
      fontcolor="#8F1D13",
      penwidth=1.6
    ];

    release_baseline -> release_candidate [
      color="#0F766E",
      penwidth=1.4
    ];

    release_candidate -> release_manifest [
      color="#0F766E",
      penwidth=1.4
    ];

    release_manifest -> action_authorization [
      color="#A16207",
      style=dashed,
      penwidth=1.8
    ];

    action_authorization -> action_attempt [
      color="#A16207",
      style=dashed,
      penwidth=1.6
    ];

    action_attempt -> action_observation;

    action_observation -> action_outcome [
      xlabel="complete + trustworthy only"
    ];

    action_outcome -> release_environment_state [
      color="#0F766E",
      penwidth=1.4
    ];

    action_authorization -> action_evidence_law [
      style=dashed,
      arrowhead=none,
      color="#A16207",
      penwidth=1.1,
      constraint=false
    ];

    action_observation -> release_environment_blocked [
      style=dashed,
      color="#B42318",
      penwidth=1.7,
      constraint=false
    ];

    release_candidate -> identity_candidate_changed [
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13",
      constraint=false
    ];

    release_manifest -> identity_manifest_changed [
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13",
      constraint=false
    ];

    identity_candidate_changed -> identity_affected_evidence [
      xlabel="invalidates",
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13",
      penwidth=1.8
    ];

    identity_manifest_changed -> identity_affected_evidence [
      xlabel="invalidates",
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13",
      penwidth=1.8
    ];

    identity_affected_evidence -> action_authorization [
      xlabel="rerun affected gates",
      style=dashed,
      color="#B42318",
      fontcolor="#8F1D13",
      penwidth=1.6,
      constraint=false
    ];

    {
      rank=same;
      release_candidate;
      identity_candidate_changed;
    }

    {
      rank=same;
      release_manifest;
      identity_manifest_changed;
    }

    {
      rank=same;
      identity_affected_evidence;
      action_evidence_law;
      action_authorization;
      action_attempt;
      action_observation;
      release_environment_blocked;
      action_outcome;
    }
  }

  subgraph cluster_outcome_incident_state {
    label="04 ORTHOGONAL OUTCOME / INCIDENT STATE · PRODUCT AND SAFETY AUTHORITY NEVER MERGE";
    labelloc=t;
    labeljust=l;
    color="#2F6DB0";
    fillcolor="#F8FBFF";
    fontname="Helvetica-Bold";
    fontcolor="#174B80";
    fontsize=16;
    penwidth=1.7;
    style="rounded,filled";
    margin=16;

    incident_case [
      label="[INCIDENT]\nIncident Case\nproduct disposition does not close Incident Case\nindependent safety identity",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="Helvetica-Bold",
      fontcolor="#8F1D13",
      penwidth=1.8
    ];

    incident_resolution [
      label="[STATE][INCIDENT]\nindependent current-safety resolution\nincident evidence has no product-success authority",
      color="#B42318",
      fillcolor="#FDECEC",
      fontname="Helvetica-Bold",
      fontcolor="#8F1D13",
      penwidth=1.8
    ];

    outcome_disposition [
      label="[H]\nProduct Disposition\ncurrent state is evidence, not product success\nProduction Verification + Business Acceptance required",
      color="#A16207",
      fillcolor="#FFF4D6",
      fontname="Helvetica-Bold",
      penwidth=2.0
    ];

    outcome_phase [
      label="[STATE][PRODUCT]\nPhase Outcome\nsuccess · pause · terminate · rework",
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.6
    ];

    outcome_demand [
      label="[STATE][PRODUCT]\nDemand Outcome\ncomplete · defer · terminate · continue",
      color="#0F766E",
      fillcolor="#E7F7F3",
      fontname="Helvetica-Bold",
      penwidth=1.6
    ];

    incident_case -> incident_resolution [
      color="#B42318",
      penwidth=1.7
    ];

    outcome_disposition -> outcome_phase [
      color="#A16207",
      style=dashed,
      penwidth=1.8
    ];

    outcome_phase -> outcome_demand [
      color="#0F766E",
      penwidth=1.4
    ];

    outcome_disposition -> incident_case [
      arrowhead=tee,
      style=dashed,
      color="#B42318",
      penwidth=1.7,
      constraint=false
    ];

    incident_resolution -> outcome_phase [
      arrowhead=tee,
      style=dashed,
      color="#B42318",
      penwidth=1.7,
      constraint=false
    ];

  }

  lifecycle_draft -> lineage_director [
    xlabel="each package",
    dir=back,
    color="#2F6DB0",
    fontcolor="#174B80",
    penwidth=1.5,
    weight=0,
    constraint=false
  ];

  release_baseline -> lifecycle_accepted [
    dir=back,
    color="#A16207",
    style=dashed,
    penwidth=1.6,
    weight=0,
    constraint=false
  ];

  outcome_disposition -> release_environment_state [
    dir=back,
    color="#A16207",
    style=dashed,
    penwidth=1.6,
    weight=0,
    constraint=false
  ];

  incident_case -> release_environment_blocked [
    xlabel="contain + open / preserve exact Incident Case",
    dir=back,
    color="#B42318",
    fontcolor="#8F1D13",
    style=dashed,
    penwidth=1.8,
    weight=0,
    constraint=false
  ];

  {
    rank=same;
    lineage_director;
    lifecycle_draft;
  }

  {
    rank=same;
    action_observation;
    release_environment_blocked;
    incident_case;
  }

  {
    rank=same;
    release_environment_state;
    incident_resolution;
    outcome_disposition;
  }
}
