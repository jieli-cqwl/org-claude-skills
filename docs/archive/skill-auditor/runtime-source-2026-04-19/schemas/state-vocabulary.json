{
  "schema_version": "1.0.0",
  "states": ["draft", "audited", "planned", "implemented", "verified", "blocked"],
  "transitions": [
    {"from": "draft", "action": "validate_audit", "to": "audited"},
    {"from": "audited", "action": "accept_plan", "to": "planned"},
    {"from": "planned", "action": "apply_changes", "to": "implemented"},
    {"from": "implemented", "action": "verify", "to": "verified"},
    {"from": "*", "action": "block", "to": "blocked"},
    {"from": "blocked", "action": "revise", "to": "draft"}
  ]
}
