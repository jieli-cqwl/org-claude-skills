    },
    {
      "id": "check-package-quality",
      "path": "tools/skill_quality/check_skill_package_quality.py",
      "owner": "skill-quality-tools",
      "allowed_args": [
        "<skill-path>"
      ],
      "timeout_seconds": 30,
      "output_root": "stdout",
      "allowed_input_roots": [
        "shared/skills",
        "tests/fixtures/skill-quality-detection"
      ],
