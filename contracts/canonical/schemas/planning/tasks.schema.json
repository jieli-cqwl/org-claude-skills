{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/planning/tasks.schema.json",
  "description": "Task registry contract. Freezes immutable task definitions that runtime state can reference but not rewrite.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "tasks"
        },
        "plan_version": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task_id",
              "task_title",
              "phase_ref",
              "unit_refs",
              "scope_item_refs",
              "depends_on",
              "shared_files",
              "batch",
              "acceptance_targets"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "task_title": {
                "type": "string"
              },
              "phase_ref": {
                "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRef"
              },
              "unit_refs": {
                "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "scope_item_refs": {
                "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "design_refs": {
                "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "test_refs": {
                "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "shared_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "batch": {
                "type": "integer",
                "minimum": 1
              },
              "acceptance_targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "artifact_type",
        "plan_version",
        "tasks",
        "baseline_plan_version_ref"
      ],
      "additionalProperties": true
    }
  ]
}
