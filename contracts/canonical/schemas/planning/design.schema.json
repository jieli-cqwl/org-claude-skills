{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/planning/design.schema.json",
  "description": "Design contract. Stores implementation-relevant architecture decisions without runtime verdict state.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "design"
        },
        "input_analysis": {
          "type": "string",
          "minLength": 1
        },
        "key_decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "option_analysis": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "option_id",
              "summary",
              "tradeoff",
              "verdict"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "tradeoff": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "runtime_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "interface_id",
              "owner",
              "contract_summary",
              "error_modes"
            ],
            "properties": {
              "interface_id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "contract_summary": {
                "type": "string",
                "minLength": 1
              },
              "error_modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "interface_boundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "attribute",
              "priority",
              "key_scenarios",
              "tradeoff_points"
            ],
            "properties": {
              "attribute": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "minLength": 1
              },
              "key_scenarios": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "tradeoff_points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verification_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "module_id",
              "name",
              "responsibility",
              "data_owner",
              "unit_refs"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "responsibility": {
                "type": "string",
                "minLength": 1
              },
              "data_owner": {
                "type": "string",
                "minLength": 1
              },
              "unit_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "data_architecture": {
          "type": "object",
          "required": [
            "summary",
            "storage_decisions",
            "data_flows",
            "consistency_strategy"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "storage_decisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "data_flows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "consistency_strategy": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "cross_cutting_concerns": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "concern",
              "decision",
              "owner",
              "verification_refs"
            ],
            "properties": {
              "concern": {
                "type": "string",
                "enum": [
                  "auth",
                  "error",
                  "log",
                  "config"
                ]
              },
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "verification_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "manager_vp_ref",
              "design_validation",
              "test_obligation",
              "evidence_ref"
            ],
            "properties": {
              "manager_vp_ref": {
                "type": "string",
                "minLength": 1
              },
              "design_validation": {
                "type": "string",
                "minLength": 1
              },
              "test_obligation": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "unit_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "unit_id",
              "ac_refs",
              "design_refs"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "ac_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "design_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "impact_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "scope_item_id",
              "affected_modules",
              "impact",
              "verification_refs"
            ],
            "properties": {
              "scope_item_id": {
                "type": "string",
                "minLength": 1
              },
              "affected_modules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "planning_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "constraint_id",
              "constraint_type",
              "description",
              "owner"
            ],
            "properties": {
              "constraint_id": {
                "type": "string",
                "minLength": 1
              },
              "constraint_type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "product_handoff": {
          "type": "object",
          "required": [
            "status",
            "accepted_refs",
            "open_failures",
            "warn_followups"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "accepted_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "open_failures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warn_followups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "risk_id",
              "description",
              "severity",
              "source_ref"
            ],
            "properties": {
              "risk_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "risk_response": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "risk_id",
              "architecture_response",
              "verification_refs",
              "escalation_path"
            ],
            "properties": {
              "risk_id": {
                "type": "string",
                "minLength": 1
              },
              "architecture_response": {
                "type": "string",
                "minLength": 1
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "escalation_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "migration_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "artifact_type",
        "input_analysis",
        "key_decisions",
        "option_analysis",
        "runtime_facts",
        "interfaces",
        "interface_boundary",
        "quality_attributes",
        "modules",
        "data_architecture",
        "cross_cutting_concerns",
        "verification_mapping",
        "unit_coverage",
        "impact_scope",
        "planning_constraints",
        "product_handoff",
        "risks",
        "risk_response",
        "migration_plan",
        "verification_plan",
        "rollback_plan"
      ],
      "additionalProperties": true
    }
  ]
}
