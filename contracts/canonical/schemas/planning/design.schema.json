{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/planning/design.schema.json",
  "description": "Design contract. Stores implementation-relevant architecture decisions without runtime verdict state.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "design"
        },
        "input_analysis": {
          "type": "string"
        },
        "key_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "option_analysis": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "option_id",
              "summary",
              "tradeoff",
              "verdict"
            ],
            "properties": {
              "option_id": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "tradeoff": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "runtime_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "interface_id",
              "owner",
              "contract_summary",
              "error_modes"
            ],
            "properties": {
              "interface_id": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "contract_summary": {
                "type": "string"
              },
              "error_modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "interface_boundary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migration_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verification_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rollback_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "artifact_type",
        "input_analysis",
        "key_decisions",
        "option_analysis",
        "runtime_facts",
        "interfaces",
        "interface_boundary",
        "quality_attributes",
        "migration_plan",
        "verification_plan",
        "rollback_plan"
      ],
      "additionalProperties": true
    }
  ]
}
