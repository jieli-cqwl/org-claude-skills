{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/planning/brief.schema.json",
  "description": "Feature-level planning brief contract. Keeps business goals and acceptance inputs, not runtime state.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "brief"
        },
        "root_problem": {
          "type": "string",
          "minLength": 1
        },
        "business_goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "design_decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_functional_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delivery_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "phase_id",
              "goal"
            ],
            "properties": {
              "phase_id": {
                "type": "string",
                "minLength": 1
              },
              "goal": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "director_confirmation": {
          "type": "object",
          "required": [
            "status",
            "confirmed_at",
            "locked_field_digest",
            "locked_fields"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed"
              ]
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "locked_field_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "locked_fields": {
              "type": "object",
              "required": [
                "root_problem",
                "user_profile",
                "business_goals",
                "appetite",
                "scope_boundaries",
                "non_goals",
                "feasibility_constraints",
                "risks_and_unknowns",
                "decision_rationale",
                "delivery_plan"
              ],
              "properties": {
                "root_problem": {
                  "type": "string",
                  "minLength": 1
                },
                "business_goals": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "scope_boundaries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "delivery_plan": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "phase_id",
                      "goal"
                    ],
                    "properties": {
                      "phase_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "goal": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "user_profile": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "who",
                      "scenario",
                      "current_workaround",
                      "workaround_cost"
                    ],
                    "properties": {
                      "who": {
                        "type": "string",
                        "minLength": 1
                      },
                      "scenario": {
                        "type": "string",
                        "minLength": 1
                      },
                      "current_workaround": {
                        "type": "string",
                        "minLength": 1
                      },
                      "workaround_cost": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "appetite": {
                  "type": "object",
                  "required": [
                    "investment_scale",
                    "complexity_ceiling",
                    "trim_first"
                  ],
                  "properties": {
                    "investment_scale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "complexity_ceiling": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trim_first": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                },
                "non_goals": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "feasibility_constraints": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "constraint",
                      "impact_scope",
                      "handling"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "constraint": {
                        "type": "string",
                        "minLength": 1
                      },
                      "impact_scope": {
                        "type": "string",
                        "minLength": 1
                      },
                      "handling": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "risks_and_unknowns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "item",
                      "impact",
                      "mitigation",
                      "status"
                    ],
                    "properties": {
                      "item": {
                        "type": "string",
                        "minLength": 1
                      },
                      "impact": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mitigation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "OPEN",
                          "ACCEPTED",
                          "RESOLVED"
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "decision_rationale": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "decision",
                      "choice",
                      "rationale",
                      "excluded_options"
                    ],
                    "properties": {
                      "decision": {
                        "type": "string",
                        "minLength": 1
                      },
                      "choice": {
                        "type": "string",
                        "minLength": 1
                      },
                      "rationale": {
                        "type": "string",
                        "minLength": 1
                      },
                      "excluded_options": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "review_conclusion": {
          "type": "object",
          "required": [
            "verdict",
            "summary"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "PASS",
                "WARN"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "issue_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "issue_id",
              "status",
              "severity",
              "dimension",
              "finding",
              "evidence",
              "handoff_target"
            ],
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "CLOSED",
                  "WAIVED",
                  "ACCEPTED",
                  "ACCEPTED_RISK",
                  "DEFERRED",
                  "RESOLVED"
                ]
              },
              "severity": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "finding": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "handoff_target": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "delivery_confirmation": {
          "type": "object",
          "required": [
            "status",
            "confirmed_at"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed"
              ]
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "user_profile": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "who",
              "scenario",
              "current_workaround",
              "workaround_cost"
            ],
            "properties": {
              "who": {
                "type": "string",
                "minLength": 1
              },
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "current_workaround": {
                "type": "string",
                "minLength": 1
              },
              "workaround_cost": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "appetite": {
          "type": "object",
          "required": [
            "investment_scale",
            "complexity_ceiling",
            "trim_first"
          ],
          "properties": {
            "investment_scale": {
              "type": "string",
              "minLength": 1
            },
            "complexity_ceiling": {
              "type": "string",
              "minLength": 1
            },
            "trim_first": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feasibility_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "constraint",
              "impact_scope",
              "handling"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "constraint": {
                "type": "string",
                "minLength": 1
              },
              "impact_scope": {
                "type": "string",
                "minLength": 1
              },
              "handling": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "risks_and_unknowns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "item",
              "impact",
              "mitigation",
              "status"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "ACCEPTED",
                  "RESOLVED"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "decision_rationale": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "decision",
              "choice",
              "rationale",
              "excluded_options"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "choice": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "excluded_options": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "artifact_type",
        "root_problem",
        "user_profile",
        "business_goals",
        "appetite",
        "scope_boundaries",
        "non_goals",
        "feasibility_constraints",
        "risks_and_unknowns",
        "decision_rationale",
        "delivery_plan",
        "director_confirmation"
      ],
      "additionalProperties": true
    },
    {
      "if": {
        "properties": {
          "review_conclusion": {
            "properties": {
              "verdict": {
                "const": "PASS"
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "review_conclusion"
        ]
      },
      "then": {
        "properties": {
          "issue_ledger": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_conclusion": {
            "properties": {
              "verdict": {
                "const": "WARN"
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "review_conclusion"
        ]
      },
      "then": {
        "required": [
          "issue_ledger"
        ],
        "properties": {
          "issue_ledger": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
