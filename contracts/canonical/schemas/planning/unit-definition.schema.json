{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/planning/unit-definition.schema.json",
  "description": "Unit definition contract. Freezes the unit boundary that downstream design, test-design, and execution consume.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "unit-definition"
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "closure_definition": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "priority_basis": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "artifact_type",
        "unit_id",
        "closure_definition",
        "acceptance_criteria",
        "exclusions",
        "priority",
        "priority_basis",
        "dependencies"
      ],
      "additionalProperties": true
    }
  ]
}
