{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/planning/test-cases.schema.json",
  "description": "Test-case contract. Holds AC coverage and QA handoff data for a single execution unit.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "test-cases"
        },
        "ac_coverage_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ac_id",
              "covers"
            ],
            "properties": {
              "ac_id": {
                "type": "string"
              },
              "covers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "equivalence_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "test_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "case_id",
              "title"
            ],
            "properties": {
              "case_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "qa_handoff_contract": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "test_obligation",
              "trigger_source",
              "qa_stage",
              "requiredness",
              "execution_mode",
              "skip_rule",
              "evidence_expectation"
            ],
            "properties": {
              "test_obligation": {
                "type": "string"
              },
              "trigger_source": {
                "type": "string"
              },
              "qa_stage": {
                "type": "string"
              },
              "requiredness": {
                "type": "string"
              },
              "execution_mode": {
                "type": "string",
                "enum": [
                  "browser_required",
                  "non_browser_ok"
                ]
              },
              "skip_rule": {
                "type": "string"
              },
              "evidence_expectation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "unit_coverage_view": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "unit_id",
              "ac_ids",
              "coverage_status"
            ],
            "properties": {
              "unit_id": {
                "type": "string"
              },
              "ac_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "coverage_status": {
                "type": "string",
                "enum": [
                  "COVERED",
                  "UNCOVERED",
                  "DESIGN_GAP"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "design_gap_report": {
          "type": "object",
          "required": [
            "status",
            "gaps"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "NO_GAPS",
                "HAS_GAPS"
              ]
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        },
        "special_test_triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "trigger_id",
              "condition",
              "qa_stage"
            ],
            "properties": {
              "trigger_id": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "qa_stage": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "review_conclusion": {
          "type": "object",
          "required": [
            "verdict",
            "summary"
          ],
          "properties": {
            "verdict": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "issue_ledger": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "artifact_type",
        "ac_coverage_matrix",
        "equivalence_matrix",
        "test_cases",
        "qa_handoff_contract",
        "unit_coverage_view",
        "design_gap_report",
        "special_test_triggers",
        "review_conclusion",
        "issue_ledger"
      ],
      "additionalProperties": true
    }
  ]
}
