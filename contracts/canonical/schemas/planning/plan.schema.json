{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/planning/plan.schema.json",
  "description": "Plan contract. Freezes the phase execution baseline that delivery-state and downstream runtime artifacts switch against.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "plan"
        },
        "planning_mode": {
          "const": "standard-chain"
        },
        "plan_version": {
          "type": "string"
        },
        "scope_freeze": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal_source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRef"
          }
        },
        "constraint_source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRef"
          }
        },
        "obligation_source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRef"
          }
        },
        "execution_basis_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRef"
          }
        },
        "design_review": {
          "type": "object",
          "required": [
            "verdict",
            "summary"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "DESIGN_OK",
                "DESIGN_ISSUE"
              ]
            },
            "summary": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "goal_fidelity_review": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "goal_ref",
              "task_refs",
              "execution_basis_ref",
              "status"
            ],
            "properties": {
              "goal_ref": {
                "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRef"
              },
              "task_refs": {
                "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "execution_basis_ref": {
                "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json#/$defs/canonicalRef"
              },
              "status": {
                "type": "string",
                "enum": [
                  "COVERED",
                  "N_A",
                  "GAP"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "user_confirmation": {
          "type": "object",
          "required": [
            "status",
            "confirmed_by",
            "confirmed_at"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "PENDING"
              ]
            },
            "confirmed_by": {
              "type": "string"
            },
            "confirmed_at": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "artifact_type",
        "planning_mode",
        "plan_version",
        "scope_freeze",
        "task_list",
        "baseline_plan_version_ref",
        "baseline_tasks_version_ref",
        "goal_source_refs",
        "constraint_source_refs",
        "obligation_source_refs",
        "execution_basis_refs",
        "design_review",
        "goal_fidelity_review",
        "user_confirmation"
      ],
      "additionalProperties": true
    }
  ]
}
