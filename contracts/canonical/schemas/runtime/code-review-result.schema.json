{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/runtime/code-review-result.schema.json",
  "description": "Phase review contract. Records reviewer findings without taking over delivery-state authority.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "code-review-result"
        },
        "gate_result": {
          "type": "string"
        },
        "review_round": {
          "type": "integer",
          "minimum": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "severity",
              "summary"
            ],
            "properties": {
              "finding_id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "S0",
                  "S1",
                  "S2",
                  "S3"
                ]
              },
              "summary": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "artifact_type",
        "gate_result",
        "review_round",
        "findings"
      ],
      "additionalProperties": true
    }
  ]
}
