{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/runtime/qa-result.schema.json",
  "description": "Phase QA verdict contract. Tracks QA gate results against a frozen planning baseline.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/contracts/canonical/schemas/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "qa-result"
        },
        "gate_result": {
          "type": "string"
        },
        "release_recommendation": {
          "type": "string"
        },
        "residual_risk": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "artifact_type",
        "gate_result",
        "release_recommendation",
        "residual_risk",
        "baseline_plan_version_ref",
        "baseline_tasks_version_ref"
      ],
      "additionalProperties": true
    }
  ]
}
