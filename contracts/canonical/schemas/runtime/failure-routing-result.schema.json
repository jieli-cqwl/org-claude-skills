{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/contracts/canonical/schemas/runtime/failure-routing-result.schema.json",
  "title": "Standard Chain Failure Routing Result",
  "description": "Versioned routing result emitted by standard-chain preflight and completion checkers.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "stage",
    "failure_code",
    "owner",
    "next_action",
    "safe_to_continue",
    "human_decision_required",
    "continuation_condition",
    "evidence_refs",
    "user_message"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "BLOCKED"
      ]
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "failure_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "owner": {
      "type": "string",
      "enum": [
        "product-director",
        "product-manager",
        "design",
        "test-design",
        "tech-lead",
        "delivery-owner",
        "developer",
        "verify",
        "review",
        "qa",
        "fix",
        "consistency-audit",
        "user"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "safe_to_continue": {
      "type": "boolean"
    },
    "human_decision_required": {
      "type": "boolean"
    },
    "continuation_condition": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "user_message": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "WARN"
      }
    }
  },
  "then": {
    "properties": {
      "continuation_condition": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!none$).+"
      }
    }
  },
  "additionalProperties": false
}
