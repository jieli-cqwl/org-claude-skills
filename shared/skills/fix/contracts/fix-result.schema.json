{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/fix/contracts/fix-result.schema.json",
  "description": "Fix result contract. Records root-cause diagnosis, failure classification, RED/GREEN evidence, and regression proof after review or QA returns a fixable failure.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "fix-result"
        },
        "trigger_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "completion_status": {
          "type": "string",
          "enum": [
            "FIXED",
            "BLOCKED",
            "ESCALATED"
          ]
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "issue_id",
              "failure_class",
              "root_cause_ref",
              "diagnosis_evidence",
              "fix_summary",
              "impact_files"
            ],
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 1
              },
              "failure_class": {
                "type": "string",
                "enum": [
                  "FIXABLE",
                  "DESIGN_ISSUE",
                  "ENV_ISSUE",
                  "REQUIREMENT_AMBIGUITY"
                ]
              },
              "root_cause_ref": {
                "type": "string",
                "minLength": 1
              },
              "diagnosis_evidence": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "fix_summary": {
                "type": "string"
              },
              "impact_files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "red_green_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command",
              "red_status",
              "green_status"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "red_status": {
                "type": "string",
                "enum": [
                  "FAILED_AS_EXPECTED",
                  "NOT_APPLICABLE"
                ]
              },
              "green_status": {
                "type": "string",
                "enum": [
                  "PASSED",
                  "NOT_RUN"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "regression_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "command",
              "status"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "artifact_type",
        "active_plan_version_ref",
        "active_tasks_version_ref",
        "trigger_refs",
        "attempt",
        "completion_status",
        "issues",
        "red_green_evidence",
        "regression_evidence"
      ],
      "additionalProperties": true
    }
  ]
}
