  "interface_boundary": [
    "前端 (UNIT-1) -> IF-LOGIN -> MOD-AUTH-API: 提交账号密码获取会话 Cookie",
    "前端 (UNIT-1/4) -> IF-LOGOUT -> MOD-AUTH-API: 主动登出",
    "任意受保护路由 -> IF-SESSION-VALIDATE -> MOD-SESSION: 中间件校验会话并附加 user 上下文"
  ],
  "modules": [
    {
      "module_id": "MOD-FRONTEND-LOGIN",
      "name": "前端登录表单",
      "responsibility": "渲染登录表单、前端校验、调用 IF-LOGIN 并处理错误展示；主动登出时调用 IF-LOGOUT",
      "data_owner": "无（无状态组件，会话由 Cookie 承载）",
      "unit_refs": [
        "UNIT-1"
      ]
    },
    {
      "module_id": "MOD-AUTH-API",
      "name": "认证接口服务",
      "responsibility": "实现 IF-LOGIN 和 IF-LOGOUT，协调 bcrypt 密码校验、Redis 会话创建/失效和统一错误响应",
      "data_owner": "users.password_hash 字段（新增）",
      "unit_refs": [
        "UNIT-2",
        "UNIT-4"
      ]
    },
    {
      "module_id": "MOD-SESSION",
      "name": "会话管理",
      "responsibility": "实现 IF-SESSION-VALIDATE，管理 Redis 会话 CRUD 和 TTL 刷新",
      "data_owner": "Redis key session:{uuid}",
      "unit_refs": [
        "UNIT-3"
      ]
    }
  ],
  "data_architecture": {
    "storage_decisions": [
      "users 表新增 password_hash VARCHAR(60) NOT NULL DEFAULT '' 字段，存量用户留空不参与登录（Phase 2 再处理）",
      "Redis 使用 key=session:{uuid} 存 JSON {user_id, role, issued_at}，TTL=1800 秒滑动过期"
    ],
    "data_flows": [
      "登录：前端 -> IF-LOGIN -> bcrypt 校验 -> Redis SET session:{uuid} EX 1800 -> Set-Cookie 返回",
      "受保护请求：前端 -> IF-SESSION-VALIDATE -> Redis GET+EXPIRE 刷新 -> 放行",
      "登出：前端 -> IF-LOGOUT -> Redis DEL session:{uuid} -> Set-Cookie Max-Age=0"
    ],
    "consistency_strategy": "会话 TTL 由 Redis 单点负责，登出必须先 DEL 再下发 Cookie，保证旧 Cookie 立刻失效；密码 hash 一次写入不可逆。"
  },
