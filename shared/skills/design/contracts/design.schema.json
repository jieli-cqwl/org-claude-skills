{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/design/contracts/design.schema.json",
  "description": "Design contract. Stores implementation-relevant architecture decisions without runtime verdict state.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "description": "artifact 标识，固定为 design",
          "const": "design"
        },
        "input_analysis": {
          "description": "输入分析：产品基线（brief/phase-prd/UNIT）、关键约束、系统事实、复杂度模型、未决设计问题和来源摘要",
          "type": "string",
          "minLength": 1
        },
        "key_decisions": {
          "description": "冻结的关键架构决策；每项关联同 decision_ref 的候选方案、事实锚点、失效条件和用户确认",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "decision_id",
              "decision_state",
              "option_ref",
              "fact_refs"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_state": {
                "type": "string",
                "enum": [
                  "已冻结"
                ]
              },
              "option_ref": {
                "type": "string",
                "minLength": 1
              },
              "fact_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "option_analysis": {
          "description": "候选方案分析；同一 decision_id 下至少 2 个本质不同方案的取舍和事实锚点",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "option_id",
              "decision_ref",
              "decision_status",
              "evaluation",
              "fact_refs"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1
              },
              "decision_status": {
                "type": "string",
                "enum": [
                  "SELECTED",
                  "REJECTED"
                ]
              },
              "evaluation": {
                "type": "object",
                "required": [
                  "fit",
                  "cost",
                  "risk"
                ],
                "properties": {
                  "fit": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  },
                  "cost": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  },
                  "risk": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "fact_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "runtime_facts": {
          "description": "会影响架构决策的运行时或代码事实；每条包含 evidence= 和 observed_at=。纯代码重构时写一条「运行时采证不适用：<理由>；evidence=<代码位置>；observed_at=<时间>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "evidence="
              },
              {
                "pattern": "observed_at="
              }
            ]
          }
        },
        "interfaces": {
          "description": "结构化接口契约；每个接口包含 input_params / output_params / error_codes / boundary_behaviors。无接口变更时允许空数组，并用 interface_boundary 写明沿用的现有契约",
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "interface_id",
              "owner",
              "error_modes",
              "input_params",
              "output_params",
              "error_codes",
              "boundary_behaviors"
            ],
            "properties": {
              "interface_id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "error_modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "input_params": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "required",
                    "validation",
                    "description"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "validation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "output_params": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "description"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "error_codes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "condition",
                    "user_message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "condition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "user_message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "boundary_behaviors": {
                "description": "Behavioral edge cases that /test-design and implementation must preserve, such as permission, idempotency, concurrency, state transition, timeout, retry, or degraded-mode behavior.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "behavior_type",
                    "trigger_ref",
                    "expected_outcome",
                    "verification_ref"
                  ],
                  "properties": {
                    "behavior_type": {
                      "type": "string",
                      "enum": [
                        "permission",
                        "validation",
                        "idempotency",
                        "state_transition",
                        "timeout",
                        "retry",
                        "degraded_mode",
                        "success",
                        "not_found",
                        "security"
                      ]
                    },
                    "trigger_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_outcome": {
                      "type": "string",
                      "enum": [
                        "ALLOW",
                        "BLOCK",
                        "REDIRECT",
                        "PERSIST",
                        "RETURN_ERROR",
                        "NOOP",
                        "EXPIRE_SESSION",
                        "RENDER"
                      ]
                    },
                    "verification_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          }
        },
        "interface_boundary": {
          "description": "接口边界声明；无新增或变更接口时写明沿用的现有契约和对应 UNIT/AC",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_attributes": {
          "description": "质量属性排序；每项包含优先级、关键场景、目标指标、取舍点和 verification_refs",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "attribute",
              "priority",
              "scenario_refs",
              "target_metrics",
              "verification_refs"
            ],
            "properties": {
              "attribute": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "minLength": 1
              },
              "scenario_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "target_metrics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "metric_id",
                    "metric_name",
                    "threshold",
                    "unit"
                  ],
                  "properties": {
                    "metric_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "metric_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "threshold": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "modules": {
          "description": "模块划分；每个模块包含职责、数据所有者和 unit_refs",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "module_id",
              "name",
              "responsibility",
              "data_owner",
              "unit_refs"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "responsibility": {
                "type": "string",
                "minLength": 1
              },
              "data_owner": {
                "type": "string",
                "minLength": 1
              },
              "unit_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "data_architecture": {
          "description": "数据架构：storage_decisions、data_flows、consistency_strategy",
          "type": "object",
          "required": [
            "storage_decisions",
            "data_flows",
            "consistency_strategy"
          ],
          "properties": {
            "storage_decisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "data_flows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "consistency_strategy": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "cross_cutting_concerns": {
          "description": "横切关注点；固定覆盖 auth/error/log/config 四项，每项给 decision 和 verification_refs；不适用场景 decision 写「沿用现有方案：<引用>」",
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "concern",
              "decision_ref",
              "owner",
              "verification_refs"
            ],
            "properties": {
              "concern": {
                "type": "string",
                "enum": [
                  "auth",
                  "error",
                  "log",
                  "config"
                ]
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "verification_mapping": {
          "description": "验证映射；每条 Manager VP 或 exit condition 对应下游可消费的 evidence_ref，测试义务由 test-design 结构化承接",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "manager_vp_ref",
              "evidence_ref"
            ],
            "properties": {
              "manager_vp_ref": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "unit_coverage": {
          "description": "UNIT/AC 覆盖；每个 unit_id 关联 ac_refs 和 design_refs",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "unit_id",
              "ac_refs",
              "design_refs"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "ac_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "design_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "impact_scope": {
          "description": "影响范围；每项包含 affected_modules 和 verification_refs。无其他模块影响时写一条「scope_item_id=IS-NONE；impact=仅新增，无其他模块影响：<理由>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "scope_item_id",
              "affected_modules",
              "impact_type",
              "required_action",
              "verification_refs"
            ],
            "properties": {
              "scope_item_id": {
                "type": "string",
                "minLength": 1
              },
              "affected_modules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "impact_type": {
                "type": "string",
                "enum": [
                  "ADD",
                  "CHANGE",
                  "REMOVE",
                  "NONE"
                ]
              },
              "required_action": {
                "type": "string",
                "enum": [
                  "IMPLEMENT",
                  "VERIFY",
                  "MONITOR",
                  "NONE"
                ]
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "planning_constraints": {
          "description": "待计划约束；交给 /tech-lead 承接的执行约束。无约束时写一条「constraint_id=PC-NONE；description=本 Phase 无额外计划约束」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "constraint_id",
              "constraint_type",
              "constraint_rule",
              "enforcement_type",
              "owner"
            ],
            "properties": {
              "constraint_id": {
                "type": "string",
                "minLength": 1
              },
              "constraint_type": {
                "type": "string",
                "minLength": 1
              },
              "constraint_rule": {
                "type": "string",
                "enum": [
                  "ORDERING",
                  "REAL_DEPENDENCY",
                  "NO_MOCK_ACCEPTANCE",
                  "RELEASE_BLOCKER",
                  "NONE"
                ]
              },
              "enforcement_type": {
                "type": "string",
                "enum": [
                  "BLOCKING",
                  "SEQUENCING",
                  "VERIFICATION",
                  "RELEASE"
                ]
              },
              "owner": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "product_handoff": {
          "description": "产品承接：status、accepted_refs、open_failures",
          "type": "object",
          "required": [
            "status",
            "accepted_refs",
            "open_failures"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "accepted_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "open_failures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "risks": {
          "description": "识别的风险；每条含 severity 和 source_ref。无识别风险时写一条「risk_id=R-NONE；description=本 Phase 未识别阻断性风险；severity=none；source_ref=<分析依据>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "risk_id",
              "risk_type",
              "severity",
              "source_ref"
            ],
            "properties": {
              "risk_id": {
                "type": "string",
                "minLength": 1
              },
              "risk_type": {
                "type": "string",
                "enum": [
                  "TECHNICAL",
                  "PRODUCT",
                  "DELIVERY",
                  "SECURITY",
                  "DATA",
                  "NONE"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "NONE",
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "BLOCKING"
                ]
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "risk_response": {
          "description": "风险回应；每条对应 risks 中的 risk_id。R-NONE 的回应写「architecture_response=无需架构回应」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "risk_id",
              "response_type"
            ],
            "anyOf": [
              {
                "required": [
                  "verification_refs"
                ]
              },
              {
                "required": [
                  "escalation_owner"
                ]
              }
            ],
            "properties": {
              "risk_id": {
                "type": "string",
                "minLength": 1
              },
              "response_type": {
                "type": "string",
                "enum": [
                  "MITIGATE",
                  "ACCEPT",
                  "ESCALATE",
                  "NONE"
                ]
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "escalation_owner": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "migration_plan": {
          "description": "迁移计划：从当前状态到目标状态的路径。无迁移时写一条「无需迁移：<理由，如新建模块/新增接口，直接部署>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_plan": {
          "description": "验证计划；每条描述验证方式和通过标准",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_plan": {
          "description": "回滚计划：触发条件、回滚路径、时效要求。无回滚时写一条「无需回滚：<理由，如纯新增，异常时停止发布>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraint_inheritance_confirmation": {
          "description": "约束继承确认：Constitution / ADR / 遗留设计 / 口头约束的用户确认记录",
          "type": "object",
          "required": [
            "status",
            "confirmed_at",
            "source_refs",
            "inherited_constraints",
            "rejected_constraints"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "requires_confirmation",
                "confirmed"
              ]
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "inherited_constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rejected_constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "review_closure": {
          "description": "三视角评审收口：verdict、Reviewed Design Digest、已修正 FAIL 和 WARN 承接",
          "type": "object",
          "required": [
            "reviewed_design_digest",
            "reviewed_at",
            "reviewers",
            "resolved_failures",
            "warn_followups"
          ],
          "properties": {
            "reviewed_design_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "reviewers": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "reviewer",
                  "verdict",
                  "reviewed_design_digest",
                  "finding_refs"
                ],
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "enum": [
                      "architecture",
                      "product",
                      "test"
                    ]
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "UNREVIEWED",
                      "PASS",
                      "WARN"
                    ]
                  },
                  "reviewed_design_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "finding_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "resolved_failures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "finding_id",
                  "evidence_ref"
                ],
                "properties": {
                  "finding_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "warn_followups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "finding_id",
                  "target"
                ],
                "properties": {
                  "finding_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "final_confirmation": {
          "description": "最终确认：status=confirmed 后才能交给 /test-design",
          "type": "object",
          "required": [
            "status",
            "confirmed_by",
            "confirmed_at",
            "accepted_refs"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "requires_confirmation",
                "confirmed"
              ]
            },
            "confirmed_by": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "accepted_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "co_creation_summary": {
          "description": "设计共创确认索引；每个必需设计阶段记录确认阶段、问题焦点、用户回应摘要和决策引用。",
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": [
              "stage_id",
              "confirmation_status",
              "decision_refs",
              "evidence_refs"
            ],
            "properties": {
              "stage_id": {
                "type": "string",
                "enum": [
                  "stakeholders-and-concerns",
                  "architecture-significant-requirements",
                  "current-state-evidence",
                  "complexity-model",
                  "decision-discovery",
                  "option-tradeoff",
                  "design-synthesis"
                ]
              },
              "confirmation_status": {
                "type": "string",
                "enum": [
                  "CONFIRMED"
                ]
              },
              "decision_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "artifact_type",
        "input_analysis",
        "co_creation_summary",
        "constraint_inheritance_confirmation",
        "review_closure",
        "final_confirmation",
        "key_decisions",
        "option_analysis",
        "runtime_facts",
        "interfaces",
        "interface_boundary",
        "quality_attributes",
        "modules",
        "data_architecture",
        "cross_cutting_concerns",
        "verification_mapping",
        "unit_coverage",
        "impact_scope",
        "planning_constraints",
        "product_handoff",
        "risks",
        "risk_response",
        "migration_plan",
        "verification_plan",
        "rollback_plan"
      ],
      "additionalProperties": true
    }
  ]
