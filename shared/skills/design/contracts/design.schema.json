{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/design/contracts/design.schema.json",
  "description": "Design contract. Stores implementation-relevant architecture decisions without runtime verdict state.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "description": "artifact 标识，固定为 design",
          "const": "design"
        },
        "input_analysis": {
          "description": "S1 输入分析：产品基线（brief/phase-prd/UNIT）的关键提问、约束和用户回应摘要",
          "type": "string",
          "minLength": 1
        },
        "key_decisions": {
          "description": "S5 冻结的关键架构决策；每项关联同 decision_ref 的候选方案和用户确认",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "decision_id",
              "summary",
              "decision_state",
              "verdict",
              "option_ref",
              "fact_refs",
              "user_confirmation"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "decision_state": {
                "type": "string",
                "enum": [
                  "已冻结"
                ]
              },
              "verdict": {
                "type": "string",
                "minLength": 1
              },
              "option_ref": {
                "type": "string",
                "minLength": 1
              },
              "fact_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "user_confirmation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "option_analysis": {
          "description": "S5 候选方案分析；同一 decision_id 下至少 2 个本质不同方案的取舍和事实锚点",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "option_id",
              "decision_ref",
              "summary",
              "tradeoff",
              "verdict",
              "fact_refs"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "tradeoff": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "type": "string",
                "minLength": 1
              },
              "fact_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "runtime_facts": {
          "description": "S2 运行时采证事实；每条包含 evidence= 和 observed_at=。纯代码重构时写一条「运行时采证不适用：<理由>；evidence=<代码位置>；observed_at=<时间>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "evidence="
              },
              {
                "pattern": "observed_at="
              }
            ]
          }
        },
        "interfaces": {
          "description": "S6 结构化接口契约；每个接口包含 input_params / output_params / error_codes。无接口变更时用 interface_boundary 写明沿用的现有契约",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "interface_id",
              "owner",
              "contract_summary",
              "error_modes",
              "input_params",
              "output_params",
              "error_codes"
            ],
            "properties": {
              "interface_id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "contract_summary": {
                "type": "string",
                "minLength": 1
              },
              "error_modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "input_params": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "required",
                    "validation",
                    "description"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "validation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "output_params": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "description"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "error_codes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "condition",
                    "user_message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "condition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "user_message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "interface_boundary": {
          "description": "S6 接口边界声明；无新增或变更接口时写明沿用的现有契约和对应 UNIT/AC",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_attributes": {
          "description": "S4 质量属性排序；每项包含优先级、关键场景、目标指标、取舍点和 verification_refs",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "attribute",
              "priority",
              "key_scenarios",
              "target_metrics",
              "tradeoff_points",
              "verification_refs"
            ],
            "properties": {
              "attribute": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "minLength": 1
              },
              "key_scenarios": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "target_metrics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "tradeoff_points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "modules": {
          "description": "S6 模块划分；每个模块包含职责、数据所有者和 unit_refs",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "module_id",
              "name",
              "responsibility",
              "data_owner",
              "unit_refs"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "responsibility": {
                "type": "string",
                "minLength": 1
              },
              "data_owner": {
                "type": "string",
                "minLength": 1
              },
              "unit_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "data_architecture": {
          "description": "S6 数据架构：storage_decisions、data_flows、consistency_strategy",
          "type": "object",
          "required": [
            "summary",
            "storage_decisions",
            "data_flows",
            "consistency_strategy"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "storage_decisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "data_flows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "consistency_strategy": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "cross_cutting_concerns": {
          "description": "S6 横切关注点；固定覆盖 auth/error/log/config 四项，每项给 decision 和 verification_refs；不适用场景 decision 写「沿用现有方案：<引用>」",
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "concern",
              "decision",
              "owner",
              "verification_refs"
            ],
            "properties": {
              "concern": {
                "type": "string",
                "enum": [
                  "auth",
                  "error",
                  "log",
                  "config"
                ]
              },
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "verification_mapping": {
          "description": "S7 验证映射；每条 Manager VP 或 exit condition 对应 design_validation、test_obligation 和 evidence_ref",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "manager_vp_ref",
              "design_validation",
              "test_obligation",
              "evidence_ref"
            ],
            "properties": {
              "manager_vp_ref": {
                "type": "string",
                "minLength": 1
              },
              "design_validation": {
                "type": "string",
                "minLength": 1
              },
              "test_obligation": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "unit_coverage": {
          "description": "S6 UNIT/AC 覆盖；每个 unit_id 关联 ac_refs 和 design_refs",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "unit_id",
              "ac_refs",
              "design_refs"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "ac_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "design_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "impact_scope": {
          "description": "S7 影响范围；每项包含 affected_modules 和 verification_refs。无其他模块影响时写一条「scope_item_id=IS-NONE；impact=仅新增，无其他模块影响：<理由>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "scope_item_id",
              "affected_modules",
              "impact",
              "verification_refs"
            ],
            "properties": {
              "scope_item_id": {
                "type": "string",
                "minLength": 1
              },
              "affected_modules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "planning_constraints": {
          "description": "S7 待计划约束；交给 /tech-lead 承接的执行约束。无约束时写一条「constraint_id=PC-NONE；description=本 Phase 无额外计划约束」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "constraint_id",
              "constraint_type",
              "description",
              "owner"
            ],
            "properties": {
              "constraint_id": {
                "type": "string",
                "minLength": 1
              },
              "constraint_type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "product_handoff": {
          "description": "S8 产品承接：status、accepted_refs、open_failures、warn_followups",
          "type": "object",
          "required": [
            "status",
            "accepted_refs",
            "open_failures",
            "warn_followups"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "accepted_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "open_failures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warn_followups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "risks": {
          "description": "S7 识别的风险；每条含 severity 和 source_ref。无识别风险时写一条「risk_id=R-NONE；description=本 Phase 未识别阻断性风险；severity=none；source_ref=<分析依据>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "risk_id",
              "description",
              "severity",
              "source_ref"
            ],
            "properties": {
              "risk_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "risk_response": {
          "description": "S7 风险回应；每条对应 risks 中的 risk_id。R-NONE 的回应写「architecture_response=无需架构回应」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "risk_id",
              "architecture_response"
            ],
            "anyOf": [
              {
                "required": [
                  "verification_refs"
                ]
              },
              {
                "required": [
                  "escalation_path"
                ]
              }
            ],
            "properties": {
              "risk_id": {
                "type": "string",
                "minLength": 1
              },
              "architecture_response": {
                "type": "string",
                "minLength": 1
              },
              "verification_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "escalation_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "migration_plan": {
          "description": "S7 迁移计划：从当前状态到目标状态的路径。无迁移时写一条「无需迁移：<理由，如新建模块/新增接口，直接部署>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_plan": {
          "description": "S7 验证计划；每条描述验证方式和通过标准",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_plan": {
          "description": "S7 回滚计划：触发条件、回滚路径、时效要求。无回滚时写一条「无需回滚：<理由，如纯新增，异常时停止发布>」",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "co_creation_summary": {
          "description": "S2-S8 每步共创摘要；stage_id / question / response / decision_refs",
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": [
              "stage_id",
              "stage_name",
              "question_or_focus",
              "user_response_summary",
              "decision_refs"
            ],
            "properties": {
              "stage_id": {
                "type": "string",
                "enum": [
                  "S2",
                  "S3",
                  "S4",
                  "S5",
                  "S6",
                  "S7",
                  "S8"
                ]
              },
              "stage_name": {
                "type": "string",
                "minLength": 1
              },
              "question_or_focus": {
                "type": "string",
                "minLength": 1
              },
              "user_response_summary": {
                "type": "string",
                "minLength": 1
              },
              "decision_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "constraint_inheritance_confirmation": {
          "description": "S3 约束继承确认：Constitution / ADR / 遗留设计 / 口头约束的用户确认记录",
          "type": "object",
          "required": [
            "status",
            "confirmed_at",
            "source_refs",
            "inherited_constraints",
            "rejected_constraints",
            "confirmation_summary"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed"
              ]
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "inherited_constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rejected_constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "confirmation_summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "review_closure": {
          "description": "S10 三视角评审收口：verdict、Reviewed Design Digest、已修正 FAIL 和 WARN 承接",
          "type": "object",
          "required": [
            "reviewed_design_digest",
            "reviewed_at",
            "reviewers",
            "resolved_failures",
            "warn_followups"
          ],
          "properties": {
            "reviewed_design_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "reviewers": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "reviewer",
                  "verdict",
                  "reviewed_design_digest",
                  "finding_refs"
                ],
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "enum": [
                      "architecture",
                      "product",
                      "test"
                    ]
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "WARN"
                    ]
                  },
                  "reviewed_design_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "finding_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "resolved_failures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "finding_id",
                  "evidence_ref"
                ],
                "properties": {
                  "finding_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "warn_followups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "finding_id",
                  "target",
                  "summary"
                ],
                "properties": {
                  "finding_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
