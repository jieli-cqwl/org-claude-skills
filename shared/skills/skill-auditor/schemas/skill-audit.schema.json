{
  "schema_version": "1.0.0",
  "artifact_type": "skill-audit",
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "producer",
    "inputs",
    "status",
    "design_anchors",
    "evidence_refs",
    "rendered_views",
    "target_skill",
    "scope",
    "findings",
    "permission_profile",
    "reference_contracts"
  ],
  "properties": {
    "artifact_type": {"type": "string", "const": "skill-audit"},
    "schema_version": {"type": "string"},
    "artifact_id": {"type": "string"},
    "producer": {"type": "object"},
    "inputs": {"type": "array"},
    "status": {"type": "string", "enum": ["draft", "audited", "planned", "implemented", "verified", "blocked"]},
    "design_anchors": {"type": "array"},
    "evidence_refs": {"type": "array"},
    "rendered_views": {"type": "array"},
    "target_skill": {"type": "object"},
    "scope": {"type": "object"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "dimension",
          "evidence_level",
          "source_marker",
          "file_ref",
          "design_anchors",
          "evidence_refs",
          "impact",
          "recommendation",
          "verification"
        ],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["FAIL", "WARN", "INFO"]},
          "dimension": {"type": "string", "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8"]},
          "evidence_level": {"type": "string"},
          "source_marker": {"type": "string"},
          "file_ref": {"type": "string"},
          "design_anchors": {"type": "array", "minItems": 1},
          "evidence_refs": {"type": "array", "minItems": 1},
          "impact": {"type": "string"},
          "recommendation": {"type": "string"},
          "verification": {"type": "string"}
        }
      }
    },
    "permission_profile": {"type": "object"},
    "reference_contracts": {"type": "array"}
  }
}
