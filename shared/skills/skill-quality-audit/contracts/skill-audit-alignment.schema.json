{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Audit Alignment",
  "type": "object",
  "required": [
    "artifact_type",
    "stage",
    "target_skill",
    "capability_effectiveness_standard",
    "target_capability_claims",
    "current_capability_profile",
    "evidence",
    "assumptions_or_unknowns",
    "capability_match_draft",
    "user_confirmation"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "skill-audit-alignment"
    },
    "stage": {
      "enum": ["awaiting_user_confirmation", "confirmed"]
    },
    "target_skill": {
      "type": "string",
      "minLength": 1
    },
    "capability_effectiveness_standard": {
      "type": "object",
      "required": [
        "standard_id",
        "co_creation_status",
        "confirmed_by",
        "decision_surface_ref",
        "target_capability_ids",
        "real_task_scenarios",
        "success_criteria",
        "failure_modes",
        "unacceptable_risks",
        "evidence_requirements",
        "confirmation_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "standard_id": {
          "type": "string",
          "minLength": 1
        },
        "co_creation_status": {
          "enum": ["pending_user_confirmation", "confirmed_with_user", "blocked"]
        },
        "confirmed_by": {
          "type": "string",
          "minLength": 1
        },
        "decision_surface_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_capability_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "real_task_scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unacceptable_risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confirmation_evidence": {
          "type": "object",
          "required": ["status", "ref", "claim"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["pending_user_confirmation", "recorded_user_confirmation", "blocked"]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "expected_snippet": {
              "type": "string",
              "minLength": 1
            },
            "claim": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "target_capability_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_capability_id", "label", "source", "confidence", "refs"],
        "additionalProperties": false,
        "properties": {
          "target_capability_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": ["user_supplied", "repo_contract", "declared_claim", "inferred"]
          },
          "confidence": {
            "enum": ["high", "medium", "low"]
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "current_capability_profile": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["current_capability_id", "label", "status", "evidence_refs"],
        "additionalProperties": false,
        "properties": {
          "current_capability_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["supported", "absent", "blocked"]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["evidence_id", "type", "path", "line", "expected_snippet", "claim"],
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "path_line"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "expected_snippet": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": ["evidence_id", "type", "ref", "claim"],
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": ["command", "schema", "script", "test", "runtime", "user_scope"]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "assumptions_or_unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "label", "status", "refs"],
        "additionalProperties": false,
        "properties": {
          "assumption_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["open", "accepted", "blocked"]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "capability_match_draft": {
      "type": "object",
      "required": ["gaps"],
      "additionalProperties": false,
      "properties": {
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gap_id", "target_capability_id", "current_capability_ids", "status", "evidence_refs"],
            "additionalProperties": false,
            "properties": {
              "gap_id": {
                "type": "string",
                "minLength": 1
              },
              "target_capability_id": {
                "type": "string",
                "minLength": 1
              },
              "current_capability_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": ["matched", "partial", "missing", "blocked"]
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "user_confirmation": {
      "type": "object",
      "required": [
        "level",
        "status",
        "confirmed_scope_ref",
        "confirmed_target_capability_ids",
        "accepted_assumption_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": ["G0", "G1", "G2", "G3"]
        },
        "status": {
          "enum": ["pending", "confirmed", "skipped", "blocked"]
        },
        "confirmed_scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_target_capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accepted_assumption_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
