{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/delivery-owner/contracts/artifact-registry.schema.json",
  "description": "Artifact registry contract. Resolves canonical refs to physical paths via append-only revisions.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "artifact-registry"
        },
        "scope_ref": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
        },
        "registry_revision": {
          "type": "string"
        },
        "active_revision_id": {
          "type": "string"
        },
        "runtime_artifact_policy": {
          "type": "object",
          "required": [
            "active_uniqueness",
            "required_runtime_artifacts",
            "owner_responsibility"
          ],
          "properties": {
            "active_uniqueness": {
              "const": "one_active_entry_per_scope_artifact_type"
            },
            "required_runtime_artifacts": {
              "type": "array",
              "items": {
                "enum": [
                  "developer-report",
                  "verify-result",
                  "code-review-result",
                  "qa-result",
                  "consistency-audit-result"
                ]
              },
              "uniqueItems": true
            },
            "owner_responsibility": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/registryRevision"
          }
        }
      },
      "required": [
        "artifact_type",
        "scope_ref",
        "registry_revision",
        "active_revision_id",
        "revisions"
      ],
      "additionalProperties": true
    }
  ]
}
