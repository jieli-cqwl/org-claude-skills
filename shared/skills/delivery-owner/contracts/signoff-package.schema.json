{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/delivery-owner/contracts/signoff-package.schema.json",
  "description": "Signoff package contract. Carries phase-level signoff, goal closure, and waiver state against baseline and active refs.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "signoff-package"
        },
        "current_stage": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/current_stage"
        },
        "release_recommendation": {
          "type": "string"
        },
        "sign_off_status": {
          "type": "string"
        },
        "business_risk_acceptance_status": {
          "type": "string"
        },
        "goal_closure": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/goalClosureEntry"
              },
              {
                "type": "object",
                "properties": {
                  "execution_basis_ref": {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
                  },
                  "evidence_ref": {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
                  }
                },
                "required": [
                  "execution_basis_ref",
                  "evidence_ref"
                ]
              }
            ]
          }
        },
        "waiver_entries": {
          "type": "array",
          "items": {
            "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/waiverEntry"
          }
        },
        "last_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "active_blocker": {
          "type": "string"
        },
        "blocker_owner": {
          "type": "string"
        },
        "decision_basis_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "runtime_evidence_matrix": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "artifact_type": {
                "type": "string",
                "enum": [
                  "developer-report",
                  "verify-result",
                  "code-review-result",
                  "qa-result",
                  "consistency-audit-result"
                ]
              },
              "artifact_ref": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
              },
              "producer": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "freshness_basis_ref": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
              },
              "active_registry_proof": {
                "type": "object",
                "properties": {
                  "registry_ref": {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
                  },
                  "lifecycle_state": {
                    "const": "FINALIZED"
                  },
                  "active_for_consumption": {
                    "const": true
                  }
                },
                "required": [
                  "registry_ref",
                  "lifecycle_state",
                  "active_for_consumption"
                ],
                "additionalProperties": false
              },
              "stale_superseded_check": {
                "type": "string",
                "enum": [
                  "CURRENT",
                  "STALE",
                  "SUPERSEDED"
                ]
              }
            },
            "required": [
              "artifact_type",
              "artifact_ref",
              "producer",
              "status",
              "freshness_basis_ref",
              "active_registry_proof",
              "stale_superseded_check"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "artifact_type",
        "current_stage",
        "release_recommendation",
        "sign_off_status",
        "business_risk_acceptance_status",
        "goal_closure",
        "waiver_entries",
        "last_observed_at",
        "active_blocker",
        "blocker_owner",
        "decision_basis_refs",
        "runtime_evidence_matrix",
        "baseline_tasks_version_ref",
        "active_tasks_version_ref"
      ],
      "not": {
        "required": [
          "runtime_snapshot"
        ]
      },
      "additionalProperties": true
    }
  ]
}
