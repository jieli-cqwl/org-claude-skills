{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/delivery-owner/contracts/target-change.schema.json",
  "description": "Target-change contract. Records scope, AC, goal, task, or design changes that invalidate runtime evidence and require rebaseline.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "target-change"
        },
        "changed_target_type": {
          "type": "string",
          "enum": [
            "GOAL",
            "SCOPE",
            "AC",
            "TASKS",
            "DESIGN"
          ]
        },
        "change_source": {
          "type": "string",
          "enum": [
            "authenticated-target-change"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "affected_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "invalidates_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "superseded_evidence_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "rebaseline_required": {
          "const": true
        },
        "rebaseline_owner": {
          "type": "string",
          "enum": [
            "product-director",
            "product-manager",
            "tech-lead",
            "design",
            "test-design",
            "delivery-owner"
          ]
        },
        "required_fresh_proof_after_rebaseline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "brief",
              "phase-prd",
              "unit-definition",
              "design",
              "plan",
              "tasks",
              "test-cases",
              "developer-report",
              "verify-result",
              "code-review-result",
              "qa-result",
              "consistency-audit-result",
              "fix-result"
            ]
          },
          "uniqueItems": true
        },
        "authority_proof_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "decision_basis_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "target_change_payload_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_type",
        "baseline_tasks_version_ref",
        "active_tasks_version_ref",
        "changed_target_type",
        "change_source",
        "actor_id",
        "affected_refs",
        "invalidates_refs",
        "superseded_evidence_refs",
        "rebaseline_required",
        "rebaseline_owner",
        "required_fresh_proof_after_rebaseline",
        "authority_proof_refs",
        "decision_basis_refs",
        "target_change_payload_digest"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "decision"
            ]
          },
          {
            "required": [
              "sign_off_status"
            ]
          },
          {
            "required": [
              "business_risk_acceptance_status"
            ]
          },
          {
            "required": [
              "director_lock_digests"
            ]
          },
          {
            "required": [
              "decision_payload_digest"
            ]
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "changed_target_type": {
                "const": "GOAL"
              }
            },
            "required": [
              "changed_target_type"
            ]
          },
          "then": {
            "properties": {
              "rebaseline_owner": {
                "const": "product-director"
              },
              "required_fresh_proof_after_rebaseline": {
                "allOf": [
                  {
                    "contains": {
                      "const": "brief"
                    }
                  },
                  {
                    "contains": {
                      "const": "brief"
                    }
                  },
                  {
                    "contains": {
                      "const": "phase-prd"
                    }
                  },
                  {
                    "contains": {
                      "const": "unit-definition"
                    }
                  },
                  {
                    "contains": {
                      "const": "design"
                    }
                  },
                  {
                    "contains": {
                      "const": "test-cases"
                    }
                  },
                  {
                    "contains": {
                      "const": "plan"
                    }
                  },
                  {
                    "contains": {
                      "const": "tasks"
                    }
                  },
                  {
                    "contains": {
                      "const": "developer-report"
                    }
                  },
                  {
                    "contains": {
                      "const": "verify-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "code-review-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "qa-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "consistency-audit-result"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "changed_target_type": {
                "enum": [
                  "SCOPE",
                  "AC"
                ]
              }
            },
            "required": [
              "changed_target_type"
            ]
          },
          "then": {
            "properties": {
              "rebaseline_owner": {
                "const": "product-manager"
              },
              "required_fresh_proof_after_rebaseline": {
                "allOf": [
                  {
                    "contains": {
                      "const": "brief"
                    }
                  },
                  {
                    "contains": {
                      "const": "phase-prd"
                    }
                  },
                  {
                    "contains": {
                      "const": "unit-definition"
                    }
                  },
                  {
                    "contains": {
                      "const": "design"
                    }
                  },
                  {
                    "contains": {
                      "const": "test-cases"
                    }
                  },
                  {
                    "contains": {
                      "const": "plan"
                    }
                  },
                  {
                    "contains": {
                      "const": "tasks"
                    }
                  },
                  {
                    "contains": {
                      "const": "developer-report"
                    }
                  },
                  {
                    "contains": {
                      "const": "verify-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "code-review-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "qa-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "consistency-audit-result"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "changed_target_type": {
                "const": "DESIGN"
              }
            },
            "required": [
              "changed_target_type"
            ]
          },
          "then": {
            "properties": {
              "rebaseline_owner": {
                "const": "design"
              },
              "required_fresh_proof_after_rebaseline": {
                "allOf": [
                  {
                    "contains": {
                      "const": "design"
                    }
                  },
                  {
                    "contains": {
                      "const": "test-cases"
                    }
                  },
                  {
                    "contains": {
                      "const": "plan"
                    }
                  },
                  {
                    "contains": {
                      "const": "tasks"
                    }
                  },
                  {
                    "contains": {
                      "const": "developer-report"
                    }
                  },
                  {
                    "contains": {
                      "const": "verify-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "code-review-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "qa-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "consistency-audit-result"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "changed_target_type": {
                "const": "TASKS"
              }
            },
            "required": [
              "changed_target_type"
            ]
          },
          "then": {
            "properties": {
              "rebaseline_owner": {
                "const": "tech-lead"
              },
              "required_fresh_proof_after_rebaseline": {
                "allOf": [
                  {
                    "contains": {
                      "const": "plan"
                    }
                  },
                  {
                    "contains": {
                      "const": "tasks"
                    }
                  },
                  {
                    "contains": {
                      "const": "developer-report"
                    }
                  },
                  {
                    "contains": {
                      "const": "verify-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "code-review-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "qa-result"
                    }
                  },
                  {
                    "contains": {
                      "const": "consistency-audit-result"
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  ]
}
