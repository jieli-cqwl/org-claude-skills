{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/delivery-owner/contracts/target-change.schema.json",
  "description": "Target-change contract. Records scope, AC, goal, task, or design changes that invalidate runtime evidence and require rebaseline.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "target-change"
        },
        "changed_target_type": {
          "type": "string",
          "enum": [
            "GOAL",
            "SCOPE",
            "AC",
            "TASKS",
            "DESIGN"
          ]
        },
        "change_source": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "affected_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "invalidates_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "superseded_evidence_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "rebaseline_required": {
          "const": true
        },
        "rebaseline_owner": {
          "type": "string",
          "enum": [
            "product-director",
            "tech-lead",
            "design",
            "test-design",
            "delivery-owner"
          ]
        },
        "required_fresh_proof_after_rebaseline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "phase-prd",
              "design",
              "plan",
              "tasks",
              "test-cases",
              "developer-report",
              "verify-result",
              "code-review-result",
              "qa-result",
              "consistency-audit-result"
            ]
          },
          "uniqueItems": true
        },
        "authority_proof_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "decision_basis_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        }
      },
      "required": [
        "artifact_type",
        "baseline_tasks_version_ref",
        "active_tasks_version_ref",
        "changed_target_type",
        "change_source",
        "actor_id",
        "affected_refs",
        "invalidates_refs",
        "superseded_evidence_refs",
        "rebaseline_required",
        "rebaseline_owner",
        "required_fresh_proof_after_rebaseline",
        "authority_proof_refs",
        "decision_basis_refs"
      ],
      "additionalProperties": true
    }
  ]
}
