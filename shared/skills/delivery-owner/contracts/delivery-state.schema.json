{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/delivery-owner/contracts/delivery-state.schema.json",
  "description": "Phase runtime state contract. This is the authoritative phase-stage source and task runtime state holder.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "delivery-state"
        },
        "current_stage": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "control_action": {
          "type": "string"
        },
        "summary_text": {
          "type": "string"
        },
        "last_control_decision": {
          "type": "object",
          "properties": {
            "decision_ref": {
              "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
            },
            "task_ref": {
              "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
            },
            "owner": {
              "type": "string"
            },
            "gap_id": {
              "type": "string"
            },
            "increment_effect": {
              "type": "string"
            },
            "remaining_gap_ids": {
              "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/stringArray"
            },
            "evidence_refs": {
              "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
            }
          },
          "required": [
            "decision_ref",
            "task_ref",
            "owner",
            "gap_id",
            "increment_effect",
            "remaining_gap_ids",
            "evidence_refs"
          ],
          "additionalProperties": false
        },
        "kickoff": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "READY",
                "WAIVED",
                "BLOCKED"
              ]
            },
            "plan_version_ref": {
              "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
            },
            "preflight_evidence_ref": {
              "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
            },
            "environment_ready": {
              "type": "boolean"
            },
            "dependency_ready": {
              "type": "boolean"
            },
            "risk_owner_ready": {
              "type": "boolean"
            },
            "qa_handoff_ready": {
              "type": "boolean"
            },
            "readiness_waiver": {
              "type": "object",
              "properties": {
                "waiver_id": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "compensation_control": {
                  "type": "string"
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "user_confirmation_ref": {
                  "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
                }
              },
              "required": [
                "waiver_id",
                "owner",
                "reason",
                "compensation_control",
                "expires_at",
                "user_confirmation_ref"
              ],
              "additionalProperties": false
            },
            "blocking_reason": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "plan_version_ref",
            "preflight_evidence_ref",
            "environment_ready",
            "dependency_ready",
            "risk_owner_ready",
            "qa_handoff_ready",
            "blocking_reason"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/taskRuntimeEntry"
          }
        },
        "blocker_id": {
          "type": "string"
        },
        "blocker_reason_code": {
          "type": "string"
        },
        "blocker_basis_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "blocker_resolution_evidence_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "unblocked_by_ref": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
        }
      },
      "required": [
        "artifact_type",
        "current_stage",
        "status",
        "control_action",
        "summary_text",
        "kickoff",
        "tasks",
        "active_plan_version_ref",
        "active_tasks_version_ref"
      ],
      "additionalProperties": true
    }
  ]
}
