{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/delivery-owner/contracts/delivery-state.schema.json",
  "description": "Phase runtime state contract. This is the authoritative phase-stage source and task runtime state holder.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "delivery-state"
        },
        "current_stage": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/current_stage"
        },
        "status": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/runtime_status"
        },
        "control_action": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/control_action"
        },
        "summary_text": {
          "type": "string"
        },
        "kickoff": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "READY",
                "WAIVED",
                "BLOCKED"
              ]
            },
            "plan_version_ref": {
              "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
            },
            "preflight_evidence_ref": {
              "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
            },
            "environment_ready": {
              "type": "boolean"
            },
            "dependency_ready": {
              "type": "boolean"
            },
            "risk_owner_ready": {
              "type": "boolean"
            },
            "qa_handoff_ready": {
              "type": "boolean"
            },
            "readiness_waiver": {
              "type": "object",
              "properties": {
                "waiver_id": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "compensation_control": {
                  "type": "string"
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "user_confirmation_ref": {
                  "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
                }
              },
              "required": [
                "waiver_id",
                "owner",
                "reason",
                "compensation_control",
                "expires_at",
                "user_confirmation_ref"
              ],
              "additionalProperties": false
            },
            "blocking_reason": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "plan_version_ref",
            "preflight_evidence_ref",
            "environment_ready",
            "dependency_ready",
            "risk_owner_ready",
            "qa_handoff_ready",
            "blocking_reason"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/taskRuntimeEntry"
          }
        },
        "progress_signal": {
          "type": "string",
          "enum": [
            "gap_closed",
            "gap_narrowed",
            "gap_judgment_changed",
            "new_blocker",
            "new_risk",
            "authoritative_owner_routed",
            "no_progress"
          ]
        },
        "consecutive_no_progress_count": {
          "type": "integer",
          "minimum": 0
        },
        "owner_action_consumption": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "required_owner": {
                "type": "string",
                "minLength": 1
              },
              "routed_to": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "enum": [
                  "ROUTED",
                  "OWNER_ACCEPTED",
                  "OWNER_RESOLVED",
                  "USER_DECISION_REQUESTED",
                  "REBASELINE_REQUIRED",
                  "BLOCKED"
                ]
              },
              "evidence_ref": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
              },
              "state_update": {
                "type": "object",
                "properties": {
                  "current_stage": {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/current_stage"
                  },
                  "status": {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/runtime_status"
                  },
                  "control_action": {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/control_action"
                  },
                  "next_action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resume_condition": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "current_stage",
                  "status",
                  "control_action",
                  "next_action",
                  "resume_condition"
                ],
                "additionalProperties": false
              },
              "reopen_condition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action_id",
              "required_owner",
              "routed_to",
              "result",
              "evidence_ref",
              "state_update",
              "reopen_condition"
            ],
            "additionalProperties": false
          }
        },
        "blocker_id": {
          "type": "string",
          "minLength": 1
        },
        "blocker_owner": {
          "type": "string",
          "minLength": 1
        },
        "blocked_from_stage": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/blocked_from_stage"
        },
        "resume_stage": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/resume_stage"
        },
        "blocker_reason_code": {
          "type": "string",
          "minLength": 1
        },
        "blocker_basis_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray",
          "minItems": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "resume_condition": {
          "type": "string",
          "minLength": 1
        },
        "blocker_resolution_evidence_refs": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
        },
        "unblocked_by_ref": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
        }
      },
      "required": [
        "artifact_type",
        "current_stage",
        "status",
        "control_action",
        "summary_text",
        "kickoff",
        "tasks",
        "active_tasks_version_ref"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "current_stage"
            ],
            "properties": {
              "current_stage": {
                "const": "BLOCKED"
              }
            }
          },
          "then": {
            "required": [
              "blocker_id",
              "blocker_owner",
              "blocker_basis_refs",
              "resume_stage",
              "next_action",
              "resume_condition"
            ]
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "BLOCKED"
              }
            }
          },
          "then": {
            "required": [
              "blocker_id",
              "blocker_owner",
              "blocker_basis_refs",
              "resume_stage",
              "next_action",
              "resume_condition"
            ]
          }
        },
        {
          "if": {
            "required": [
              "control_action"
            ],
            "properties": {
              "control_action": {
                "enum": [
                  "BLOCK",
                  "REQUEST_DECISION"
                ]
              }
            }
          },
          "then": {
            "required": [
              "blocker_id",
              "blocker_owner",
              "blocker_basis_refs",
              "resume_stage",
              "next_action",
              "resume_condition"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  ]
}
