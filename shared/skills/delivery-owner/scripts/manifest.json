{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "intake-preflight-check",
      "path": "scripts/intake_preflight_check.sh",
      "owner": "delivery-owner",
      "allowed_args": ["--phase-dir", "--output", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3", "cat", "dirname", "pwd"],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": ["$TMPDIR", "/tmp", "docs", "tests/fixtures"],
      "allowed_input_roots": ["docs", "tests/fixtures", "shared/skills/delivery-owner"],
      "failure_state": "DELIVERY_OWNER_INTAKE_PREFLIGHT_FAILED",
      "failure_message": "delivery-owner intake preflight failed",
      "exit_code_meanings": {
        "0": "intake preflight passed or help displayed",
        "1": "intake preflight blocked or invalid invocation"
      },
      "shell_parameter_strategy": "argv only; no shell interpolation",
      "verification_command": "bash tests/test-delivery-owner-control-contract.sh"
    },
    {
      "id": "task-packet-check",
      "path": "scripts/task_packet_check.sh",
      "owner": "delivery-owner",
      "allowed_args": ["--packet", "--output", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3", "cat", "dirname", "pwd"],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": ["$TMPDIR", "/tmp", "docs", "tests/fixtures"],
      "allowed_input_roots": ["docs", "tests/fixtures", "shared/skills/delivery-owner"],
      "failure_state": "DELIVERY_OWNER_TASK_PACKET_FAILED",
      "failure_message": "delivery-owner task packet validation failed",
      "exit_code_meanings": {
        "0": "task packet passed or help displayed",
        "1": "task packet blocked or invalid invocation"
      },
      "shell_parameter_strategy": "argv only; no shell interpolation",
      "verification_command": "bash tests/test-delivery-owner-control-contract.sh"
    },
    {
      "id": "control-decision-check",
      "path": "scripts/control_decision_check.sh",
      "owner": "delivery-owner",
      "allowed_args": ["--decision", "--output", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3", "cat", "dirname", "pwd"],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": ["$TMPDIR", "/tmp", "docs", "tests/fixtures"],
      "allowed_input_roots": ["docs", "tests/fixtures", "shared/skills/delivery-owner"],
      "failure_state": "DELIVERY_OWNER_CONTROL_DECISION_FAILED",
      "failure_message": "delivery-owner control decision validation failed",
      "exit_code_meanings": {
        "0": "control decision passed or help displayed",
        "1": "control decision blocked or invalid invocation"
      },
      "shell_parameter_strategy": "argv only; no shell interpolation",
      "verification_command": "bash tests/test-delivery-owner-control-contract.sh"
    },
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "delivery-owner",
      "allowed_args": ["hook payload via stdin only", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3", "grep", "awk", "sed", "sort", "uniq", "wc", "jq", "date", "shasum", "sha256sum", "find", "cat", "dirname", "pwd"],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": ["$TMPDIR", "/tmp"],
      "failure_state": "DELIVERY_OWNER_COMPLETION_GATE_FAILED",
      "failure_message": "delivery-owner readiness gate failed",
      "exit_code_meanings": {
        "0": "hook decision emitted; decision may be allow or block",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail-closed block decision emitted"
      },
      "shell_parameter_strategy": "argv only; hook payload via stdin only",
      "verification_command": "bash tests/test-delivery-owner-contract-closure.sh"
    }
  ]
}
