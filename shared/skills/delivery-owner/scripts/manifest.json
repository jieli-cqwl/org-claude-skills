{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "input-readiness-check",
      "path": "scripts/input_readiness_check.sh",
      "owner": "delivery-owner",
      "allowed_args": ["--phase-dir", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3", "cat", "dirname", "pwd"],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": ["$TMPDIR", "/tmp"],
      "allowed_input_roots": [
        "docs",
        "tests/fixtures",
        "contracts/canonical",
        "shared/skills/delivery-owner",
        "tools/community"
      ],
      "failure_state": "DELIVERY_OWNER_INPUT_READINESS_FAILED",
      "failure_message": "delivery-owner input readiness failed",
      "exit_code_meanings": {
        "0": "input readiness passed or help displayed",
        "1": "input readiness blocked or invalid invocation"
      },
      "shell_parameter_strategy": "argv only; no shell interpolation",
      "verification_command": "bash tests/test-delivery-owner-input-readiness.sh"
    },
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "delivery-owner",
      "allowed_args": ["hook payload via stdin only", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3", "grep", "awk", "sed", "sort", "uniq", "wc", "jq", "date", "shasum", "sha256sum", "find", "cat", "dirname", "pwd"],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": ["$TMPDIR", "/tmp"],
      "failure_state": "DELIVERY_OWNER_COMPLETION_GATE_FAILED",
      "failure_message": "delivery-owner completion gate failed",
      "exit_code_meanings": {
        "0": "hook decision emitted; decision may be allow or block",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail closed block decision emitted"
      },
      "shell_parameter_strategy": "argv only; hook payload via stdin only; no shell interpolation",
      "verification_command": "bash tests/test-delivery-owner-gate-contract.sh"
    },
    {
      "id": "commit-preflight-check",
      "path": "scripts/commit_preflight_check.sh",
      "owner": "delivery-owner",
      "allowed_args": ["--phase-dir", "--repo-root", "--allowed-path", "--expected-head", "--message", "--output", "--allow-main", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3", "git", "cat", "dirname", "pwd"],
      "timeout_seconds": 30,
      "output_limit_bytes": 131072,
      "output_root": "$PHASE_DIR|$TMPDIR|/tmp",
      "allowed_output_roots": ["docs", "tests/fixtures", "$TMPDIR", "/tmp"],
      "allowed_input_roots": ["docs", "tests/fixtures", "tools/community"],
      "failure_state": "DELIVERY_OWNER_COMMIT_PREFLIGHT_FAILED",
      "failure_message": "delivery-owner commit preflight failed",
      "exit_code_meanings": {
        "0": "commit preflight passed and handoff JSON emitted",
        "1": "commit preflight blocked or invalid invocation"
      },
      "shell_parameter_strategy": "argv only; no shell interpolation",
      "verification_command": "bash tests/test-delivery-owner-commit-preflight.sh"
    },
    {
      "id": "delivery-gate-stages",
      "path": "scripts/delivery-gate-stages.sh",
      "allowed_args": ["source from completion_check.sh or tests only"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "printf"],
      "timeout_seconds": 5,
      "output_limit_bytes": 8192,
      "allowed_output_roots": [],
      "failure_message": "delivery-owner delivery gate fixed full gate helper failed",
      "exit_code_meanings": {
        "0": "fixed full gate function returned expected stage list or boolean status",
        "1": "invalid helper invocation"
      },
      "shell_parameter_strategy": "argv only; no shell interpolation",
      "verification_command": "bash tests/test-delivery-owner-gate-contract.sh"
    }
  ]
}
