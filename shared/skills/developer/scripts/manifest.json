{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "developer",
      "allowed_args": [
        "hook payload via stdin only",
        "--help",
        "-h"
      ],
      "denied_args": [
        "--exec",
        "--shell",
        "--network",
        ";",
        "&&",
        "|"
      ],
      "external_commands": [
        "bash",
        "python3",
        "cat",
        "jq",
        "git",
        "grep",
        "sed",
        "sort",
        "dirname",
        "pwd",
        "mktemp",
        "rm"
      ],
      "timeout_seconds": 30,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": [
        "$TMPDIR",
        "/tmp"
      ],
      "allowed_input_roots": [
        "docs",
        "contracts/canonical",
        "shared/hooks",
        "tools/community"
      ],
      "failure_state": "DEVELOPER_COMPLETION_GATE_FAILED",
      "failure_message": "developer completion gate failed",
      "exit_code_meanings": {
        "0": "hook decision emitted or help displayed; decision may be allow or block",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail closed block decision emitted"
      },
      "shell_parameter_strategy": "argv only; hook payload via stdin only; no shell interpolation",
      "verification_command": "bash tests/test-developer-contract-alignment.sh"
    }
  ]
}
