{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/developer/contracts/developer-report.schema.json",
  "description": "Developer task report contract. Captures per-task implementation evidence without deciding phase runtime state.",
  "$defs": {
    "evidenceCheck": {
      "type": "object",
      "required": ["status", "evidence_ref"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL"]
        },
        "command": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "applicabilityCheck": {
      "type": "object",
      "required": ["status", "evidence_ref"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL", "NOT_APPLICABLE"]
        },
        "command": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "NOT_APPLICABLE"
          }
        }
      },
      "then": {
        "required": ["reason"]
      },
      "additionalProperties": true
    },
    "failureContract": {
      "type": "object",
      "required": [
        "status",
        "failure_code",
        "reason",
        "owner",
        "safe_to_continue",
        "next_action",
        "evidence_refs",
        "user_message"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["BLOCKED", "FAIL", "PARTIAL"]
        },
        "failure_code": {
          "type": "string",
          "enum": [
            "MISSING_INPUT",
            "AMBIGUOUS_SCOPE",
            "UNRESOLVED_REF",
            "OWNER_MISMATCH",
            "SCHEMA_FAILURE",
            "GATE_FAILURE",
            "OUT_OF_SCOPE_CHANGE",
            "STALE_STATE_REPLAY",
            "FRESH_PROOF_GAP"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "enum": [
            "delivery-owner",
            "developer",
            "design",
            "tech-lead",
            "product-manager",
            "test-design",
            "verify",
            "standard-chain-runtime-owner"
          ]
        },
        "safe_to_continue": {
          "type": "boolean",
          "const": false
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "user_message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "freshProof": {
      "type": "object",
      "required": ["current_evidence_refs", "proving_commands"],
      "properties": {
        "current_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proving_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "current_output_ref", "result"],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "current_output_ref": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "enum": ["PASS", "FAIL", "BLOCKED", "PARTIAL"]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "developer-report"
        },
        "task_id": {
          "type": "string"
        },
        "runtime_status": {
          "type": "string",
          "enum": ["IN_PROGRESS", "VERIFIED", "BLOCKED", "PARTIAL"]
        },
        "summary_text": {
          "type": "string"
        },
        "task_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_reason": {
          "type": "string",
          "minLength": 1
        },
        "missing_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewable_anchor": {
          "type": "string",
          "minLength": 1
        },
        "file_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tdd_evidence_index": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "phase",
              "commit_sha",
              "test_ref",
              "result",
              "ac_refs"
            ],
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "RED",
                  "GREEN"
                ]
              },
              "commit_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,40}$"
              },
              "test_ref": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "enum": [
                  "FAIL_EXPECTED",
                  "PASS"
                ]
              },
              "ac_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "self_testing": {
          "type": "object",
          "required": [
            "coverage_review",
            "full_regression",
            "static_analysis",
            "smoke",
            "e2e"
          ],
          "properties": {
            "coverage_review": {
              "$ref": "#/$defs/evidenceCheck"
            },
            "full_regression": {
              "$ref": "#/$defs/evidenceCheck"
            },
            "static_analysis": {
              "type": "object",
              "required": ["lint", "type_check", "build"],
              "properties": {
                "lint": {
                  "$ref": "#/$defs/evidenceCheck"
                },
                "type_check": {
                  "$ref": "#/$defs/evidenceCheck"
                },
                "build": {
                  "$ref": "#/$defs/evidenceCheck"
                }
              },
              "additionalProperties": true
            },
            "smoke": {
              "$ref": "#/$defs/applicabilityCheck"
            },
            "e2e": {
              "$ref": "#/$defs/applicabilityCheck"
            }
          },
          "additionalProperties": true
        },
        "failure_contract": {
          "$ref": "#/$defs/failureContract"
        },
        "fresh_proof": {
          "$ref": "#/$defs/freshProof"
        }
      },
      "required": [
        "artifact_type",
        "task_id",
        "runtime_status",
        "summary_text",
        "task_scope",
        "active_plan_version_ref",
        "active_tasks_version_ref",
        "evidence_refs",
        "reviewable_anchor",
        "file_changes",
        "tdd_evidence_index",
        "self_testing"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime_status": {
                "const": "BLOCKED"
              }
            }
          },
          "then": {
            "required": ["blocked_reason", "missing_inputs", "failure_contract"]
          }
        },
        {
          "if": {
            "properties": {
              "runtime_status": {
                "const": "PARTIAL"
              }
            }
          },
          "then": {
            "required": ["failure_contract"]
          }
        },
        {
          "if": {
            "properties": {
              "runtime_status": {
                "const": "VERIFIED"
              }
            }
          },
          "then": {
            "required": ["fresh_proof"],
            "properties": {
              "task_scope": {
                "minItems": 1
              },
              "file_changes": {
                "minItems": 1
              },
              "tdd_evidence_index": {
                "minItems": 2
              },
              "self_testing": {
                "properties": {
                  "full_regression": {
                    "properties": {
                      "status": {
                        "const": "PASS"
                      }
                    }
                  },
                  "static_analysis": {
                    "properties": {
                      "lint": {
                        "properties": {
                          "status": {
                            "const": "PASS"
                          }
                        }
                      },
                      "type_check": {
                        "properties": {
                          "status": {
                            "const": "PASS"
                          }
                        }
                      },
                      "build": {
                        "properties": {
                          "status": {
                            "const": "PASS"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  ]
}
