{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/test-design/contracts/test-cases.schema.json",
  "description": "Test-case contract. Holds pre-development test analysis, executable test obligations, typed gaps, and QA handoff data for a single execution unit.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "$defs": {
        "sourceRef": {
          "type": "string",
          "pattern": "^(brief\\.json|phase-prd\\.json|UNIT-[0-9]+\\.json|design\\.json)#[A-Za-z_][A-Za-z0-9_]*(\\[[0-9]+\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[[0-9]+\\])?)*$"
        },
        "sourceRefArray": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/allOf/1/$defs/sourceRef"
          }
        },
        "stringArray": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caseRefArray": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "obligationRefArray": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gapType": {
          "type": "string",
          "enum": [
            "PRODUCT_GAP",
            "DESIGN_GAP",
            "SCOPE_DRIFT",
            "TRACE_CONFLICT",
            "TESTABILITY_GAP",
            "EQ_GAP"
          ]
        },
        "qaStage": {
          "type": "string",
          "enum": [
            "QA_A",
            "QA_B",
            "QA_C",
            "QA_D",
            "NFR"
          ]
        }
      },
      "properties": {
        "artifact_type": {
          "const": "test-cases"
        },
        "test_analysis": {
          "type": "object",
          "required": [
            "objectives",
            "in_scope",
            "out_of_scope",
            "risk_model",
            "strategy_by_quality_area",
            "test_flow",
            "environment_assumptions",
            "data_assumptions"
          ],
          "properties": {
            "objectives": {
              "$ref": "#/allOf/1/$defs/stringArray"
            },
            "in_scope": {
              "$ref": "#/allOf/1/$defs/stringArray"
            },
            "out_of_scope": {
              "$ref": "#/allOf/1/$defs/stringArray"
            },
            "risk_model": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "risk_ref",
                  "risk_type",
                  "test_depth"
                ],
                "properties": {
                  "risk_ref": {
                    "$ref": "#/allOf/1/$defs/sourceRef"
                  },
                  "risk_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "test_depth": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "strategy_by_quality_area": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "quality_area",
                  "strategy"
                ],
                "properties": {
                  "quality_area": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strategy": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "test_flow": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "checkpoint_id",
                  "source_refs",
                  "expected_checkpoint"
                ],
                "properties": {
                  "checkpoint_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_refs": {
                    "$ref": "#/allOf/1/$defs/sourceRefArray"
                  },
                  "expected_checkpoint": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "environment_assumptions": {
              "$ref": "#/allOf/1/$defs/stringArray"
            },
            "data_assumptions": {
              "$ref": "#/allOf/1/$defs/stringArray"
            }
          },
          "additionalProperties": false
        },
        "traceability_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "product_ref",
              "unit_ref",
              "ac_ref",
              "design_ref",
              "test_case_refs",
              "gap_refs"
            ],
            "properties": {
              "product_ref": {
                "$ref": "#/allOf/1/$defs/sourceRef"
              },
              "unit_ref": {
                "$ref": "#/allOf/1/$defs/sourceRef"
              },
              "ac_ref": {
                "$ref": "#/allOf/1/$defs/sourceRef"
              },
              "exclusion_ref": {
                "$ref": "#/allOf/1/$defs/sourceRef"
              },
              "risk_ref": {
                "$ref": "#/allOf/1/$defs/sourceRef"
              },
              "design_ref": {
                "$ref": "#/allOf/1/$defs/sourceRef"
              },
              "test_case_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray"
              },
              "gap_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray"
              }
            },
            "additionalProperties": false
          }
        },
        "ac_coverage_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ac_id",
              "covers",
              "positive_case_refs",
              "negative_case_refs",
              "boundary_case_refs"
            ],
            "properties": {
              "ac_id": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "$ref": "#/allOf/1/$defs/stringArray"
              },
              "positive_case_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray",
                "minItems": 1
              },
              "negative_case_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray",
                "minItems": 1
              },
              "boundary_case_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "equivalence_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "test_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "case_id",
              "title",
              "product_refs",
              "design_refs",
              "case_type",
              "priority",
              "preconditions",
              "test_data",
              "steps",
              "expected_result",
              "assertion_target",
              "execution_mode",
              "automation_level",
              "evidence_expectation",
              "owner_stage"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "product_refs": {
                "$ref": "#/allOf/1/$defs/sourceRefArray"
              },
              "design_refs": {
                "$ref": "#/allOf/1/$defs/sourceRefArray"
              },
              "case_type": {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "boundary",
                  "exclusion",
                  "specialty"
                ]
              },
              "priority": {
                "type": "string",
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3"
                ]
              },
              "preconditions": {
                "$ref": "#/allOf/1/$defs/stringArray"
              },
              "test_data": {
                "$ref": "#/allOf/1/$defs/stringArray"
              },
              "steps": {
                "$ref": "#/allOf/1/$defs/stringArray"
              },
              "expected_result": {
                "type": "string",
                "minLength": 1
              },
              "assertion_target": {
                "type": "string",
                "minLength": 1
              },
              "execution_mode": {
                "type": "string",
                "enum": [
                  "browser_required",
                  "non_browser_ok"
                ]
              },
              "automation_level": {
                "type": "string",
                "enum": [
                  "manual",
                  "automatable",
                  "automated"
                ]
              },
              "evidence_expectation": {
                "type": "string",
                "minLength": 1
              },
              "owner_stage": {
                "type": "string",
                "enum": [
                  "developer",
                  "verify",
                  "qa",
                  "nfr"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "qa_handoff_contract": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "obligation_id",
              "obligation_type",
              "trigger_refs",
              "qa_stage",
              "requiredness",
              "execution_mode",
              "skip_policy",
              "evidence_contract_ref",
              "design_source_refs"
            ],
            "properties": {
              "obligation_id": {
                "type": "string",
                "minLength": 1
              },
              "obligation_type": {
                "type": "string",
                "enum": [
                  "STATIC_CONTRACT",
                  "RUNTIME_REPLAY",
                  "NEGATIVE_RECOVERY",
                  "RELEASE_READINESS",
                  "BROWSER_FLOW",
                  "NFR"
                ]
              },
              "trigger_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "qa_stage": {
                "type": "string",
                "enum": [
                  "QA_A",
                  "QA_B",
                  "QA_C",
                  "QA_D",
                  "NFR"
                ]
              },
              "requiredness": {
                "type": "string",
                "enum": [
                  "REQUIRED",
                  "CONDITIONAL"
                ]
              },
              "execution_mode": {
                "type": "string",
                "enum": [
                  "browser_required",
                  "non_browser_ok"
                ]
              },
              "skip_policy": {
                "type": "string",
                "enum": [
                  "RECORD_NOT_EXECUTED_REASON",
                  "NOT_SKIPPABLE"
                ]
              },
              "evidence_contract_ref": {
                "type": "string",
                "minLength": 1
              },
              "design_source_refs": {
                "$ref": "#/allOf/1/$defs/sourceRefArray"
              }
            },
            "additionalProperties": false
          }
        },
        "unit_coverage_view": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "unit_id",
              "ac_ids",
              "coverage_status"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "ac_ids": {
                "$ref": "#/allOf/1/$defs/stringArray"
              },
              "coverage_status": {
                "type": "string",
                "enum": [
                  "COVERED",
                  "UNCOVERED",
                  "DESIGN_GAP"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "design_gap_report": {
          "type": "object",
          "required": [
            "status",
            "gaps"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "NO_GAPS",
                "HAS_GAPS"
              ]
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "gap_id",
                  "gap_type",
                  "blocking_refs",
                  "owner",
                  "required_artifact_ref",
                  "decision_needed",
                  "blocking"
                ],
                "properties": {
                  "gap_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "gap_type": {
                    "$ref": "#/allOf/1/$defs/gapType"
                  },
                  "blocking_refs": {
                    "$ref": "#/allOf/1/$defs/sourceRefArray"
                  },
                  "owner": {
                    "type": "string",
                    "enum": [
                      "product-director",
                      "product-manager",
                      "design",
                      "test-design",
                      "qa",
                      "delivery-owner",
                      "user"
                    ]
                  },
                  "blocking": {
                    "type": "boolean"
                  },
                  "required_artifact_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision_needed": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "cross_unit_obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "journey_id",
              "journey_title",
              "participant_unit_refs",
              "local_unit_ref",
              "sequence_index",
              "predecessor_case_refs",
              "successor_case_refs",
              "handoff_obligation_refs",
              "composition_status",
              "gap_refs"
            ],
            "properties": {
              "journey_id": {
                "type": "string",
                "minLength": 1
              },
              "journey_title": {
                "type": "string",
                "minLength": 1
              },
              "participant_unit_refs": {
                "$ref": "#/allOf/1/$defs/sourceRefArray"
              },
              "local_unit_ref": {
                "$ref": "#/allOf/1/$defs/sourceRef"
              },
              "sequence_index": {
                "type": "integer",
                "minimum": 0
              },
              "predecessor_case_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray"
              },
              "successor_case_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray"
              },
              "handoff_obligation_refs": {
                "$ref": "#/allOf/1/$defs/obligationRefArray"
              },
              "composition_status": {
                "type": "string",
                "enum": [
                  "COMPOSABLE",
                  "BLOCKED_GAP"
                ]
              },
              "gap_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray"
              }
            },
            "additionalProperties": false
          }
        },
        "special_test_triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "trigger_id",
              "trigger_type",
              "source_ref",
              "trigger_rule",
              "threshold_ref",
              "qa_stage",
              "handling"
            ],
            "properties": {
              "trigger_id": {
                "type": "string",
                "minLength": 1
              },
              "trigger_type": {
                "type": "string",
                "enum": [
                  "quality_attribute",
                  "data_architecture",
                  "cross_cutting_concern"
                ]
              },
              "source_ref": {
                "$ref": "#/allOf/1/$defs/sourceRef"
              },
              "qa_stage": {
                "$ref": "#/allOf/1/$defs/qaStage"
              },
              "handling": {
                "type": "string",
                "enum": [
                  "TEST_CASE",
                  "QA_HANDOFF",
                  "TYPED_GAP"
                ]
              },
              "test_case_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray"
              },
              "qa_handoff_obligation_refs": {
                "$ref": "#/allOf/1/$defs/obligationRefArray"
              },
              "gap_refs": {
                "$ref": "#/allOf/1/$defs/caseRefArray"
              },
              "trigger_rule": {
                "type": "string",
                "enum": [
                  "QUALITY_ATTRIBUTE_REQUIRED",
                  "DATA_FLOW_REQUIRED",
                  "CROSS_CUTTING_REQUIRED"
                ]
              },
              "threshold_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "review_conclusion": {
          "type": "object",
          "required": [
            "verdict",
            "closure_status",
            "review_round",
            "reviewed_test_cases_digest",
            "reviewer_verdicts",
            "convergence_evidence"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "PASS",
                "WARN"
              ]
            },
            "review_round": {
              "type": "string",
              "pattern": "^R[0-9]+$"
            },
            "reviewed_test_cases_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "reviewer_verdicts": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "perspective",
                  "verdict",
                  "issue_count",
                  "review_round",
                  "reviewed_test_cases_digest",
                  "evidence_refs"
                ],
                "properties": {
                  "perspective": {
                    "type": "string",
                    "enum": [
                      "test_quality",
                      "product",
                      "architecture"
                    ]
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "WARN",
                      "FAIL"
                    ]
                  },
                  "issue_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "review_round": {
                    "type": "string",
                    "pattern": "^R[0-9]+$"
                  },
                  "reviewed_test_cases_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "convergence_evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "round",
                  "result",
                  "fail_count",
                  "control_action",
                  "evidence_refs"
                ],
                "properties": {
                  "round": {
                    "type": "string",
                    "pattern": "^R[0-9]+$"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "WARN",
                      "FAIL"
                    ]
                  },
                  "fail_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "control_action": {
                    "type": "string",
                    "enum": [
                      "CONTINUE",
                      "CONFIRMATION",
                      "ASK_USER",
                      "BLOCKED",
                      "COMPLETE"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "closure_status": {
              "type": "string",
              "enum": [
                "CLOSED"
              ]
            }
          },
          "additionalProperties": false
        },
        "issue_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "issue_id",
              "review_round",
              "status",
              "evidence_refs",
              "handling_action"
            ],
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 1
              },
              "review_round": {
                "type": "string",
                "pattern": "^R[0-9]+$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "CLOSED",
                  "DEFERRED"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "handling_action": {
                "type": "string",
                "enum": [
                  "FIXED",
                  "DEFERRED_TO_OWNER",
                  "ACCEPTED_RISK"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "artifact_type",
        "test_analysis",
        "traceability_matrix",
        "ac_coverage_matrix",
        "equivalence_matrix",
        "test_cases",
        "qa_handoff_contract",
        "unit_coverage_view",
        "design_gap_report",
        "cross_unit_obligations",
        "special_test_triggers",
        "review_conclusion",
        "issue_ledger"
      ],
      "additionalProperties": true
    }
  ]
}
