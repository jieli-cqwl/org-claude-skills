{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "preflight-check",
      "path": "scripts/preflight_check.sh",
      "owner": "test-design",
      "allowed_args": ["--phase-dir", "--unit", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3"],
      "timeout_seconds": 15,
      "output_limit_bytes": 32768,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": ["$TMPDIR", "/tmp"],
      "allowed_input_roots": ["docs"],
      "failure_state": "TEST_DESIGN_PREFLIGHT_FAILED",
      "failure_message": "test-design preflight failed",
      "verification_command": "bash tests/test-test-design-preflight.sh"
    },
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "test-design",
      "allowed_args": ["hook payload via stdin only", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": ["bash", "python3", "dirname", "jq", "mktemp", "rm", "sed"],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": ["$TMPDIR", "/tmp"],
      "allowed_input_roots": ["docs", "contracts/canonical", "shared/runtime", "tools/community"],
      "failure_state": "TEST_DESIGN_COMPLETION_GATE_FAILED",
      "failure_message": "test-design completion gate failed",
      "exit_code_meanings": {
        "0": "hook decision emitted or help displayed; decision may be allow or block",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail-closed block decision emitted"
      },
      "shell_parameter_strategy": "argv only; hook payload via stdin only; no shell interpolation",
      "verification_command": "bash tests/test-test-design-completion-gate.sh"
    }
  ]
}
