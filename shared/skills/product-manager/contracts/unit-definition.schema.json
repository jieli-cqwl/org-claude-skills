{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/product-manager/contracts/unit-definition.schema.json",
  "description": "Unit definition contract. Freezes the unit boundary that downstream design, test-design, and execution consume.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "unit-definition"
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "closure_definition": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ac_id",
              "description",
              "example_input",
              "expected_result",
              "boundary_case",
              "failure_mode"
            ],
            "properties": {
              "ac_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "example_input": {
                "type": "string",
                "minLength": 1
              },
              "expected_result": {
                "type": "string",
                "minLength": 1
              },
              "boundary_case": {
                "type": "string",
                "minLength": 1
              },
              "failure_mode": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "priority_basis": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "integration_context": {
          "type": "object",
          "required": [
            "business_modules",
            "protected_behaviors",
            "cross_unit_dependencies",
            "business_constraints"
          ],
          "properties": {
            "business_modules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "protected_behaviors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cross_unit_dependencies": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "business_constraints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "verification_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "verification_type",
              "business_operation",
              "expected_observation",
              "evidence_target"
            ],
            "properties": {
              "verification_type": {
                "type": "string",
                "minLength": 1
              },
              "business_operation": {
                "type": "string",
                "minLength": 1
              },
              "expected_observation": {
                "type": "string",
                "minLength": 1
              },
              "evidence_target": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "design_decision_candidates": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "decision_name",
              "options",
              "constraints",
              "impacted_units",
              "design_handoff"
            ],
            "properties": {
              "decision_name": {
                "type": "string",
                "minLength": 1,
                "description": "Name of the unresolved design decision; do not use decision."
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraints": {
                "type": "string",
                "minLength": 1,
                "description": "Single string summarizing Director baseline, PM rules, integration context, or risk constraints; do not use an array."
              },
              "impacted_units": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Affected UNIT ids; do not use affected_units."
              },
              "design_handoff": {
                "type": "string",
                "minLength": 1,
                "description": "Goal that /design must decide; do not use handoff_target."
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "artifact_type",
        "unit_id",
        "closure_definition",
        "integration_context",
        "acceptance_criteria",
        "verification_plan",
        "design_decision_candidates",
        "exclusions",
        "priority",
        "priority_basis",
        "dependencies"
      ],
      "additionalProperties": true
    }
  ]
}
