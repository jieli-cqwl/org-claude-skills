{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/product-manager/contracts/phase-prd.schema.json",
  "description": "Phase PRD contract. Captures the scoped goal and unit index for a canonical phase.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "phase-prd"
        },
        "phase_goal": {
          "type": "string",
          "minLength": 1
        },
        "entry_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unit_index": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unit_priority_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "unit_id",
              "priority",
              "priority_basis"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1,
                "description": "UNIT id that must also appear in phase-prd.unit_index."
              },
              "priority": {
                "type": "string",
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3"
                ],
                "description": "Recommended execution priority for the UNIT."
              },
              "priority_basis": {
                "type": "string",
                "minLength": 1,
                "description": "Business reason for this UNIT priority and ordering."
              }
            },
            "additionalProperties": true
          }
        },
        "director_confirmation": {
          "type": "object",
          "required": [
            "status",
            "confirmed_at",
            "locked_field_digest",
            "locked_fields"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed"
              ]
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "locked_field_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "locked_fields": {
              "type": "object",
              "required": [
                "phase_goal",
                "entry_conditions",
                "exit_conditions"
              ],
              "properties": {
                "phase_goal": {
                  "type": "string",
                  "minLength": 1
                },
                "entry_conditions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "exit_conditions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "review_conclusion": {
          "type": "object",
          "required": [
            "verdict",
            "summary",
            "agent_team_review"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "PASS",
                "WARN"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "agent_team_review": {
              "type": "object",
              "required": [
                "mode",
                "round",
                "reviewed_artifact_refs",
                "reviewed_bundle_digest",
                "reviewer_verdicts",
                "convergence_evidence"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "agent_teams"
                },
                "round": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewed_artifact_refs": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reviewed_bundle_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "reviewer_verdicts": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "required": [
                      "perspective",
                      "round",
                      "verdict",
                      "reviewer_output_ref",
                      "artifact_refs",
                      "reviewed_bundle_digest",
                      "finding_refs",
                      "evidence_refs",
                      "read_only"
                    ],
                    "properties": {
                      "perspective": {
                        "type": "string",
                        "enum": [
                          "product",
                          "architecture",
                          "test"
                        ]
                      },
                      "round": {
                        "type": "string",
                        "minLength": 1
                      },
                      "verdict": {
                        "type": "string",
                        "enum": [
                          "PASS",
                          "WARN"
                        ]
                      },
                      "reviewer_output_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "artifact_refs": {
                        "type": "array",
                        "minItems": 3,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "reviewed_bundle_digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "finding_refs": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "evidence_refs": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "read_only": {
                        "const": true
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "convergence_evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "round",
                      "status",
                      "evidence_refs"
                    ],
                    "properties": {
                      "round": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_refs": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "issue_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "issue_id",
              "status",
              "severity",
              "dimension",
              "finding",
              "evidence",
              "handoff_target"
            ],
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "CLOSED",
                  "WAIVED",
                  "ACCEPTED",
                  "ACCEPTED_RISK",
                  "DEFERRED",
                  "RESOLVED"
                ]
              },
              "severity": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "finding": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "handoff_target": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "business_flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "user_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "design_decision_candidates": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "decision_name",
              "options",
              "constraints",
              "impacted_units",
              "design_handoff"
            ],
            "properties": {
              "decision_name": {
                "type": "string",
                "minLength": 1,
                "description": "Name of the unresolved design decision; do not use decision."
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraints": {
                "type": "string",
                "minLength": 1,
                "description": "Single string summarizing Director baseline, PM rules, integration context, or risk constraints; do not use an array."
              },
              "impacted_units": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Affected UNIT ids; do not use affected_units."
              },
              "design_handoff": {
                "type": "string",
                "minLength": 1,
                "description": "Goal that /design must decide; do not use handoff_target."
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "artifact_type",
        "phase_goal",
        "entry_conditions",
        "exit_conditions",
        "unit_index",
        "director_confirmation"
      ],
      "additionalProperties": true
    },
    {
      "if": {
        "required": [
          "review_conclusion"
        ]
      },
      "then": {
        "required": [
          "business_flows",
          "user_paths",
          "rule_mappings",
          "unit_priority_order",
          "design_decision_candidates"
        ],
        "properties": {
          "unit_index": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_conclusion": {
            "properties": {
              "verdict": {
                "const": "PASS"
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "review_conclusion"
        ]
      },
      "then": {
        "properties": {
          "issue_ledger": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_conclusion": {
            "properties": {
              "verdict": {
                "const": "WARN"
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "review_conclusion"
        ]
      },
      "then": {
        "required": [
          "issue_ledger"
        ],
        "properties": {
          "issue_ledger": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
