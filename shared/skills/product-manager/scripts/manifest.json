{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "product-manager",
      "allowed_args": ["hook payload via stdin only", "--help"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": [
        "bash",
        "python3",
        "grep",
        "sed",
        "sort",
        "wc",
        "jq",
        "find",
        "mktemp",
        "rm",
        "git",
        "tr",
        "printf",
        "dirname",
        "pwd",
        "cat"
      ],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_input_roots": ["docs"],
      "failure_state": "PRODUCT_MANAGER_COMPLETION_GATE_FAILED",
      "exit_code_meanings": {
        "0": "hook decision emitted; decision may be allow",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail-closed block decision emitted"
      },
      "shell_parameter_strategy": "hook payload via stdin; no shell interpolation of user arguments",
      "verification_command": "bash tests/test-product-role-split-contract.sh"
    }
  ]
}
