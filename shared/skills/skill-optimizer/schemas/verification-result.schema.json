{
  "schema_version": "1.0.0",
  "artifact_type": "verification-result",
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "producer",
    "inputs",
    "status",
    "design_anchors",
    "evidence_refs",
    "rendered_views",
    "schema_validation",
    "semantic_validation",
    "consumer_validation",
    "rendered_view_validation",
    "eval_results",
    "fresh_commands",
    "coverage",
    "decision"
  ],
  "properties": {
    "artifact_type": {"type": "string", "const": "verification-result"},
    "schema_version": {"type": "string"},
    "artifact_id": {"type": "string"},
    "producer": {
      "type": "object",
      "required": ["name", "command"],
      "properties": {
        "name": {"type": "string"},
        "command": {"type": "string"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["path", "role", "hash"],
        "properties": {
          "path": {"type": "string"},
          "role": {"type": "string"},
          "hash": {"type": "string"}
        }
      }
    },
    "status": {"type": "string", "enum": ["verified", "blocked"]},
    "design_anchors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1},
    "rendered_views": {"type": "array", "minItems": 1},
    "schema_validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "artifact_id", "path", "result"],
        "properties": {
          "name": {"type": "string"},
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "result": {"type": "string", "const": "PASS"}
        }
      }
    },
    "semantic_validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "artifact_id", "path", "result"],
        "properties": {
          "name": {"type": "string"},
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "result": {"type": "string", "const": "PASS"}
        }
      }
    },
    "consumer_validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "artifact_id", "path", "result"],
        "properties": {
          "name": {"type": "string"},
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "result": {"type": "string", "const": "PASS"}
        }
      }
    },
    "rendered_view_validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "artifact_id", "path", "result"],
        "properties": {
          "name": {"type": "string"},
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "result": {"type": "string", "const": "PASS"}
        }
      }
    },
    "eval_results": {
      "type": "object",
      "required": ["artifact_id", "status", "summary"],
      "properties": {
        "artifact_id": {"type": "string"},
        "status": {"type": "string", "const": "evaluated"},
        "summary": {
          "type": "object",
          "required": ["total", "passed", "failed"],
          "properties": {
            "total": {"type": "number"},
            "passed": {"type": "number"},
            "failed": {"type": "number", "const": 0}
          }
        }
      }
    },
    "fresh_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "result"],
        "properties": {
          "command": {"type": "string"},
          "result": {"type": "string", "const": "PASS"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "path",
        "hash",
        "source_markers",
        "review_decisions",
        "implemented_files",
        "accepted_findings",
        "file_boundaries",
        "verification_contracts"
      ],
      "properties": {
        "path": {"type": "string"},
        "hash": {"type": "string"},
        "source_markers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "review_decisions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "implemented_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "accepted_findings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "file_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["finding_id", "path", "mode"],
            "properties": {
              "finding_id": {"type": "string"},
              "path": {"type": "string"},
              "mode": {"type": "string"}
            }
          }
        },
        "verification_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "dimension",
              "success_standard_ref",
              "expected_behavior",
              "command",
              "expected_output"
            ],
            "properties": {
              "finding_id": {"type": "string"},
              "dimension": {"type": "string", "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8"]},
              "success_standard_ref": {"type": "string"},
              "expected_behavior": {"type": "string"},
              "command": {"type": "string"},
              "expected_output": {"type": "string"}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FAIL"]},
        "reason": {"type": "string"}
      }
    }
  }
}
