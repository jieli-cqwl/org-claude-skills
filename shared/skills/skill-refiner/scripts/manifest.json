{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "skill-refiner",
      "allowed_args": [
        "hook payload via stdin only",
        "--help",
        "-h"
      ],
      "denied_args": [
        "--exec",
        "--shell",
        "--network",
        ";",
        "&&",
        "|"
      ],
      "external_commands": [
        "bash",
        "python3",
        "dirname",
        "jq",
        "grep",
        "sed",
        "sort",
        "mktemp",
        "rm",
        "git",
        "cat"
      ],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": ".",
      "allowed_output_roots": [
        "$TMPDIR",
        "/tmp"
      ],
      "allowed_input_roots": [
        "shared/skills/skill-refiner",
        "shared/hooks"
      ],
      "failure_state": "SKILL_REFINER_COMPLETION_GATE_FAILED",
      "failure_message": "skill-refiner completion gate failed",
      "exit_code_meanings": {
        "0": "hook decision emitted or help displayed; decision may be allow",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail closed block decision emitted"
      },
      "shell_parameter_strategy": "hook payload via stdin only; no shell interpolation of user arguments",
      "verification_command": "bash tests/test-skill-refiner-completion-gate.sh && bash tests/test-codex-skill-adapter.sh && bash tests/test-skill-output-and-gate-contract.sh"
    }
  ]
}
