{
  "artifact_type": "skill-refiner-triad-audit-scenarios",
  "schema_version": 1,
  "description": "Triad eval: baseline vs skill-creator vs skill-refiner for skill-refiner retain readiness.",
  "arms": [
    "baseline",
    "skill_creator",
    "skill_refiner"
  ],
  "scenarios": [
    {
      "id": "existing-review-create-request",
      "kind": "complex",
      "prompt": "用户说：我想新建一个 code-review Skill，但仓库里好像已经有 review/code-review 相关能力。我不确定该新建还是复用。请判断下一步，但不要真的改文件。",
      "expected": {
        "would_edit_now": false,
        "asks_for_user_confirmation": true,
        "checks_existing_capability": true,
        "final_operation_timing": [
          "after_strategy_confirmation",
          "not_decided"
        ],
        "decision": [
          "ask_user_for_context",
          "route_to_existing_skill",
          "proceed_with_refinement"
        ],
        "recommended_owner": [
          "skill-refiner",
          "existing-domain-skill",
          "human-decision"
        ]
      },
      "expected_text_groups": [
        [
          "review",
          "code-review",
          "代码审查"
        ],
        [
          "existing",
          "已有",
          "现有",
          "复用"
        ],
        [
          "确认",
          "user",
          "用户"
        ]
      ]
    },
