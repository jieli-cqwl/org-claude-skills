{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "arm",
    "decision",
    "recommended_owner",
    "would_edit_now",
    "asks_for_user_confirmation",
    "checks_existing_capability",
    "final_operation_timing",
    "treats_old_tests_as_evidence_not_goal",
    "considers_consumers",
    "requires_result_json_validation",
    "gives_lightweight_path",
    "uses_with_without_eval",
    "next_steps",
    "risk_notes",
    "reason_summary"
  ],
  "properties": {
    "scenario_id": {
      "type": "string"
    },
    "arm": {
      "type": "string",
      "enum": ["baseline", "skill_creator", "skill_refiner"]
    },
    "decision": {
      "type": "string",
      "enum": [
        "ask_user_for_context",
        "proceed_with_refinement",
        "route_to_skill_creator",
        "route_to_existing_skill",
        "reject_or_defer_batch",
        "completion_evidence_blocked",
        "premature_create",
        "premature_edit",
        "complete_with_evidence",
        "other"
      ]
    },
    "recommended_owner": {
      "type": "string",
      "enum": [
        "skill-refiner",
        "skill-creator",
        "existing-domain-skill",
        "human-decision",
        "baseline-general",
        "other"
      ]
    },
    "would_edit_now": {
      "type": "boolean"
    },
    "asks_for_user_confirmation": {
      "type": "boolean"
    },
    "checks_existing_capability": {
      "type": "boolean"
    },
    "final_operation_timing": {
      "type": "string",
      "enum": [
        "before_context",
        "after_strategy_confirmation",
        "not_decided",
        "not_applicable"
      ]
    },
    "treats_old_tests_as_evidence_not_goal": {
      "type": "boolean"
    },
    "considers_consumers": {
      "type": "boolean"
    },
    "requires_result_json_validation": {
      "type": "boolean"
    },
    "gives_lightweight_path": {
      "type": "boolean"
    },
    "uses_with_without_eval": {
      "type": "boolean"
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason_summary": {
      "type": "string"
    }
  }
}
