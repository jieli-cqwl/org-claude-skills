{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refiner-result.schema.json",
  "title": "Skill Refiner Result",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "target",
    "quality_standard",
    "scene_facts",
    "professional_domain",
    "practice_flow",
    "optimization_goal",
    "diagnosis",
    "problem_cards",
    "strategy",
    "execution",
    "verification_commands",
    "completion_assessment"
  ],
  "properties": {
    "artifact_type": {
      "const": "skill-refiner-result"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "eval_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "run_mode": {
      "type": "string",
      "enum": [
        "with_skill",
        "without_skill"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "skill_name",
        "path",
        "operation"
      ],
      "properties": {
        "skill_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "additionalProperties": false
    },
    "quality_standard": {
      "type": "object",
      "required": [
        "ref",
        "read",
        "dimensions"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "read": {
          "const": true
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "scene_facts": {
      "type": "object",
      "required": [
        "real_scenario",
        "business_constraint",
        "expected_outcome",
        "observed_pain",
        "protected_capability",
        "entry_point",
        "open_questions"
      ],
      "properties": {
        "real_scenario": {
          "$ref": "#/$defs/non_empty_string"
        },
        "business_constraint": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expected_outcome": {
          "$ref": "#/$defs/non_empty_string"
        },
        "observed_pain": {
          "$ref": "#/$defs/non_empty_string"
        },
        "protected_capability": {
          "$ref": "#/$defs/non_empty_string"
        },
        "entry_point": {
          "$ref": "#/$defs/non_empty_string"
        },
        "open_questions": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "professional_domain": {
      "type": "object",
      "required": [
        "name",
        "responsibilities",
        "non_goals",
        "success_boundary"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "responsibilities": {
          "$ref": "#/$defs/string_array"
        },
        "non_goals": {
          "$ref": "#/$defs/string_array"
        },
        "success_boundary": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "practice_flow": {
      "$ref": "#/$defs/string_array"
    },
    "optimization_goal": {
      "type": "object",
      "required": [
        "objective",
        "success_standards",
        "exclusions"
      ],
      "properties": {
        "objective": {
          "$ref": "#/$defs/non_empty_string"
        },
        "success_standards": {
          "$ref": "#/$defs/string_array"
        },
        "exclusions": {
          "$ref": "#/$defs/string_array"
        }
      },
      "additionalProperties": false
    },
    "diagnosis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnosis_entry"
      },
      "minItems": 1
    },
    "problem_cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/problem_card"
      },
      "minItems": 1
    },
    "strategy": {
      "type": "object",
      "required": [
        "final_operation",
        "scope",
        "exclusions",
        "risk",
        "no_file_changes_before_confirmation",
        "confirmed_by",
        "evidence"
      ],
      "properties": {
        "final_operation": {
          "$ref": "#/$defs/operation"
        },
        "scope": {
          "$ref": "#/$defs/string_array"
        },
        "exclusions": {
          "$ref": "#/$defs/string_array"
        },
        "risk": {
          "$ref": "#/$defs/non_empty_string"
        },
        "no_file_changes_before_confirmation": {
          "const": true
        },
        "confirmed_by": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "started_after_strategy_confirmed",
        "modified_files",
        "created_files",
        "deleted_files"
      ],
      "properties": {
        "started_after_strategy_confirmed": {
          "const": true
        },
        "modified_files": {
          "$ref": "#/$defs/string_list"
        },
        "created_files": {
          "$ref": "#/$defs/string_list"
        },
        "deleted_files": {
          "$ref": "#/$defs/string_list"
        }
      },
      "additionalProperties": false
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification_command"
      },
      "minItems": 1
    },
    "completion_assessment": {
      "type": "object",
      "required": [
        "overall_status",
        "checks",
        "residual_risks"
      ],
      "properties": {
        "overall_status": {
          "const": "pass"
        },
        "checks": {
          "$ref": "#/$defs/string_array"
        },
        "residual_risks": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "self_dogfood": {
      "type": "object",
      "required": [
        "requirement",
        "input_ref",
        "output_ref",
        "trace_ref"
      ],
      "properties": {
        "requirement": {
          "$ref": "#/$defs/non_empty_string"
        },
        "input_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "output_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "trace_ref": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "minItems": 1
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operation": {
      "type": "string",
      "enum": [
        "optimize",
        "create",
        "rewrite",
        "replace",
        "split",
        "move",
        "delete"
      ]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "Trigger",
        "Responsibility",
        "Input",
        "Flow",
        "Output",
        "Resource",
        "Determinism",
        "Eval",
        "Runtime"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "foundation",
        "boundary",
        "craft",
        "assurance"
      ]
    },
    "diagnosis_status": {
      "type": "string",
      "enum": [
        "PASS",
        "ISSUE",
        "BLOCKED"
      ]
    },
    "diagnosis_entry": {
      "type": "object",
      "required": [
        "dimension",
        "priority",
        "status"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "status": {
          "$ref": "#/$defs/diagnosis_status"
        },
        "evidence": {
          "$ref": "#/$defs/non_empty_string"
        },
        "target_shape": {
          "$ref": "#/$defs/non_empty_string"
        },
        "candidate_strategy": {
          "$ref": "#/$defs/non_empty_string"
        },
        "verification": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ISSUE",
              "BLOCKED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "dimension",
          "priority",
          "status",
          "evidence",
          "target_shape",
          "candidate_strategy",
          "verification"
        ]
      },
      "additionalProperties": false
    },
    "problem_card": {
      "type": "object",
      "required": [
        "dimension",
        "phenomenon",
        "why_problem",
        "target_shape",
        "change_scope",
        "verification",
        "stop_condition"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "phenomenon": {
          "$ref": "#/$defs/non_empty_string"
        },
        "why_problem": {
          "$ref": "#/$defs/non_empty_string"
        },
        "target_shape": {
          "$ref": "#/$defs/non_empty_string"
        },
        "change_scope": {
          "$ref": "#/$defs/string_array"
        },
        "verification": {
          "$ref": "#/$defs/non_empty_string"
        },
        "stop_condition": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "verification_command": {
      "type": "object",
      "required": [
        "command",
        "status",
        "evidence"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "const": "pass"
        },
        "evidence": {
          "$ref": "#/$defs/non_empty_string"
        },
        "layer": {
          "type": "string",
          "enum": [
            "structural",
            "empirical"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
