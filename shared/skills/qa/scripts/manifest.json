{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "qa",
      "allowed_args": [
        "hook payload via stdin only",
        "--help",
        "-h"
      ],
      "denied_args": [
        "--exec",
        "--shell",
        "--network",
        ";",
        "&&",
        "|"
      ],
      "external_commands": [
        "bash",
        "python3",
        "dirname",
        "jq",
        "mktemp",
        "rm",
        "sed",
        "find",
        "sort"
      ],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": ".",
      "allowed_output_roots": [
        "$TMPDIR",
        "/tmp"
      ],
      "allowed_input_roots": [
        "docs",
        "contracts/canonical",
        "shared/runtime",
        "tools/community"
      ],
      "failure_state": "QA_COMPLETION_GATE_FAILED",
      "failure_message": "qa completion gate failed",
      "exit_code_meanings": {
        "0": "hook decision emitted or help displayed; decision may be allow or block",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail closed block decision emitted"
      },
      "shell_parameter_strategy": "argv only; hook payload via stdin only; no shell interpolation",
      "verification_command": "bash tests/test-qa-browser-gate-contract.sh && bash tests/test-standard-chain-readiness-gate.sh && bash tests/test-standard-chain-foundation-registry.sh"
    }
  ]
}
