{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/qa/contracts/qa-result.schema.json",
  "description": "Phase QA verdict contract. Tracks QA gate results against a frozen planning baseline.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "qa-result"
        },
        "current_stage": {
          "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/properties/current_stage"
        },
        "gate_result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "CONDITIONAL",
            "NOT_RUN",
            "N_A"
          ]
        },
        "release_recommendation": {
          "type": "string",
          "enum": [
            "ALLOW",
            "CONDITIONAL_ALLOW",
            "BLOCK",
            "DEFER"
          ]
        },
        "residual_risk": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncovered_boundary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional_release_basis": {
          "type": "string"
        },
        "not_executed_reason": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ruled_out_issues": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "issue",
              "basis"
            ],
            "properties": {
              "issue": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "stage_results": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "qa_stage",
              "gate_result",
              "evidence_refs",
              "summary"
            ],
            "properties": {
              "qa_stage": {
                "type": "string",
                "enum": [
                  "QA_A",
                  "QA_B",
                  "QA_C",
                  "QA_D"
                ]
              },
              "gate_result": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "CONDITIONAL",
                  "NOT_RUN",
                  "N_A"
                ]
              },
              "evidence_refs": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "summary": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "obligation_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "obligation_id",
              "qa_stage",
              "gate_result",
              "source_refs",
              "evidence_refs",
              "summary"
            ],
            "properties": {
              "obligation_id": {
                "type": "string",
                "pattern": "^QHO-[A-Z0-9-]+$"
              },
              "qa_stage": {
                "type": "string",
                "enum": [
                  "QA_A",
                  "QA_B",
                  "QA_C",
                  "QA_D",
                  "NFR"
                ]
              },
              "gate_result": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "CONDITIONAL",
                  "NOT_RUN",
                  "N_A"
                ]
              },
              "source_refs": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "evidence_refs": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "not_executed_reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "issue_ledger": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "browser_tool": {
          "type": "string"
        },
        "entry_url": {
          "type": "string"
        },
        "browser_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "artifact_type",
        "current_stage",
        "gate_result",
        "release_recommendation",
        "residual_risk",
        "uncovered_boundary",
        "conditional_release_basis",
        "not_executed_reason",
        "ruled_out_issues",
        "stage_results",
        "obligation_results",
        "issue_ledger",
        "baseline_tasks_version_ref",
        "active_tasks_version_ref"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "gate_result": {
                "const": "FAIL"
              }
            },
            "required": [
              "gate_result"
            ]
          },
          "then": {
            "properties": {
              "issue_ledger": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "issue_id",
                    "severity",
                    "priority",
                    "impact_scope",
                    "user_impact",
                    "environment_or_build",
                    "regression_flag",
                    "temporary_workaround",
                    "owner_hint",
                    "expected_behavior",
                    "actual_behavior",
                    "reproduction"
                  ],
                  "properties": {
                    "issue_id": {
                      "type": "string",
                      "pattern": "^QAR-[0-9]{3}$"
                    },
                    "severity": {
                      "type": "string"
                    },
                    "priority": {
                      "type": "string"
                    },
                    "impact_scope": {
                      "type": "string"
                    },
                    "user_impact": {
                      "type": "string"
                    },
                    "environment_or_build": {
                      "type": "string"
                    },
                    "regression_flag": {
                      "type": "string"
                    },
                    "temporary_workaround": {
                      "type": "string"
                    },
                    "owner_hint": {
                      "type": "string"
                    },
                    "expected_behavior": {
                      "type": "string"
                    },
                    "actual_behavior": {
                      "type": "string"
                    },
                    "reproduction": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  ]
}
