{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "planning-preflight",
      "path": "scripts/planning_preflight.py",
      "owner": "tech-lead",
      "allowed_args": [
        "--phase-dir",
        "--require-tasks",
        "--help",
        "-h"
      ],
      "denied_args": [
        "--exec",
        "--shell",
        "--network",
        ";",
        "&&",
        "|"
      ],
      "external_commands": [
        "python3"
      ],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "stdout only",
      "allowed_output_roots": [],
      "allowed_input_roots": [
        "docs"
      ],
      "failure_state": "TECH_LEAD_PLANNING_PREFLIGHT_BLOCKED",
      "failure_message": "tech-lead planning preflight blocked",
      "exit_code_meanings": {
        "0": "required canonical inputs are present",
        "2": "required canonical inputs are missing; return user decision package"
      },
      "shell_parameter_strategy": "argv only; no shell interpolation",
      "verification_command": "python3 shared/skills/tech-lead/scripts/planning_preflight.py --phase-dir tests/fixtures/standard-chain-foundation/golden-pilot/sample-feature/phase-1"
    },
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "tech-lead",
      "allowed_args": [
        "hook payload via stdin only",
        "--help",
        "-h"
      ],
      "denied_args": [
        "--exec",
        "--shell",
        "--network",
        ";",
        "&&",
        "|"
      ],
      "external_commands": [
        "bash",
        "python3",
        "cat",
        "jq",
        "git",
        "grep",
        "sed",
        "sort",
        "wc",
        "tr",
        "dirname",
        "pwd",
        "find",
        "mktemp",
        "rm"
      ],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": [
        "$TMPDIR",
        "/tmp"
      ],
      "allowed_input_roots": [
        "docs",
        "contracts/canonical",
        "shared/hooks",
        "tools/community"
      ],
      "failure_state": "TECH_LEAD_COMPLETION_GATE_FAILED",
      "failure_message": "tech-lead completion gate failed",
      "exit_code_meanings": {
        "0": "hook decision emitted or help displayed; decision may be allow or block",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail closed block decision emitted"
      },
      "shell_parameter_strategy": "argv only; hook payload via stdin only; no shell interpolation",
      "verification_command": "bash tests/test-skill-output-and-gate-contract.sh"
    }
  ]
}
