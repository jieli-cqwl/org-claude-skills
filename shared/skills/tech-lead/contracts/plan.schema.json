{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/tech-lead/contracts/plan.schema.json",
  "description": "Plan contract. Freezes the phase execution baseline that delivery-state and downstream runtime artifacts switch against.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "plan"
        },
        "planning_mode": {
          "const": "standard-chain"
        },
        "plan_version": {
          "type": "string"
        },
        "scope_freeze": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal_source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
          }
        },
        "constraint_source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
          }
        },
        "obligation_source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
          }
        },
        "execution_basis_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
          }
        },
        "planning_readiness": {
          "type": "object",
          "required": [
            "status",
            "summary",
            "blocking_gaps",
            "decision_package"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "READY",
                "BLOCKED",
                "READY_WITH_USER_DECISION"
              ]
            },
            "summary": {
              "type": "string"
            },
            "blocking_gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "gap_id",
                  "owner",
                  "impact",
                  "required_decision"
                ],
                "properties": {
                  "gap_id": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "impact": {
                    "type": "string"
                  },
                  "required_decision": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "decision_package": {
              "type": "object",
              "required": [
                "required",
                "options",
                "recommended_option"
              ],
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "recommended_option": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "implementation_path": {
          "type": "object",
          "required": [
            "summary",
            "wbs",
            "critical_path",
            "dependency_strategy",
            "parallel_batches",
            "investment_risk_signals"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "wbs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "work_package_id",
                  "task_refs"
                ],
                "properties": {
                  "work_package_id": {
                    "type": "string"
                  },
                  "task_refs": {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
                  }
                },
                "additionalProperties": true
              }
            },
            "critical_path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dependency_strategy": {
              "type": "string"
            },
            "parallel_batches": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "batch",
                  "task_refs",
                  "parallelizable"
                ],
                "properties": {
                  "batch": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "task_refs": {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
                  },
                  "parallelizable": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": true
              }
            },
            "investment_risk_signals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "signal",
                  "impact",
                  "owner"
                ],
                "properties": {
                  "signal": {
                    "type": "string"
                  },
                  "impact": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "goal_fidelity_review": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "goal_ref",
              "task_refs",
              "execution_basis_ref",
              "status"
            ],
            "properties": {
              "goal_ref": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
              },
              "task_refs": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "execution_basis_ref": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
              },
              "status": {
                "type": "string",
                "enum": [
                  "COVERED",
                  "N_A",
                  "GAP"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "user_confirmation": {
          "type": "object",
          "required": [
            "status",
            "confirmed_by",
            "confirmed_at"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "PENDING"
              ]
            },
            "confirmed_by": {
              "type": "string"
            },
            "confirmed_at": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "artifact_type",
        "planning_mode",
        "plan_version",
        "scope_freeze",
        "task_list",
        "baseline_plan_version_ref",
        "baseline_tasks_version_ref",
        "goal_source_refs",
        "constraint_source_refs",
        "obligation_source_refs",
        "execution_basis_refs",
        "planning_readiness",
        "implementation_path",
        "goal_fidelity_review",
        "user_confirmation"
      ],
      "additionalProperties": true
    }
  ]
}
