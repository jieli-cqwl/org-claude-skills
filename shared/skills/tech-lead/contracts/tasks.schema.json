{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://org-claude-skills.local/shared/skills/tech-lead/contracts/tasks.schema.json",
  "description": "Task registry contract. Freezes immutable task definitions that runtime state can reference but not rewrite.",
  "allOf": [
    {
      "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "tasks"
        },
        "plan_version": {
          "type": "string"
        },
        "user_confirmation": {
          "type": "object",
          "required": [
            "status",
            "confirmed_by",
            "confirmed_at"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "PENDING"
              ]
            },
            "confirmed_by": {
              "type": "string"
            },
            "confirmed_at": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task_id",
              "phase_ref",
              "unit_refs",
              "scope_item_refs",
              "design_refs",
              "decision_refs",
              "test_refs",
              "depends_on",
              "shared_files",
              "batch",
              "acceptance_targets",
              "proving_command",
              "real_dependency_refs",
              "evidence_target",
              "mock_boundary"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "phase_ref": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRef"
              },
              "unit_refs": {
                "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
              },
              "scope_item_refs": {
                "description": "Canonical refs that explain why the task is in scope; not the writable implementation boundary.",
                "allOf": [
                  {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
                  }
                ],
                "minItems": 1
              },
              "design_refs": {
                "allOf": [
                  {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
                  }
                ],
                "minItems": 1
              },
              "decision_refs": {
                "allOf": [
                  {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
                  }
                ],
                "minItems": 1
              },
              "test_refs": {
                "allOf": [
                  {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
                  }
                ],
                "minItems": 1
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "shared_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "batch": {
                "type": "integer",
                "minimum": 1
              },
              "acceptance_targets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "proving_command": {
                "type": "string",
                "minLength": 1
              },
              "real_dependency_refs": {
                "description": "Canonical refs for real dependency evidence required by final acceptance.",
                "allOf": [
                  {
                    "$ref": "https://org-claude-skills.local/shared/skills/lib/contracts/shared-core.schema.json#/$defs/canonicalRefArray"
                  }
                ],
                "minItems": 1
              },
              "evidence_target": {
                "type": "string",
                "minLength": 1
              },
              "mock_boundary": {
                "description": "Structured mock boundary. Mock can support isolation only; final acceptance must use real evidence.",
                "type": "object",
                "properties": {
                  "mock_allowed": {
                    "type": "boolean"
                  },
                  "allowed_for": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "unit_isolation",
                        "fixture_data",
                        "recorded_replay",
                        "none"
                      ]
                    }
                  },
                  "final_acceptance_requires_real_evidence": {
                    "const": true
                  }
                },
                "required": [
                  "mock_allowed",
                  "allowed_for",
                  "final_acceptance_requires_real_evidence"
                ],
                "additionalProperties": false
              },
              "wbs_ref": {
                "type": "string"
              },
              "critical_path_role": {
                "type": "string",
                "enum": [
                  "critical",
                  "supporting",
                  "independent"
                ]
              },
              "investment_risk_signals": {
                "description": "Per-task investment and risk tags for delivery-owner resource decisions.",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "heavy",
                    "risky",
                    "slow",
                    "rework-prone"
                  ]
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "artifact_type",
        "plan_version",
        "tasks",
        "user_confirmation"
      ],
      "additionalProperties": true
    }
  ]
}
