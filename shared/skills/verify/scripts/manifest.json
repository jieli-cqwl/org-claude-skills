{
  "schema_version": "1.0.0",
  "scripts": [
    {
      "id": "preflight-check",
      "path": "scripts/preflight_check.sh",
      "owner": "verify",
      "allowed_args": [
        "--phase-dir",
        "--task-id",
        "--help",
        "-h"
      ],
      "denied_args": [
        "--exec",
        "--shell",
        "--network",
        ";",
        "&&",
        "|"
      ],
      "external_commands": [
        "bash",
        "python3"
      ],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": "$TMPDIR|/tmp",
      "allowed_output_roots": [
        "$TMPDIR",
        "/tmp"
      ],
      "allowed_input_roots": [
        "docs",
        "tests/fixtures",
        "shared/skills/verify",
        "tools/community"
      ],
      "failure_state": "VERIFY_PREFLIGHT_FAILED",
      "failure_message": "verify preflight failed",
      "exit_code_meanings": {
        "0": "preflight passed or help displayed",
        "1": "preflight blocked"
      },
      "shell_parameter_strategy": "argv only; no shell interpolation",
      "verification_command": "bash tests/test-verify-contract-alignment.sh"
    },
    {
      "id": "completion-check",
      "path": "scripts/completion_check.sh",
      "owner": "verify",
      "allowed_args": ["hook payload via stdin only", "--help", "-h"],
      "denied_args": ["--exec", "--shell", "--network", ";", "&&", "|"],
      "external_commands": [
        "bash",
        "cat",
        "dirname",
        "git",
        "grep",
        "jq",
        "sed",
        "sort",
        "tr",
        "wc"
      ],
      "timeout_seconds": 15,
      "output_limit_bytes": 65536,
      "output_root": ".",
      "allowed_output_roots": ["."],
      "allowed_input_roots": ["docs", "contracts/canonical", "shared/hooks"],
      "failure_state": "VERIFY_COMPLETION_GATE_FAILED",
      "failure_message": "verify completion gate failed",
      "exit_code_meanings": {
        "0": "hook decision emitted or help displayed; decision may be allow or block",
        "1": "script initialization or validation failed before hook decision",
        "2": "fail closed block decision emitted"
      },
      "shell_parameter_strategy": "argv only; hook payload via stdin only; no shell interpolation",
      "verification_command": "bash tests/test-skill-output-and-gate-contract.sh && bash tests/test-standard-chain-readiness-gate.sh"
    }
  ]
}
