{
  "schema_version": "1.0.0",
  "profile_type": "preflight",
  "source_contracts": [
    "contracts/standard-chain-failure-routing.yaml",
    "contracts/canonical/schemas/runtime/failure-routing-result.schema.json"
  ],
  "roles": {
    "product-director": {
      "role": "product-director",
      "stage": "product-director.preflight",
      "required_arguments": [
        "feature"
      ],
      "checks": [
        {
          "check_id": "workspace-write-ready",
          "summary": "Workspace is writable for Director canonical artifacts.",
          "failure_code": "UNAUTHORIZED_SCOPE",
          "required_inputs": [
            "workspace"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "contracts-and-templates-ready",
          "summary": "Canonical contract bundle and Director templates are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "registry-bundle",
            "brief-template",
            "phase-prd-template"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "product-manager": {
      "role": "product-manager",
      "stage": "product-manager.preflight",
      "required_arguments": [
        "feature",
        "phase-dir"
      ],
      "checks": [
        {
          "check_id": "director-handoff-ready",
          "summary": "Director handoff, locked digest, and canonical product artifacts are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "brief",
            "phase-prd",
            "director-confirmation"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "phase-boundary-readable",
          "summary": "Phase boundary fields are present and parseable.",
          "failure_code": "MALFORMED_ARTIFACT",
          "required_inputs": [
            "phase-prd"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "design": {
      "role": "design",
      "stage": "design.preflight",
      "required_arguments": [
        "feature",
        "phase-dir"
      ],
      "checks": [
        {
          "check_id": "pm-delivery-confirmed",
          "summary": "PM delivery confirmation and closed product review state are present.",
          "failure_code": "MISSING_HUMAN_CONFIRMATION",
          "required_inputs": [
            "phase-prd",
            "product-review"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "phase-unit-inputs-ready",
          "summary": "Phase and unit inputs needed for architecture work are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "phase-prd",
            "unit-definitions",
            "project-context"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "test-design": {
      "role": "test-design",
      "stage": "test-design.preflight",
      "required_arguments": [
        "feature",
        "phase-dir",
        "unit"
      ],
      "checks": [
        {
          "check_id": "product-and-design-inputs-ready",
          "summary": "Product artifacts, design JSON, unit definitions, and design refs are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "phase-prd",
            "unit-definition",
            "design"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "design-refs-parseable",
          "summary": "Design refs needed to derive test cases resolve cleanly.",
          "failure_code": "MALFORMED_ARTIFACT",
          "required_inputs": [
            "design"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "tech-lead": {
      "role": "tech-lead",
      "stage": "tech-lead.preflight",
      "required_arguments": [
        "feature",
        "phase-dir"
      ],
      "checks": [
        {
          "check_id": "planning-inputs-ready",
          "summary": "Product, design, and test-case inputs are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "phase-prd",
            "design",
            "test-cases"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "design-decisions-closed",
          "summary": "Unresolved design decisions have not been pushed into planning.",
          "failure_code": "HANDOFF_NOT_READY",
          "required_inputs": [
            "design"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "delivery-owner": {
      "role": "delivery-owner",
      "stage": "delivery-owner.preflight",
      "required_arguments": [
        "feature",
        "phase-dir"
      ],
      "checks": [
        {
          "check_id": "dispatch-baseline-ready",
          "summary": "Confirmed baseline artifacts and active artifact registry are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "artifact-registry",
            "plan",
            "tasks",
            "test-cases"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "execution-target-unambiguous",
          "summary": "Plan, task, and test-case refs resolve to a dispatchable target.",
          "failure_code": "AMBIGUOUS_TARGET",
          "required_inputs": [
            "artifact-registry"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "developer": {
      "role": "developer",
      "stage": "developer.preflight",
      "required_arguments": [
        "feature",
        "phase-dir",
        "unit",
        "task-id"
      ],
      "checks": [
        {
          "check_id": "task-scope-ready",
          "summary": "Task scope, declared file range, and design/task refs are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "plan",
            "tasks",
            "task-scope",
            "design-refs"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "write-scope-authorized",
          "summary": "Requested write scope is declared by the task.",
          "failure_code": "UNAUTHORIZED_SCOPE",
          "required_inputs": [
            "task-scope"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "verify": {
      "role": "verify",
      "stage": "verify.preflight",
      "required_arguments": [
        "feature",
        "phase-dir",
        "unit",
        "task-id"
      ],
      "checks": [
        {
          "check_id": "developer-report-ready",
          "summary": "Developer report, task refs, and evidence anchors are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "developer-report",
            "plan",
            "tasks"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "evidence-anchors-current",
          "summary": "Developer evidence anchors are fresh enough for verification.",
          "failure_code": "STALE_EVIDENCE",
          "required_inputs": [
            "developer-report"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "review": {
      "role": "review",
      "stage": "review.preflight",
      "required_arguments": [
        "feature",
        "phase-dir"
      ],
      "checks": [
        {
          "check_id": "review-baseline-ready",
          "summary": "Plan/tasks baseline and developer/verify evidence are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "plan",
            "tasks",
            "developer-report",
            "verify-result"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "review-scope-unambiguous",
          "summary": "Review scope resolves to the intended implementation surface.",
          "failure_code": "AMBIGUOUS_TARGET",
          "required_inputs": [
            "review-scope"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    },
    "qa": {
      "role": "qa",
      "stage": "qa.preflight",
      "required_arguments": [
        "feature",
        "phase-dir"
      ],
      "checks": [
        {
          "check_id": "qa-handoff-ready",
          "summary": "Brief, PRD, units, design, plan, tests, review result, registry, and QA handoff are available.",
          "failure_code": "MISSING_ARTIFACT",
          "required_inputs": [
            "brief",
            "phase-prd",
            "unit-definitions",
            "design",
            "plan",
            "test-cases",
            "code-review-result",
            "artifact-registry",
            "qa-handoff"
          ],
          "role_boundary": "role-owned-detection"
        },
        {
          "check_id": "real-execution-entry-ready",
          "summary": "QA target and real execution entry conditions are explicit.",
          "failure_code": "HANDOFF_NOT_READY",
          "required_inputs": [
            "qa-handoff",
            "execution-entry"
          ],
          "role_boundary": "role-owned-detection"
        }
      ]
    }
  }
}
