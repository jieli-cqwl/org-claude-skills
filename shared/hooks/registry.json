  "runtime_hooks": [
    {
      "id": "dangerous-bash",
      "intent": "block-destructive-bash",
      "claude": {
        "supported": true,
        "event": "PreToolUse",
        "matcher": "Bash",
        "launcher": "bash",
        "command_rel": "hooks/block_dangerous.sh"
      },
      "codex": {
        "supported": true,
        "event": "PreToolUse",
        "matcher": "Bash",
        "launcher": "bash",
        "command_rel": "hooks/managed/block_dangerous.sh",
        "timeout_sec": 15
      }
    },
    {
      "id": "claude-code-quality-check",
      "intent": "fail-fast-code-quality-check",
      "claude": {
        "supported": true,
        "event": "PreToolUse",
        "matcher": "Write|Edit",
        "launcher": "bash",
        "command_rel": "hooks/code_quality_check.sh"
      },
      "codex": {
        "supported": false,
        "reason": "Codex hooks do not currently intercept Write/Edit tool calls."
      }
    },
    {
      "id": "claude-auto-format",
      "intent": "post-edit-auto-format",
      "claude": {
        "supported": true,
        "event": "PostToolUse",
        "matcher": "Edit|Write",
        "launcher": "bash",
        "command_rel": "hooks/auto_format.sh"
      },
      "codex": {
        "supported": false,
        "reason": "Codex hooks do not currently intercept Write/Edit tool calls."
      }
    },
    {
      "id": "claude-post-compact",
      "intent": "restore-context-after-compaction",
      "claude": {
        "supported": true,
        "event": "PostCompact",
        "launcher": "bash",
        "command_rel": "hooks/post_compact.sh",
        "timeout_sec": 10
      },
      "codex": {
        "supported": false,
        "reason": "Codex does not expose the Claude-specific PostCompact lifecycle hook."
      }
    },
    {
      "id": "claude-task-verify",
      "intent": "verify-task-completion",
      "claude": {
        "supported": true,
        "event": "TaskCompleted",
        "launcher": "bash",
        "command_rel": "hooks/task_verify.sh",
        "timeout_sec": 120
      },
      "codex": {
        "supported": false,
        "reason": "Codex does not expose the Claude-specific TaskCompleted lifecycle hook."
      }
    },
    {
      "id": "codex-track-active-skill",
      "intent": "track-active-skill",
      "claude": {
        "supported": false,
        "reason": "Claude keeps skill-scoped completion gates in skill frontmatter."
      },
      "codex": {
        "supported": true,
        "internal_only": true,
        "event": "UserPromptSubmit",
        "launcher": "python3",
        "command_rel": "hooks/managed/codex_user_prompt_submit.py",
        "timeout_sec": 10
      }
    },
    {
      "id": "context-contract-validator",
      "intent": "validate-active-context-handoff-contract",
      "claude": {
        "supported": true,
        "event": "PostToolUse",
        "matcher": "Write|Edit",
        "launcher": "python3",
        "command_rel": "hooks/managed/context_contract_validator.py",
        "timeout_sec": 30
      },
      "codex": {
        "supported": true,
        "event": "Stop",
        "launcher": "python3",
        "command_rel": "hooks/managed/context_contract_validator.py",
        "timeout_sec": 30
      }
    },
    {
      "id": "codex-stop-dispatch",
      "intent": "dispatch-skill-completion-gate",
      "claude": {
        "supported": false,
        "reason": "Claude executes completion gates directly from skill-local hooks."
      },
      "codex": {
        "supported": true,
        "event": "Stop",
        "launcher": "python3",
        "command_rel": "hooks/managed/codex_stop_dispatch.py",
        "timeout_sec": 60
      }
    }
  ]
}
