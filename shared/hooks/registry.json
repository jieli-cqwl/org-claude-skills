  "runtime_hooks": [
    {
      "id": "dangerous-bash",
      "intent": "block-destructive-bash",
      "claude": {
        "supported": true,
        "event": "PreToolUse",
        "matcher": "Bash",
        "launcher": "bash",
        "command_rel": "hooks/block_dangerous.sh"
      },
      "codex": {
        "supported": true,
        "event": "PreToolUse",
        "matcher": "Bash",
        "launcher": "bash",
        "command_rel": "hooks/managed/block_dangerous.sh",
        "timeout_sec": 15
      }
    },
    {
      "id": "claude-code-quality-check",
      "intent": "fail-fast-code-quality-check",
      "claude": {
        "supported": true,
        "event": "PreToolUse",
        "matcher": "Write|Edit",
        "launcher": "bash",
        "command_rel": "hooks/code_quality_check.sh"
      },
      "codex": {
        "supported": false,
        "reason": "Codex now exposes Write/Edit via PreToolUse/PostToolUse, but this Claude-local script has not been adapted for the Codex runtime payload and file layout."
      }
    },
    {
      "id": "claude-auto-format",
      "intent": "post-edit-auto-format",
      "claude": {
        "supported": true,
        "event": "PostToolUse",
        "matcher": "Edit|Write",
        "launcher": "bash",
        "command_rel": "hooks/auto_format.sh"
      },
      "codex": {
        "supported": false,
        "reason": "Codex now exposes Write/Edit via PreToolUse/PostToolUse, but this Claude-local script has not been adapted for the Codex runtime payload and file layout."
      }
    },
    {
      "id": "claude-post-compact",
      "intent": "restore-context-after-compaction",
      "claude": {
        "supported": true,
        "event": "PostCompact",
        "launcher": "bash",
        "command_rel": "hooks/post_compact.sh",
        "timeout_sec": 10
      },
      "codex": {
        "supported": false,
        "reason": "Codex context continuity is installed through the explicit context-continuity feature hooks."
      }
    },
    {
      "id": "claude-task-verify",
      "intent": "verify-task-completion",
      "claude": {
        "supported": true,
        "event": "TaskCompleted",
        "launcher": "bash",
        "command_rel": "hooks/task_verify.sh",
        "timeout_sec": 120
      },
      "codex": {
        "supported": false,
        "reason": "Codex does not expose the Claude-specific TaskCompleted lifecycle hook."
      }
    },
    {
      "id": "codex-track-active-skill",
      "intent": "track-active-skill",
      "claude": {
        "supported": false,
        "reason": "Claude keeps skill-scoped completion gates in skill frontmatter."
      },
      "codex": {
        "supported": true,
        "internal_only": true,
        "event": "UserPromptSubmit",
        "launcher": "python3",
        "command_rel": "hooks/managed/codex_user_prompt_submit.py",
        "timeout_sec": 10
      }
    },
    {
      "id": "codex-context-continuity-user-prompt",
      "intent": "record-latest-user-prompt-for-context-continuity",
      "claude": {
        "supported": false,
        "reason": "Claude uses its native compact hooks and transcript handling."
      },
      "codex": {
        "supported": true,
        "feature": "context-continuity",
        "event": "UserPromptSubmit",
        "launcher": "python3",
        "command_rel": "hooks/managed/codex_context_continuity.py",
        "args": ["--event", "UserPromptSubmit"],
        "timeout_sec": 10
      }
    },
    {
      "id": "codex-context-continuity-stop",
      "intent": "checkpoint-stop-metadata-for-context-continuity",
      "claude": {
        "supported": false,
        "reason": "Claude uses its native compact hooks and transcript handling."
      },
      "codex": {
        "supported": true,
        "feature": "context-continuity",
        "event": "Stop",
        "launcher": "python3",
        "command_rel": "hooks/managed/codex_context_continuity.py",
        "args": ["--event", "Stop"],
        "timeout_sec": 10
      }
    },
    {
      "id": "codex-context-continuity-precompact",
      "intent": "seal-task-state-before-context-compaction",
      "claude": {
        "supported": false,
        "reason": "Claude uses hooks/post_compact.sh for its native runtime."
      },
      "codex": {
        "supported": true,
        "feature": "context-continuity",
        "event": "PreCompact",
        "launcher": "python3",
        "command_rel": "hooks/managed/codex_context_continuity.py",
        "args": ["--event", "PreCompact"],
        "timeout_sec": 10
      }
    },
    {
      "id": "codex-context-continuity-postcompact",
      "intent": "record-context-compaction-metadata",
      "claude": {
        "supported": false,
        "reason": "Claude uses hooks/post_compact.sh for its native runtime."
      },
      "codex": {
        "supported": true,
        "feature": "context-continuity",
        "event": "PostCompact",
        "launcher": "python3",
        "command_rel": "hooks/managed/codex_context_continuity.py",
        "args": ["--event", "PostCompact"],
        "timeout_sec": 10
      }
    },
    {
      "id": "codex-context-continuity-session-compact",
      "intent": "inject-context-continuity-after-context-compaction",
      "claude": {
        "supported": false,
        "reason": "Claude uses hooks/post_compact.sh for its native runtime."
      },
      "codex": {
        "supported": true,
        "feature": "context-continuity",
        "event": "SessionStart",
        "matcher": "compact",
        "launcher": "python3",
        "command_rel": "hooks/managed/codex_context_continuity.py",
        "args": ["--event", "SessionStart", "--source", "compact"],
        "timeout_sec": 10
      }
    },
    {
      "id": "context-contract-validator",
      "intent": "validate-active-context-handoff-contract",
      "claude": {
        "supported": true,
        "event": "PostToolUse",
        "matcher": "Write|Edit",
        "launcher": "python3",
        "command_rel": "hooks/managed/context_contract_validator.py",
